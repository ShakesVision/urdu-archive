دیکھئیے: ٹرخانا
ٹالنا،ادائیگی: { ٹَر + کِش }
 ترکی کا۔ادائیگی: { ٹَر + کِش + باتھ }
 حمام جس میں گرم بھاپ کا غسل اور جسم کی مالش وغیرہ کا انتظام ہو۔ادائیگی: { ٹَر + کِش + تو (و لین) + لِیَہ }
 لمبے روئیں کا کھردرا تولیہ۔ادائیگی: { ٹر + کش + کوٹ (و مجہول) }
 عام کوٹ سے کسی قدر مختلف لمبا بند گلے کا کوٹ۔ادائیگی: { ٹَر + کُل }
 بہت معمولی، گھٹیا، خراب۔ادائیگی: { ٹَرَک + نا }
 چلا جانا، ہٹ جانا، کھسک جانا، ٹل جانا۔ادائیگی: { ٹَر + کی }
 ایک قسم کا امریکی النسل بڑا مرغ جو عام طور پر پایا جاتا ہے، فیل مرغ، پیلو۔ادائیگی: { ٹِرِگ (کسرہ ٹ خفیفہ) + نا + میٹ (ی مجہول) + ری }
 ریاضی کا وہ شعبہ جس میں مثلث کے ضلعوں اور زاویوں کی باہمی نسبت سے بحث ہوتی ہے۔ادائیگی: { ٹَر + گی }
 ایک قسم کی گھاس جو چارے میں کام آتی ہے، اسے بھینسیں بڑے شوق سے کھاتی ہیں۔ادائیگی: { ٹَر + رَہ }
 بچھڑا، گھوڑے کا جوان بچہ۔ادائیگی: { ٹِر + ری }
 مفت کی موٹر یا سواری۔ادائیگی: { ٹِر + یا + گَل }
 ایک پرندہ جو درختوں کے کچے اور پکے پھل کھاتا ہے۔ادائیگی: { ٹَرے + جِڈی }
 درد ناک یا المناک واقعہ، شدید حادثہ، حزنیہ، المیہ، وہ ڈراما جس کا موضوع اور اسلوب بلند ہو او انجام المناک ہو۔ادائیگی: { ٹَرے + جِک }
 ٹریجڈی سے منسوب، حزنیہ، المیہ، المناک، دردناک۔ادائیگی: { ٹِرے + زَرَر }
 خازن، خزانچی۔ادائیگی: { ٹِرے + زَری }
 سرکاری خزانہ۔ادائیگی: { ٹِریس (ی مجہول) }
 عکس، چربہ۔ادائیگی: { ٹِرے + سَر }
 چربہ اتارنے والا، ٹریس کرنے والا، نقشہ نویس۔ادائیگی: { ٹِرے + سِنْگ (نون مغنونہ) }
 شفاف کاغذ سے جس میں کسی شے کا عکس نظر آئے خاکہ بنانا یا عکس لینا، ٹریس کرنا، چربہ اتارنا، عکس گیری۔ادائیگی: { ٹِرے + سِنْگ (نون مغنونہ) + پے + پَر }
 وہ کاغذ جس پر ٹریسنگ کی جائے، نقشہ یا چربہ اتارنے کا کاغذ۔ادائیگی: { ٹَرَے (یائے لین) + فِک }
 سواریوں اور راہگیروں کی آمد و رفت، (ریل جہاز وغیرہ کے مال اور مسافروں کی) آمدو رفت؛ مال کی مقدار، مسافروں کی تعداد، محکمہ۔ادائیگی: { ٹَرَے (ی لین) + فِک + جام }
 سڑک پر آمدورفت رک جانا۔ادائیگی: { ٹَرَے (ی لین) + فِک + سِگ + نَل }
 چوراہوں پر نصب وہ روشنی جس سے آمدورفت کھلنے یا بند ہونے کا اشارہ کیا جاتا ہے۔ادائیگی: { ٹَرے + فِک + مَے (ی لین) + نے + جَر }
 ریل یا جہاز وغیرہ کے مال اور مسافروں کی آمد و رفت کے انتظامی محکمہ کا افسر اعلٰی یا سب سے بڑا با اختیار نگران۔ادائیگی: { ٹَرَے (ی لین) + فِک + کَن + ٹَرول (و مجہول) }
 سڑک پر آمد و رفت کی باقاعدگی کا نظام۔ادائیگی: { ٹِرے + لَر }
 فلم کا وہ منتخب حصہ جو اشتہارات یا نمونے کے طور پر پہلے دکھایا جاتا ہے۔ادائیگی: { ٹَریم (ی مجہول) }
 ریل سے ملتی جلتی گاڑی جو ریل کی پٹڑی پر چلتی ہے۔ادائیگی: { ٹَریم (ی مجہول) + وے }
 لوہے کی پٹڑی جس پر ٹریم چلتی ہے۔ادائیگی: { ٹَرین (یائے مجہول) }
 ریل گاڑی۔ادائیگی: { ٹَرے (کسرہ ٹ خفیف) + نِنْگ (ن غنہ) }
 تربیت، تعلیم؛ مشق، ریاضت۔ادائیگی: { ٹَرے + نِنْگ (ن غنہ) + اِس + کُول }
 وہ اسکول یا کالج جہاں کسی مخصوص قسم کی تعلیم یا تربیت دی جائے۔ادائیگی: { ٹِرے + نِنْگ (نون مغنونہ) + کِلاس }
 تربیتی کلاس، جہاں مخصوص فن کی تعلیم دی جائے۔ادائیگی: { ٹِرینْڈ (ی مجہول) }
 (کسی فن یا کام میں تربیت یافتہ) کسی کام کو سیکھا ہوا، مشاق، ماہر، واقف۔ادائیگی: { ٹَرَے (ی لین) + وَل }
 سفر، مسافت طے کرنے کا عمل۔ادائیگی: { ٹَرَے (ی لین) + وَلَر }
 سفر کرنے والا مسافر۔ادائیگی: { ٹَرَے (ی لین) + وَلَر + چیک (ی مجہول) }
 ایسا چیک جسے دستخط کنندہ دوسرے ملک میں بھنا سکے۔ادائیگی: { ٹِری + پَل }
 تگنا، تین گنا۔ادائیگی: { ٹِری + پُو + لی }
 ایک قسم کا پتھر جو بعض مقامات میں بہت نرم ہے مگر بعض جائے نہایت ہی سخت جس کو جلاکا سلیٹ کہتے ہیں اور مثل کرنڈ کے جلا دینے کے کام آتا ہے۔ادائیگی: { ٹَریڈ (یائے مجہول) }
 تجارت، سوداگری، بیوپار، کاروبار۔ادائیگی: { ٹَریڈ (یائے مجہول) + مارْک }
 نشانِ تجارت، رجسٹری کئے ہوئے الفاظ یا نشان جو صناع یا تاجر اپنی مصنوعات اور سامان تجارت کے لیے مقرر کرتا ہے۔
 [ مجازا ] امتیازی علامت، نشان امتیاز۔ادائیگی: { ٹَریڈ (ی مجہول) + یُو + نِیَن }
 کسی صنعت کے مزدوروں اور کارکنوں کی انجمن جو ان کے حقوق کے تحفظ کے لیے قائم کی جائے۔ادارہ برائے خزانہ
ادارہ برائے مالیات
بیت المال
خزانہ کي جگہ
سرشتہ مال
وہ مقام جہاں حکومت کے محاصلات جمع ہوں اور قرضے ادا کیے جائیں
خزانہ، مخزن، ٹریژری،ادائیگی: { ٹِریک (ی مجہول) }
 نشان، لکیر۔ادائیگی: { ٹَرے + کو (و مجہول) + ما }
 آنکھوں کی بیماری جس میں پپوٹوں پر دانے سے نکل آتے ہیں۔ادائیگی: { ٹَرَیکْٹ (ی لین) }
 چھوٹی سی کتاب، رسالہ، خصوصاً مذہبی تبلیغ یا مناظرے کا)۔ادائیگی: { ٹَرَیک (یائے لین) + ٹَر }
 وہ گاڑی جو زرعی مشینری وغیرہ کو کھینچنے یا گھسیٹنے کا کام کرے؛ تیل سے چلنے والی وہ پہیے دار مشین جو کھیتی باڑی میں کام آتی ہے۔ادائیگی: { ٹَریک (ی لین) + ٹَر + پَلانْٹ (ن غنہ) }
 ٹریکٹر بنانے کا کارخانہ۔ادائیگی: { ٹرے + کی + او (و مجہول) + فا + اِٹا }
 نالیاں یا رگیں رکھنے والے پودے۔ادائیگی: { ٹَرے + کِیا }
 ہوا کی نالی۔ادائیگی: { ٹرے + کِیڈ }
 چوب نالی۔ادائیگی: { ٹَری + گَر }
 بندوق کا گھوڑا یا لُبْلُبی۔ادائیگی: { ٹِرے }
 ٹین، المونیم یا دوسری دھاتوں سے بنا یا ہوا کشتی نما ظرف جس پر عموماً چائے اور کھانا وغیرہ رکھ کر مہمانوں کے لیے پیش کیا جاتا ہے، کشتی۔
 کشتی نما خانے (جو کسی مشین یا ٹرنک یا صندوقچے میں بنے ہوتے ہیں)۔ادائیگی: { ٹَسَر }
 ریشم، سلک (خام شکل میں)۔
 ادنی قسم کا ریشم، گھٹیا ریشمی کپڑا، مصنوعی ریشم سے تیار کیا ہوا کپڑا۔
 وہ مصنوعی ریشم کا تاگہ جس سے کشیدہ کاری کی جاتی ہے۔ادائیگی: { ٹَسَر + سِلْک }
 ریشمادائیگی: { ٹَسَر + مَسَر }
 ہچر مچر، ڈھیل، وقفہ، توقف۔ادائیگی: { ٹَسَن }
 ٹوٹ پھوٹ یا پھٹ جانے کا عمل۔ادائیگی: { ٹَس + نا }
 زور یا دباؤ پڑنے سے کپڑے کا پھٹ جانا، مسک جانا، ٹوٹنا، پھوٹنا، جدا ہونا، تعلق ٹوٹنا۔ دوستی نہ رہنا۔ادائیگی: { ٹَس + وا }
 آنسو، عموماً جھوٹ موٹ کے آنسو۔ادائیگی: { ٹَس + وے }
 آنسو، عموماً جھوٹ موٹ کے آنسو۔آنسُو بہانا
اشکباری کرنا
جھوٹ موٹ کے آنسو رونا
جُھوٹا رونا رونا
رونا،دیکھئیے: آخری
مت،ادائیگی: { ٹِسْٹ + ٹِیُوب }
 وہ ٹیوب جس میں کسی چیز یا اس کے کسی جز کو سائنسی یا طبی امتحان اور جانچ کے لیے رکھا جائے۔ادائیگی: { ٹِسْٹ + ٹِیُوب + بے + بی }
 وہ بچہ جو انسانی نطفہ سے مصنوعی طور پر پیدا کیا گیا ہو۔ادائیگی: { ٹِسْٹ + گِلاس }
 آزمائشی شیشہ جس سے نظر کی قوت جانچی جائے۔سدف،ادائیگی: { ٹِس + ٹی + مو (و مجہول) + نِیَل }
 قابلیت تجربہ اور چال چلن وغیرہ کا صداقت نامہ، سند خوشنودی جو بطور صلۂ خدمت سر جلسہ یا سرکاری طور پر دی جائے۔ادائیگی: { ٹَسَک }
 کسک، ٹیس، درد، رہ رہ کر اٹھنے والا درج، چسک۔ادائیگی: { ٹَس + کا + نا }
 حرکت دینا، ہلانا، چلانا، کسی بھاری چیز کو جگہ سے ہٹانا، کھسکانا، سرکانا، تکلیف دینا، تپکنا، درد کرنا، ٹیس پڑنا۔ادائیگی: { ٹَسَک + نا }
 ہلنا، سرکنا، جنبش کرنا۔ادائیگی: { ٹِشُو }
 (نباتیات) یافتہ، ریشہ، نسیج؛ (حیوانات) خلیوں وغیرہ کا سلسلہ، بافت۔ (قاموس الاصطلاحات؛ انگلش اردو ڈکشنری، عبدالحق)
 زربفت، سونے چاندی کے تارے بنا ہوا کپڑا۔ادائیگی: { ٹِشُو + پے + پَر }
 حریری کاغذ، وہ کاغذ جو نمی جذب کرنے کی صلاحیت رکھتا ہے اور نرم ہوتا ہے (چہرے وغیرہ کو صاف اور خشک کرنے کے کام آتا ہے)۔ادائیگی: { ٹِفَن }
 بالعموم دوپہر کا ہلکا کھانا، (مجازاً) دوپہر کے کھانے کا برتن۔ادائیگی: { ٹِفَن + باس + کِٹ }
 ناشتہ دان، ناشتہ رکھنے کی ٹوکری۔ادائیگی: { ٹِفَن + بَکْس }
 ناشتہ رکھنے کا ڈبہ، ناشتہ دان۔ادائیگی: { ٹِفَن + کَے (ی لین) + رِیَر }
 ناشتہ رکھنے کا ڈبہ، ناشتہ دان۔ادائیگی: { ٹُل }
 ایک چیز سے دوسری چیز پر ضرب لگانے کا عمل۔بیت جانا
