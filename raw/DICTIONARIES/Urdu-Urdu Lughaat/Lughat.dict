مرگ پر راضی ہونا
مرنے کی تمنا کرنا
مرنے کی خواہش کرنا
موت قبول کرناادائیگی: { مَوت (و لین) + کا + با + زار }
 جہاں اموات بکثرت ہوتی ہوں، موت کی جگہ۔ادائیگی: { مُوت + کا + بَر + تَن }
 وہ برتن جس میں پیشاب کرتے ہیں، موت پاتر، پیشاب دانی۔ادائیگی: { مَوت (و لین) کا + خا + کَہ }
 موت کی تصویر، مرنے کی حالت یا کیفیت۔ادائیگی: { مَوت (و لین) + کا + خَوف (و لین) }
 مرنے کا ڈر۔ادائیگی: { مَوت (و لین) + کا + دِن }
 مرنے کا دن، انتقال کا دن۔ادائیگی: { مَوت (و لین) کا + دَھڑ + کا }
 مرنے کا ڈر، مرنے کا خوف۔ادائیگی: { مَوت (و لین) + کا + دَہا + نَہ }
 وہ انتہائی مشکل مقام یا مشکل جگہ جہاں موت کا خطرہ ہو۔ادائیگی: { مَوت (و لین) + کا + دیس (ی مجہول) }
 عقبٰی، موت کے بعد رہنے کا مقام، دوسری دنیا۔ادائیگی: { مَوت (و لین) + کا + راگ }
 موت کا نغمہ، موت کا زمزمہ۔ادائیگی: { مَوت (و لین) + کا + رَقْص }
 موت کا ناچ، ہر طرف موت ہی موت، تانڈو نرت۔ادائیگی: { مُوت + کا + رے (ی مجہول) + لا }
 پیشاب کی دھار یا رو۔ادائیگی: { مَوت (و لین) + کا + زَم + زَمَہ }
 موت کا نغمہ، دھیمے سروں میں بجنے والا موت کا گیت۔ادائیگی: { مَوت (و لین) + کا + سا + سَن + نا + ٹا }
 انتہائی خاموش اور افسردگی کا ماحول، موت کی سی خاموشی۔ادائیگی: { مَوت (و لین) + کا + سا + مان }
 اسباب مرگ جو موت سے پہلے تیار کیا جائے (جامع اللغات)، 2۔ کمال مصیبت اور ناگوار امر کی جگہ، موت کا سبب، مرنے کا باعث، وہ چیز جس سے موت واقع ہو۔ادائیگی: { مَوت (و لین + کا + سام + نا }
 قضا کا سامنا، قضا کا رُوبرو ہونا؛ آفت مصیبت کا سامنا، ہلاکت کا مقابلہ۔ادائیگی: { مَوت (و لین) + کا سا + یَہ }
 موت کا خوف، زندگی کی کشمکش میں موت کا دھڑکا۔ادائیگی: { مَوت (و لین) + کا + سَماں }
 نزع کی سی حالت۔ادائیگی: { مَوت (و لین) + کا + سَنْ (نون غنہ) + بھا + لا }
 مرنے سے ذرا پہلے یا نزع کی حالت میں مرنے والے کی حالت تھوڑی سی بہتر ہو جانا۔ادائیگی: { مَوت (و لین) + کا + صَد + مَہ }
 کسی کی موت کا دُکھ، کسی کے مر جانے کا غم۔ادائیگی: { مَوت (و لین) + کا + طَماں + چَہ }
 موت کا تھپڑ، موت کا صدمہ۔ادائیگی: { مَوت (و لین) کا + فَرِش + تَہ }
 ملک الموت، فرشتۂ اجل، عزائیل۔ادائیگی: { مَوت (و لین) + کا + لِباس }
 کفنادائیگی: { مَوت (و لین) + کا + مَرَض }
 وہ بیماری جس کے سبب آدمی مرے، مرض الموت (علمی اردو لغت؛ جامع اللغات)ادائیگی: { مَوت (و لین) + کا + مَن + ظَر }
 موت کے وقت کا حال یا بیان، بہت مشکل وقت۔ادائیگی: { مَوت (و لین) + کا + وَقْت }
 وہ وقت جب دم نکل رہا ہو، موت آنے وقت، نزع کی حالت۔ادائیگی: { موت (و لین) + کا + ٹَٹ + ٹُو }
 بد نصیب، ناکارہ، بد ترین انسان (مہذب اللغات)ادائیگی: { مَوت (و لین) + کا + پَر + وا + نَہ }
 اجل کا پیغام، (مجازاً) موت کا باعث۔ادائیگی: { مَوت (و لین) + کا + پَسی + نَہ }
 ٹھنڈا پسینہ جو حالت نزع میں ماتھے پر آتا ہے، حالت نزع میں یا وقتِ مرگ چہرے پر آنے والا پسینہ۔ادائیگی: { مَوت ( و لین) + کا + پَھن + دا }
 موت کی گھات۔ادائیگی: { مَوت (و لین) + کا + پَے (ی لین) + غام }
 موت کا وقت، پیغام اجل، قضا کا پیام، موت کے آثار، مراد: موت فنا۔ادائیگی: { مَوت (و لین) + کا + ڈَھل + کا }
 موت کے قریب آنکھوں سے پانی بہنا۔ادائیگی: { مَوت (و لین) + کا + کُن (نون غنہ) + واں }
 مصنوعی گول چوبی کنواں جسکی دیواروں پر سرکس میں تماشا دکھانے والےموٹر سائیکل یا گاڑی چلاتے ہیں۔ادائیگی: { مَوت (و لین) + کا + کھا + نا }
 موت کو یاد رکھنا، مرنے کی رٹ لگانا۔ادائیگی: { مَوت (و لین) + کا + گَھر }
 نہایت خطرناک جگہ مرجانے کا شدید اندیشہ ہو۔ادائیگی: { مَوت (و لین) + کا + ہاتھ }
 (کنایۃً) موت کی کیفیت۔ادائیگی: { مَوت (و لین) + کا + ہَر + کا + رَہ }
 مراد: بلوائی، حملہ آور، دہشت گرد، قاتل، پھانس دینے والا۔ادائیگی: { مَو (و لین) + تے + کُب + را (ا بشکل ی) }
 (تصوِف) ایک مرید کی غیر شیخ سے کچھ التجا کرے یہ موت طریقت اور موت کبریٰ ہے (بزمِ صوفیہ: 344)ادائیگی: { مَوت (و لین) + کی + اِط + طِلاع }
 مرنے کی خبر۔ادائیگی: { مَوت (و لین) + کی + با + زی }
 موت کا کھیل، ایسا کام جس میں مرنے کا قوی امکان ہو۔ادائیگی: { مَوت (و لین) + کی + تا + ری + کی }
 مراد: انتہائی سنّاٹا، کچھ سو جھائی نہ دینا۔ادائیگی: { مَوت (و لین) + کی + جَنْگ (نون غنہ) }
 جینے کی جد و جہد، موت سے نبرد آزما رہنا یا ہونا۔ادائیگی: { مَوت (و لین) + کی + خا + مو (و مجہول) + شی }
 مکمل سکوت، مکمل خاموشی، موت کا سا سکوت۔ادائیگی: { مَوت (و لین) + کی + خَبَر }
 وفات کی اطلاع۔ادائیگی: { مَوت (و لین) + کی + دَہ (فتحہ د مجہول) + شَت }
 موت کا خوف۔ادائیگی: { مَوت (و لین) + کی + زَمام }
 موت کی باگ، موت کی نکیل، موت کی مہار۔ادائیگی: { مَوت (و لین) + کی + مَن + زِل }
 انتقال کا وقت، وفات کی گھڑی، وقتِ وصال۔ادائیگی: { مَوت (و لین) + کی + نِینْد (نون غُنہ) }
 ابدی نیند، ہمیشگی کی نیند، مراد موت۔ادائیگی: { مَوت (و لین) + کی + وا + دی }
 وہ جگہ جہاں پر موت آجائے، نہایت خوفناک جگہ۔ادائیگی: { مَوت (و لین) + کی + ٹَھن + ڈَک }
 وہ ٹھنڈ جو مرنے کے بعد مردے کے جسم میں پیدا ہو جاتی ہے۔ادائیگی: { مَوت (و لین) + کی + پال + کی }
 وہ چار پائی جس میں جنازہ لے کر جاتے ہیں۔ادائیگی: { مَوت (و لین) + کی + گَھڑی }
 مرنے کا وقت، موت کا وقت، نزع کی ساعت۔ادائیگی: { مَوت (و لین) + کے + شِکا + ری }
 خوفزدہ کرنے والے، ڈرانے والے، موت سے ہمکنار کرنے والے۔بدنصیبی اور بدطالعی کا ظاہر ہونا
