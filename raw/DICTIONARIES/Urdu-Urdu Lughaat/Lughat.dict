گُن کرنے والا
منفعت بخش
نفع دینے والا
سودمند، مفید،ادائیگی: { نا + فِعِیَت }
 نافع ہونے کی حالت یا حیثیت، افادیت، نفع بخش۔ادائیگی: { نا + فِلَہ }
 (فقہ) وہ عبادت جو فرض نہ ہو اور اپنے طور پر کی جائے، نفل۔ادائیگی: { نا + فِلَہ + اے + شَب }
 رات میں پڑھی جانیوالی نمازِ نافلہ۔ادائیگی: { نا + فِلَہ + اے + اِش + راق }
 طلوعِ آفتاب کے بعد کی نمازِ نافلہ، اشراق۔ادائیگی: { نا + فَنا + پَذِیر }
 جو فنا قبول نہ کرے، ہمیشہ رہنے والا، ابدی، دائم۔ایک تھیلی جو ایک خاص قسم کے ہرن کے پیٹ پر ہوتی ہے۔ اس میں خون جم جاتا ہے جو نہایت خوشبودار ہوتا ہے۔ اسے مشک کہتے ہیں
مُشک نافہ
مُشک کی تھیلی جو ایک قسم کے ہرن کے پیٹ سے نکلتی ہے
ناف سے مشتق ہے
کستُوری كی تھیلی
بینا، مُشک، کستوری، کیسہ،ادائیگی: { نا + فَہ + کُشا }
 نافہ کھولنے والا؛ (مجازاً) خوشبو پھیلانے والا۔ادائیگی: { نا + فَہ + اے + تا + تار }
 وہ مشکِ نافہ جو تاتار میں پائے جانیوالے ہرن کے پیٹ سے نکلتا ہے۔ادائیگی: { نا + فَہ + اے + تِب + بَتی }
 اس خاص ہرن کے پیٹ سے نکلا ہوا نافہ جو ملک تبت اور تاتار میں پایا جاتا ہے۔ادائیگی: { نا + فَہ + اے + خُتَن }
 وہ مشک نافہ جو ختن میں پائے جانے والے ہرن کے پیٹ سے برآمد ہوتا ہے، مُشک ختن۔ادائیگی: { نا + فَہ + اے + مُشْک }
 مشک کی وہ تھیلی جو ایک خاص قسم کے ہرن کے پیٹ (ناف) سے برآمد ہوتی ہے، کستوری کو پوٹلی، نافجہ۔ادائیگی: { نا + فَہْم (فتح ف مجہول) }
 کم عقل، کم علم، بے علم، ناسمجھ، نادان۔ادائیگی: { نا + فَہ (فتح ف مجہول) + می }
 نافہم ہونے کی حالت، کم عقلی، نا سمجھی، کم علمی۔ادائیگی: { نا + فی }
 انکار کرنے والا، مسترد کرنے والا، انکاری، مستردکنندہ۔انکار کرنا
ترديد بياني
حرف نفي
حرفِ نفی
نامنظوري کرنا
انکار، برجت، سالبہ، مفنی، ممنوع، منفی،ادائیگی: { نا + قا + بِل }
 جس میں کسی کام کے کرنے کی لیاقت نہ ہو، صلاحیت سے محروم، قابلیت سے عاری، نا اہل، نالائق۔غير کار آمد
نا کارہ
بیکار،ادائیگی: { نا + قا + بِلے + اِص + لاح }
 جو اصلاح کے قابل نہ ہو، جو درست نہ ہو سکے۔ادائیگی: { نا + قا + بِلے + اِط + می + نان }
 جس سے طبیعت کو اطمینان نہ ہو، بے بھروسہ، غیر تسلی بخش۔ادائیگی: { نا + قا + بِلے + اِع + تِبار }
 جس پر اعتبار نہ ہو، بے بھروسہ ہو۔ادائیگی: { نا قا + بِلے + اِع + تِراض }
 جس پر اعتراض نہ ہو، جو نکتہ چینی سے بالا ہو۔ادائیگی: { نا + قا + بِلے + اِع + تِماد }
 جو اعتماد کے لائق نہ ہو، جس پر بھروسا نہ کیا جا سکے۔ادائیگی: { نا قا + بِلے + اِع + تِنا }
 جو توجہ کے لائق نہ ہو، نظر انداز کیے جانے کے لائق، غیر اہم۔ادائیگی: { نا + قا + بِلُل (ا غیر ملفوظ) + عَمَل }
 جس پر عمل کرنا ممکن نہ ہو۔ امرمحال، مشکل بات، ناقابل عمل۔ادائیگی: { نا + قا + بِلے + اِن + تِقال }
 جسے منتقل نہ کیا جا سکے، جسے کسی کے نام نہ کیا جا سکے۔ادائیگی: { نا + قا + بِلے + اِن + کار }
 جس سے انکار ممکن نہ ہو، جس کو جھٹلایا نہ جا سکے۔ادائیگی: { نا + قا + بِلے + بَر + داشْت }
 جسے جھیلا نہ جا سکے، جس کو سہنا ممکن نہ ہو، جسے اٹھانا قوت سے باہر ہو۔ادائیگی: { نا + قا + بِلے + بَیان }
 جو بیان کرنے کے لائق نہ ہو، جس کا بیان ممکن یا مناسب نہ ہو۔ادائیگی: { نا + قا + بِلے + تَر + دِید }
 جو رد نہ ہو سکے، مستحکم۔ادائیگی: { نا + قا + بِلے + تَس + خِیر }
 جسے فتح نہ کیا جا سکے، جو قابو میں نہ آ سکے، مضبوط، پکا۔ادائیگی: { نا + قا + بِلے + تَصَو + وُر }
 تصور سے بالا، جو گمان میں نہ آش، ناقابل یقین، (مجازاً) غیر معمولی۔ادائیگی: { نا + قا + بِلے + تَق + سِیم }
 جو تقسیم نہ ہو سکے، جس کے حصے نہ ہو سکیں، نہ بٹنے والا۔ادائیگی: { نا + قا + بِلے + تَلا + فی }
 جس کی تلافی ناممکن ہو، جس کا تدارک یا بدل نہ ہو۔ادائیگی: { نا + قا + بِلے + حُصُول }
 جس کا حاصل کرنا ممکن نہ ہو، ہاتھ نہ آنے والا۔ادائیگی: { نا + قا + بِلے + حَل }
 جو حل نہ ہو سکے، سخت یا انتہائی دشوار، بے حد مشکل۔ادائیگی: { نا + قا + بِلے + ذِکْر }
 جس پر چلنا ناممکن ہو، جس پر ہو کر گزر نہ سکیں۔ادائیگی: { نا + قا + بِلے + شَناخْت }
 جو پہچانا نہ جا سکے۔ادائیگی: { نا قا + بِلے + عِلاج }
 جس کا علاج نہ ہو سکے، جو علاج ہو۔ادائیگی: { نا قا + بِلے + عَمَل }
 جو عمل میں نہ لایا جا سکے، جو عمل درآمد کے لائق نہ ہو، جس پر عمل نہ ہو سکے۔ادائیگی: { نا قا + بِلے + فَرا + موش (و مجہول) }
 جو بھلایا نہ جا سکے، یا رہنے والا۔ادائیگی: { نا + قا + بِلے + فَہْم (فتح ف مجہول) }
 جو سمجھ میں نہ آ*، جو سمجھ سے بالاتر ہو۔ادائیگی: { نا قا + بِلے + قُبُول }
 جو ماننے کے لائق نہ ہو۔ادائیگی: { نا + قا + بِلے + مُعا + فی }
 جو معافی دینے کے لائق نہ ہو، معاف نہ کرنے کے لائق۔جِس زَمین پَر کاشت نہ کی جا سَکے
بَنجَر،ادائیگی: { نا + قا + بِلے + گُزَر }
 جس پر چلنا ناممکن ہو، جس پر ہو کر گزر نہ سکیں۔ادائیگی: { نا + قا + بِلے + یَقِین }
 جس کا یقین نہ آ*، نہایت حیرت انگیز۔ادائیگی: { نا + قا + بِلَہ }
 ناقابل کی تانیث، نا اہل عورت۔ادائیگی: { نا + قا + بِلی }
 نا اہلی، نالائقی۔ادائیگی: { نا + قا + بِلی + یَت }
 نا اہلیت، نالائقی۔ادائیگی: { نا + قَبا + حَت + فَہْم (فتح ف مجہول) }
 برائی کو نہ سمجھنے والا، بری سمجھ والا، بری عقل والا۔ادائیگی: { نا + قُبُول }
 جو اپنانے کے قابل نہ سمجھا جا*، جسے کوئی قبول کرنے کو تیار نہ ہو، جس کو ہر کس و ناکس اپنے پاس سے دھتکار دے، نکما، ناکارہ، (مجازاً) معتوب۔ادائیگی: { نا + قُبُو + لی + یَت }
 قبولیت کے قابل نہ ہونا، جس میں اپنائیت کا پہلو نہ ہو، ناپسندیدگی، ناقبول کا اسم کیفیت۔ادائیگی: { نا + قِد }
 روپے اور اشرفی وغیرہ کی کھوٹ اور کھراپن پرکھنے والا، پارکھ، کسی فن کا عیب و ہنر دیکھنے والا، خوبی و خامی جانچنے والا۔
 کارگردگی میں ماہر و مستعد، کام کرنے میں نہایت ہو شیار۔ادائیگی: { نا + قِدا + نے + فَن }
 کسی فن کے عیب و ہنر جانچنے والے۔ادائیگی: { نا + قِدا + نَہ }
 ناقد جیسا، ناقد کی طرح، خوبی و خامی دکھانے والا، عیب و ہنر جانچنے والا، کھوٹ اور کھراپن پرکھنے والا۔ادائیگی: { نا + قَدْر }
 قدر ناشناس، جو کسی کی اہمیت، اہلیت یا مرتبہ نہ پہچانے۔ادائیگی: { نا + قَدْر + شِناس }
 قدر نہ پہچاننے والا، ناقدر، عزت نہ دینے والا۔ادائیگی: { نا + قَدْر + شِنا + سی }
 قدر نہ پہچانے کا عمل، بے وقعتی، اہمیت نہ ہونے کی حالت، قدر و منزلت نہ ہونے کی کیفیت۔ادائیگی: { نا + قَدْ + را }
 ناقدر، قدرناشناس۔ادائیگی: { نا + قَدْر + دان }
 ناقدر، قدر ناشناس۔ادائیگی: { نا + قَدْر + دا + نی }
 ناقدرشناسی، اہلیت، مرتبے اور اہمیت سے عدم واقفیت۔ادائیگی: { نا + قَدْ + ری }
 بے وقعتی، ناقدر شناسی۔بے قدر
جو کسی کی قدر نہ سمجھے
