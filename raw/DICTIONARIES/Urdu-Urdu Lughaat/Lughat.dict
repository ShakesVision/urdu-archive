فریاد داشت
وہ سرکاری کاغذ جو سکّہ کی بجائے کام دیتا ہے
کاغذ کا ورق جو گورنمنٹ سکے کے بجائے جاری کرتی ہے اس پر بادشاہ وقت یا کسی یادگار کی تصویر ہوتی ہے اور لکھا ہوتا ہے کہ "حامل ہذا کو مطالبہ پر ادا کرے گا" یعنی حکومت وعدہ کرتی ہے کہ اسکے پیش کرنے پر زرِ مبادل ادا کیا جائے گا اسے کرنسی نوٹ کہتے ہیں
کاغذی سکہ
یاد داشت
پرچہ، تبصرہ، تشریح، تفسیر، تمسک، چھٹی، حاشیہ، دستاویز، رقعہ، سند، شرح، شقہ، فرویادداشت، نمیقہ، نوشت، ٹیپ، ہنڈی، ہُنڈی، یادداشت،بیاض یادداشت
وہ چھوٹی کتاب جس میں یاد داشت لکھیں
کتابِ یادداشت
بیاض،چٹھی لکھنے کا کاغذسرکاری اطلاع نامہ
اشتہار، اطلاع، اعلان، خبر، یادداشت،ادائیگی: { نَو (و مجہول) + ٹَن (ن غنہ) + کی }
 ایک طرح کا ناٹک یا ڈراما جس میں اکثر ہندوؤں کے تاریخی واقعات کا چربہ اتارا جاتا اور عام طور پر میلوں ٹھیلوں میں دیہاتی عوام کے سامنے پیش کیا جاتا ہے، دیہاتی ناٹک، سانگ، کھیل تماشا۔ادائیگی: { نَو (و مجہول) + ٹِنْگ (ن غنہ) }
 نوٹ لکھنا، خلاصہ تحریر کرنا، دفتری مسل کے سادہ کاغذ پر نمبروار درج ہونے والا خلاصہ (مراسلت کے حصے کے خلاف)۔راگ رنگ
منظوم تمثیل
ناچ گانا
رقص، ناچ، ناٹک، ڈراما،ادائیگی: { نَو (و مجہول) + ٹوں (و مجہول) }
 نوٹ کی جمع نیز مغیرہ حالت، تراکیب میں مستعمل۔ادائیگی: { نو (و مجہول) + ٹوں (و مجہول) کا + ہار }
 وہ ہار جس میں پھولوں کے بجائے رقمی نوٹ پروئے گیے ہوں (عموماً دولھا کو پہنایا جاتا ہے)۔ادائیگی: { نو (و مجہول) + ٹے + شَن }
 (موسیقی) سروں کو علامات کے ذریعے تحریر میں ظاہر کرنا، موسیقی کو قلم بند کرنے کا طریقہ۔ادائیگی: { نو (و مجہول) + ٹی + فا + اِڈ (کسرہ ا مجہول) }
 نوٹس دیا ہوا (شخص) نیز اعلان کردہ، جس کی تشہیر ہو چکی ہو (ایریا کے ساتھ مستعمل)۔ادائیگی: { نو (و مجہول) + ٹی + فا + اِڈ (کسرہ ا مجہول) + اے + رِیا }
 علاقہ جس سے متعلق کوئی اطلاع دی گئی ہو یا اعلان کیا گیا ہو۔ادائیگی: { نو (و مجہول) + ٹی + فِکے + شَن }
 خط یا اشتہار وغیرہ جس سے اطلاع دی جائے، اعلان نامہ، تحریری اطلاع، اطلاع نامہ۔ادائیگی: { نُو + پان }
 ٹوکرا جو بٹی ہوئی بید کی ٹہنیوں سے بنا ہوا ہوتا ہے۔ادائیگی: { نُو + پُر }
 جھانجھر۔(پکنج ۔ س ۔ اندر کھینچنا)
اندر کھینچنا
ایک چوٹکی
نوچنا کا امر
جھپٹ، خراش، کھرونچ، کھسوٹ،ادائیگی: { نوچ (و مجہول) + توڑ (و مجہول) }
 نوچنے توڑنے کا عمل (کنایۃً) لپک جھپک، چھونا پکڑنا، چھیڑ خوانی۔ادائیگی: { نوچ (و مجہول) + ناچ }
 نوچنے کا عمل، نوچ کر پریشان کرنا۔ادائیگی: { نوچ (و مجہول) + ناچ + کَر }
 پنجے سے نوچ کر، اکھاڑ کر، ناخنوں سے خراشیں ڈال کر، بھنبھوڑ کر، بوٹی بوٹی یا ٹکڑے ٹکڑے کر کے۔ادائیگی: { نوچ (و مجہول) + پوچ (و مجہول) }
 نوچ نوچ کر، خراشیں ڈال کر۔ادائیگی: { نوچ (و مجہول) + پھاڑ }
 نوچنے اور پھاڑنے کا عمل، کئی جانب سے کئی آدمیوں یا جانوروں کا کوئی چیز چھیننے جھپٹنے یا لینے کا عمل، لوٹ کھسوٹ، چھینا چھٹی، (مجازاً) غارت گری۔ادائیگی: { نوچ (و مجہول) + کَھسوٹ (و مجہول) }
 بدن پر ناخنوں سے خراش ڈالنے کا عمل، (کنایۃً) لڑائی، ہاتھا پائی۔ادائیگی: { نوچ (و مجہول) + کھسوٹ (و مجہول) + کے }
 لوٹ کر، زبردستی، چھین جھپٹ کر۔ادائیگی: { نوچ (و مجہول) + کھوچ (و مجہول) }
 باہم ٹونے کا عمل، آپس میں ٹکرانا، رگڑ کھانا۔ادائیگی: { نوچ (و مجہول) }
 نوچنا کا امر، تراکیب میں مستعمل۔ادائیگی: { نوچ (و مجہول) }
 کسی سطح یا کنارے پر بنا ہوا کٹاؤ کا نشان، کسی مرحلے یا پیمانے کے شمار کا نشان یا لکیر، وہ نشان جو گھڑی پر دقیقوں کے شمار کے لیے بنایا جاتا ہے۔ادائیگی: { نو (و مجہول) + چا }
 نوچنا کا ماضی، تراکیب میں مستعمل۔ادائیگی: { نو (و مجہول) + چا + نا + چی }
 چھینا جھپٹی۔ادائیگی: { نو (و مجہول) + چا نو (و مجہول) + چی }
 نوچنے کا مسلسل عمل، پنجے سے گوشت کو جدا کرنا، بھنبھوڑنا، (مجازاً) لوٹ مار، دست اندازی۔ادائیگی: { نو (و مجہول) + چا + کھو (و مجہول) + چی }
 نوچنے کھوچنے کا عمل، ناخن سے خراشیں ڈالنا، (کنایۃً) چٹکی بھرنا، ہاتھوں سے چھیڑنا۔ادائیگی: { نو (و مجہول) + چَم }
 نوچ، تراکیب میں مستعمل۔ادائیگی: { نو (و مجہول) + چَم + نا + چی }
 نوچا ناچی، پنجے سے گوشت کھینچنے کا عمل۔ادائیگی: { نو (و مجہول) + چَم + کَھسوٹ (و مجہول) }
 بدن پر خراشیں ڈالنے کا عمل، (مجازاً) لڑائی جھگڑا۔ادائیگی: { نو (و مجہول) + چَن }
 (لفظاً) نوچنے کا عمل، تراکیب میں مستعمل۔ادائیگی: { نو (و مجہول) + چَن + کَھسو (و مجہول) + ٹَن }
 نوچنے کھسوٹنے کا عمل، اکھیڑنا، ادھیڑنا، (مجازاً) ورق گردانی (غصے کی حالت میں)۔بال اکھاڑنا
پنجہ مارنا
پھاڑ کھانا یا شکاری پرند کا چونچ یا ناخنوں سے گوشت اکھاڑنا
چٹکی لینا یا بال کھینچ لینا
دانت سے کھسوٹنا
شاخ سے پتیاں اکھاڑنا
غارتگری کرنا
لوٹ لینا
موس لینا
ناخن مارنا
بکوٹنا، لُوٹنا، مُوسنا، ٹھگنا، کھرچنا، کُھرچنا، کھسوٹنا، کھوسنا،ادائیگی: { نو (و لین) + چَن + دا }
 وہ دن جو قمری آغاز ماہ کے پہلے پنج شنبے کے بعد پڑے۔چاند رات کی پہلی جمعرات جس میں لوگ بزرگوں کے مزاروں پر جاتے فاتحہ پڑھتے اور شیرینی وغیرہ تقسیم کرتے ہیں
نئے چاند کے دوسرے روز کی جمعرات
نوچندی جمعرات
وہ جمعرات جو چاند کے دوسرے روز واقع ہوادائیگی: { نَو (و لین) + چَن + دی + جُم + عَرات (فتحہ ع مجہول) }
 قمری مہینے کی پہلی جمعرات جس میں بہت اہتمام کیا جاتا ہے۔ادائیگی: { نو (و مجہول) + جُو }
 نوچنے والا، موسنے والا، مال مارنے نیز رشوت کھانے والا آدمی۔چَڑھاوا
ايثار، بھينٹ، قرباني، نذر، نياز،(ف ۔ نوچہ ،نوجوان لڑکا)
بازاری عورتوں کی لونڈی یا بیٹی جس سے وہ کسب کموا کر کھاتی ہیں
پیشہ کرانے والی نائکہ
نوجوان لڑکی جس سے طوائفیں پیشہ کراتی ہیں
کواری بازاری لڑکی
کٹنوں کی لڑکی
کُٹنوں کی لڑکیادائیگی: { نو (و مجہول) + چی + کَھسو (و مجہول) + ٹی }
 لوٹی ہوئی (عورت) جسے لوٹا گیا ہو، (مجازاً) جس کی آبرو ریزی کی گئی ہو نیز اجڑی ہوئی، تباہ حال۔ادائیگی: { نو (و مجہول) + چے }
 نوچنا کا امر، تراکیب میں مستعمل۔ادائیگی: { نوڈ (و مجہول) }
 (نباتیات) پودے یا درخت کے تنے یا شاخ کا وہ حصہ جہاں سے پتا نکلتا ہے، گانٹھ جہاں سے پتیاں پھوٹتی ہیں۔ادائیگی: { نوڈ (و مجہول) + دار }
 گرہ دار، گانٹھ والا، جس میں گانٹھیں ہوں (تنا، شاخ وغیرہ)۔ادائیگی: { نو (و مجہول) + ڈَل }
 نوڈ (گرہ یا گلٹی) سے متعلق، گرہ دار۔تابعداریا فرماں بردار بنانا
جھکنے پر مجبور کرنا
فتح یا زیر کرنا
قابو کرنا
جھکانا،التفات کرنا
خمیدہ ہونا
زیر ہونا
مطیع ہونا
میل کرنا
جھکنا،ادائیگی: { نوک (و مجہول) }
 بھال، نیش، ڈنک، پھننگ، چونچ، منقار۔
 پاس، وضع، وضعداری۔
 دون، نمود، شیخی، ڈینگ، چھیڑ، چھیڑخانی۔
 عزت، ٹیک، ناک۔
 آن، انوٹ، انداز، وضعداری، ادا۔ادائیگی: { نوک (و مجہول) + با + زی }
 چھیڑخانی، چھیڑ چھاڑ، ہنسی مذاق۔ادائیگی: { نوک (و مجہول) + جھونْک (و مجہول، ن مغنونہ) }
 طعن و طنز کی باتیں، چھیڑ چھاڑ، چھیڑ خوانی نیز شوخی و شرارت۔ادائیگی: { نوک (و مجہول) + چھوک (و مجہول) }
 طعن و تشنیع، چھیڑ چھاڑ۔ادائیگی: { نو (و مجہول) + کے + خار }
 کانٹے کی نوک، کانٹے کا تیز جھبنے والا سرا، (عموماً شاعری میں مستعمل)۔ادائیگی: { نو (و مجہول) + کے + خَن + جَر }
 خنجر کی نوک، خنجر کا تیز جبھنے والا سرا۔ادائیگی: { نوک (و مجہول) + دار }
 نوک رکھنے والا، نکیلا، چبھنے والا، جس کا سرا تیز نوک والا ہو۔ادائیگی: { نوک (و مجہول) + دار + بَر + مَہ }
 برمے کی ایک قسم، چھیدنے کا وہ آلہ جس کا سرا تیز اور نکیلا ہو۔ادائیگی: { نوک (و مجہول) + دار + رے + شے }
 جڑوں کے طور پر استعمال ہونے والے بال کی طرح کے ریشے۔ادائیگی: { نوک (و مجہول) + دار + مِح (کسرہ م مجہول) + راب }
 (معماری) وہ محراب جس کا بالانی سرا تیر یا نیزے کے پھل سے ملتا جلتا ہوتا ہے۔ادائیگی: { نوک (و مجہول) + دار + کَمان }
 (معماری) وہ کمان جس کا شکم دو مساوی قوسین سے بنتا ہے اور جس کے نصف قطر نصف خانے سے بڑے ہوتے ہیں، محراب نما کمان، گاتھی۔ادائیگی: { نوک (و مجہول) + دُم }
 دم کو اس طرح اٹھائے ہوئے کہ نوک سیدھی رہے جس طرح کتا جوش میں آکر بھاگتا ہے یا ڈر سے دم دبا کر بھاگتا ہے۔ادائیگی: { نوک (و مجہول) + ریز (ی مجہول) + خا + مَہ }
 اتنا لکھنے والا کہ قلم کی نوک گھس جائے، مراد، بہت لکھنے والا بہت تحریر کرنے والا۔ان معنوں میں بلا اضافت بھی استعمال ہوتا ہے
حفظ ازبر
زبان کا سر
زبان کی نوک
زبانی یاد
ازبر، حفظ، زبانی، یاد،ادائیگی: { نو (و مجہول) + کے + زُباں }
 زباں کی نوک (مجازاً) منہ سے نکلی ہوئی بات۔ادائیگی: { نو (و مجہول) + کے + سِناں }
 نیزے کی نوک، انی (شاعری میں مستعمل)۔ادائیگی: { نوک (و مجہول) + کے + سِناں + پَر }
 طاقت کے زور پر، جبراً، زبردستی۔ادائیگی: { نوک (و مجہول) + سی + بات }
 نوکیلی یا چبھتی ہوئی بات، طنزیہ بات، لعن طعن کی گفتگو۔ادائیگی: { نو (و مجہول) + شَم + شِیر + سے }
 طاقت سے، زور کے بل پر۔ادائیگی: { نو (و مجہول) + کے + شَم + شِیر + پَر }
 طاقت کے زور پر۔ادائیگی: { نو (و مجہول) + کے + قَلَم }
 قلم کا سرا، نب، مراد، لکھنے کی قوت، تحریر کی کاٹ۔ادائیگی: { نو (و مجہول) + کے + قَلَم + سے }
 قلم کے ذریعے، لکھ کر، تحریر کرکے۔ادائیگی: { نو (و مجہول) + قَلَم + پَر }
 تحریر میں۔ادائیگی: { نو (و مجہول) + کے + مِژ + گاں }
 پلک کی نوک، پلک کا سرا، مراد، پلکیں۔ادائیگی: { نو (و مجہول) + کے + نِش + تَر }
 نشتر کی نوک، نشتر کا باریک سرا۔ادائیگی: { نوک (و مجہول) + نَکی + سے + دُرُسْت }
 نوک پلک سے درست، ہر طرح سے ٹھیک یا تیار، (مجازاً) سجا بنا، آراستہ۔ادائیگی: { نو (و مجہول) + کو (و مجہول) + پَلَک + کی + دُرُس + تَگی }
 کانٹ چھانٹ، اصلاح (کسی تحریر کی)۔ادائیگی: { نوک (و مجہول) + ٹوک (و مجہول) }
 سمجھانے کا عمل یا باتیں، اعتراض۔ادائیگی: { نوک (و مجہول) + پان }
 (جفت فروشی) جوتی کی نوک اور ایڑی پر لگا ہوا پان کی وضع کا چمڑے کا ٹکڑا نیز جوتے کی تراش خراش، خوبصورتی اور مضبوطی۔ادائیگی: { نوک (و مجہول) + پَلَک }
 ناک نقشے کی موزونیت، دلکش وضع۔ادائیگی: { نوک (و مجہول) + پَلَک + سے + دُرُسْت }
 ہر طرح سے ٹھیک، نک سک سے درست، پوری طرح درست، موزوں، ٹھیک۔ادائیگی: { نوک (و مجہول) + پَلَک + کا }
 جس کا ناک نقشہ عمدہ ہو، جس کی آنکھ بہت موزوں ہو، نک سک سے درست، خوبصورت۔ادائیگی: { نوک (و مجہول) + پَلَک + کی + دُرُس + تی }
 ہر طرح سے ٹھیک کرنے کا عمل، آخری اصلاح، تکمیلی عمل۔ادائیگی: { نوک (و مجہول) + پَن }
 (لفظاً) نکیلا ہونے کی حالت، (مجازاً) بانکیں، خوش وضعی، خوش ادائی۔ادائیگی: { نوک (و مجہول) پَن + چَہ }
 چہرہ اور ہاتھ پانو، ناخن وغیرہ نیز ناک نقشہ، حلیہ وغیرہ۔ادائیگی: { نوک (و مجہول) + چوک (و مجہول) }
 شوخی و شرارت، چھیڑ چھاڑ۔ادائیگی: { نوک (و مجہول) + ڈار + وِن }
 وہ مخروطی شکل کی نوک جو بعض لوگوں کے کانوں کے بالائی حصے میں نمودار ہو جاتی ہے جہاں کہ کران اندر کی طرف مڑتے ہیں۔ادائیگی: { نوک (و مجہول) + کا }
 نوک والا، نوکیلا، نوک دار۔ادائیگی: { نوک (و مجہول) + کا + جَوان }
 بانکا سجیلا جوان، طرح دار جان۔ادائیگی: { نوک (و مجہول) + کی }
 نوک کا کی تانیث، وضع داری کی، بانکپن والی، نوکیلی۔ادائیگی: { نوک (و مجہول) + کی + بات }
 طعن و طنز کی بات، آن بان کی بات، عزت کی بات۔ادائیگی: { نَو (و لین) + کا }
 کشتی کی ایک قسم، چھوٹی کشتی، ڈونگی، بجرا۔ادائیگی: { نو (و مجہول) + کا + جھو (و مجہول) + کی }
 چھیڑ چھاڑ، آوازہ تواز، شوخی و حرارت، طعن و طنز۔ادائیگی: { نَو (و لین) + کا + دار }
 جہاز کا کپتان، ناخدا، کماندار۔ادائیگی: { نَو (و لین) + کار }
 جس نے نیا نیا کام شروع کیا ہو (مجازاً) ناتجربہ کار۔انی دار
چبھنے والا
نکیلا،ادائیگی: { نَو (و لین) + کَر }
 چاکر، ملازم، ٹہلوا، خدمت گار، سیوک، خادم، خدمت گزار۔ادائیگی: { نَو (و لین) + کَر + شا + ہی }
 (تحقیراً) حکومت کے اعلٰی سرکاری افسران جوپس پردہ حکومت چلاتے ہیں، بیورو کریسی۔ادائیگی: { نَو (و لین) + کَر + پَر + وَری }
 نوکروں کی پرورش کرنے کا عمل، (مجازاً) ملازموں کا خاص خیال رکھنا، ملازموں سے رحم دلی سے پیش آنا۔ادائیگی: { نَو (و لین) + کَر + پے + شَہ }
 جس کی روزی کا دار و مدار ملازمت پر ہو، جس کا پیشہ ملازمت ہو۔ادائیگی: { نَو (و لین) + کَر + چا + کَر }
 ملازمان، خدمت گاران، ملازمین (عموماً) گھریلو ملازمین۔تنخواہ پر دوسرے کی خدمت کرنا
مشاہرے کے عوض تابع ہوجاناادائیگی: { نَو (و لین) + کَرا + نی }
 نوکر کی تانیث، گھریلو ملازمہ، خادمہ، ماما۔نوکرانی،حق الخدمت
خدمت گاری
خدمت گزاری
نوکر کا کام یا پیشہ
کام جس پر کوئی آدمی تعینات کیا جائے
اسامی، بندگی، پیشہ، تنخواہ، جگہ، چاکری، خدمت، روزگار، سیوا، شغل، علاقہ، عہدہ، غلامی، مشاہرہ، ملازمت، منصب، ٹہل، ڈیوٹی، کام،ادائیگی: { نَو (و لین) + کَری + وا + لا }
 نوکری دینے کے قابل، جو ملازم یا نوکر رکھ سکتا ہو۔ادائیگی: { نَو (و لین) + کَری + پے + شَگاں }
 نوکری پیشہ کی جمع، تنخواہ پر کام کرنے والے، ملازمت پیشہ لوگ۔ادائیگی: { نَو (و لین) + کَری + پے + شَہ }
 نوکری کرکے روزی کمانے والا، ملازمت کرنے والا، ملازمت پیشہ (شخص)۔ادائیگی: { نَو (و لین) + کَری + چا + کَری }
 ملازمت، خدمت گزاری وغیرہ۔ادائیگی: { نَو (و لین) + کَری + کا + بُلا + وا }
 نوکری پر حاضر ہونے کا حکم، ملازمت کی پیش کش۔ادائیگی: { نَو (و لین) + کَری + کا + سِل + سِلَہ }
 ملازمت کا سلسلہ، نوکری کا تعلق۔ملازمت کرنا
کام بجا لاناادائیگی: { نو (و مجہول) + کِنْگ (ن غنہ) }
 ضرب لگانا، ضرب کی آواز، کھٹ کھٹ کی آواز، موٹر کے انجن میں پسٹن یا کسی اور چیز کے لگنے کی آواز۔ادائیگی: { نو (و مجہول) + کی + لا }
 نوک دار، گاؤدم، مخروطی، چونچ دار، نیز چبھنے والا۔ادائیگی: { نو (و مجہول) + کی + لا + پَن }
 نوکیلا ہونے کی حالت، چبھنے کی کیفیت (مجازاً) پر تاثیری، دل میں اتر جانے کا وصف، نوک پلک سے درستی (عموماً شعر، نثر وغیرہ کے لیے مستعمل)۔ادائیگی: { نو (و مجہول) + کی + لی }
 نوک دار، مخروطی، سرے والی، چبھنے والی۔ادائیگی: { نو (و مجہول) + کیں (ی مجہول) }
 نوک کی جمع، تراکیب میں مستعمل۔تازہ گرفتار
عاشقِ تازہ
مُبتلائے تازہ
