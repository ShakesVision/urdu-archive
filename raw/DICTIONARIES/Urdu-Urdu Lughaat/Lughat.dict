وہ زورشور کی بارش جو دیر تک رہےموسل کی جمعادائیگی: { مُوس + لی }
 موسل، وہ ڈنڈا جس سے اوکھلی میں اناج وغیرہ کوٹتے ہیں۔ادائیگی: { مَو (و لین) + سَم }
 سماں، زمانہ، رُت، فصل، وقت (کسی چیز کا)
 [ مجازا ] کسی موسم، وقت کے شروع ہونے سے ختم ہونے تک کی مدت، دور، چکر۔
 کسی مقام کی سردی، گرمی، نمی وغیرہ اور اس سے پیدا ہونے والی فضائی کیفیت، آب و ہوا۔
 سال کی چار فصلوں میں سے ایک (سردی، گرمی، خزاں، بہار)ادائیگی: { مَو (و لین) + سَمے + با + راں }
 برسات کا موسم، وہ زمانہ جس میں بارشیں ہوتی ہیں؛ (کنایۃً) رونے کا سماں یا کیفیت۔ادائیگی: { مَو (و لین) + سَمے + بَد }
 خراب موسم (جیسے جھکڑ آندھی وغیرہ کا زمانہ)۔ادائیگی: { مَو (و لین) + سَمے + بَر + سات }
 وہ موسم جس میں بارشیں ہوتی ہیں، برسات کا موسم، برکھا رُت۔ادائیگی: { مَو (و لین) + سَمے + بَر + شَکال }
 موسم باراں، موسم برسات۔بارش کا سماں
برسات کا موسم
مینہ برسنا
رُت،ادائیگی: { مَو (و لین) + سَمے + بَر + ری }
 خشک زمین کا موسم؛ (جغرافیہ) نہایت سرد اور خشک ہواؤں کا موسم۔ادائیگی: { مَو (و لین) + سَمے + بَہار }
 درختوں کی ہریالی اور پھلوں کے کھلنے کا موسم جو فروری سے اپریل تک رہتا ہے، بہار کا موسم۔ادائیگی: { مَو (و لین) + سَمے + بَہار + کا + راگ }
 راگ شدھ بہار جو کافی ٹھاٹھ کا وکر کھاڈو راگ ہے؛ مراد: جس کے سروں میں خوشی کا تاثر جھلکتا ہے۔ادائیگی: { مَو (و لین) + سَمے + خَرِیف }
 (کاشتکاری) ساون کی فصل؛ موسم خزاں۔ادائیگی: { مَو (و لین) + سَمے + خِزاں }
 وہ موسم جس میں درختوں سے پتے جھڑ جاتے ہیں، یہ نومبر سے جنوری تک ہوتا ہے، پَت جھڑ، خریف؛ (کنایۃً) زوال کا زمانہ، پیری کا زمانہ، بڑھاپا، ڈھلتی جوانی (جامع اللغات، علمی اردو لغت)۔ادائیگی: { مَو (و لین) + سَمے + خِزاں + کی + لَک + ڑی }
 سالانہ حلقوں کا وہ حصہ جس کی تکمیلی ٹھوس ریشوں سے موسم کے آخر میں ہوتی ہے۔ادائیگی: { مَو (و لین) + سَمے + دار }
 پھانسی پر چڑھنے کا موسم، (مجازاً) ظلم و جبر کا زمانہ۔ادائیگی: { مَو (و لین) + سَمے + دی + وا + نَہ + گَر }
 مجنوں یا دیوانہ بنا دینے والا موسم (کنایۃً) بہار کا موسم۔ادائیگی: { مَو (و لین) + سَمے + رَبِیع }
 (کاشت کاری) پھول کھلنے کا موسم، موسم بہار، بسنت رُت۔ادائیگی: { مَو (و لین) + سَمے + رُو + ای + دَگی }
 (کاشتکاری) موسمِ ربیع، پھول کھلنے کا موسم، بہار کا موسم۔ادائیگی: { مَو (و لین) + سَم + زَد + گی }
 موسم سے متاثر ہونے کی کیفیت، آب و ہوا یا موسم کے اثرات عموماً بُرے معنوں میں)۔ادائیگی: { مَو (و لین) + سَمے + سَر + ما }
 سردی کا موسم، جاڑا جو عموماً اکتوبر سے فروری تک مانا جاتا ہے۔ادائیگی: { مَو (و لین) + سَم + سَہار }
 (معماری) آٹ ہوا کی سختی کو برداشت کرنے والا، موسم جھیلنے کی صلاحیت رکھنے والا۔ادائیگی: { مَو (و لین) + سَمے + شِتا }
 موسم سرما، جاڑا (جامع اللغات)۔ادائیگی: { مَو (و لین) + سَم + شَناس }
 موسم پہچاننے والا؛ (جغرافیہ) موسم کا علم رکھنے والا، ماہر موسمیات۔ادائیگی: { مَو (و لین) + سَم + شَنا + سی }
 موسم شناس کا کام یا منصب، موسم کے علم میں مہارت، موسیمات، طبعی جغرافیہ۔ادائیگی: { مَو (و لین) + سَم + نُما }
 موسم ظاہر کرنے والا؛ (مجازاً) موسم کے تغیر و تبدل۔ادائیگی: { مَو (و لین) + سَم + کے + مے + وے }
 ہر موسم یا رواں موسم کے پھل، فصل کا میوا۔ادائیگی: { مَو (و لین) + سَم + کے + نَق + شے }
 (جغرافیہ) وہ نقشے جو ماہرین موسمیات کے تغیر و تبدّل کے بارے میں تیار کرتے ہیں۔ادائیگی: { مَو (و لین) + سَمے + گَر + ما }
 گرمی کا موسم جو عموماً اپریل سے ستمبر تک ہوتا ہے۔ادائیگی: { مَو (و لین) + سَمے + گُل }
 پھولوں کا موسم، مراد: موسم بہار، بہار کا زمانہ۔ادائیگی: { مَو (و لین) + سَم + بی }
 نارنجی رنگ کا ایک خوش ذائقہ پھانک دار پھل۔ادائیگی: { مَو (و لین) + سَمی }
 فصل کا، رُت کا، وقت کا، زمانے کا، موقع کا؛ (مجازاً) وقتی، عارضی۔ادائیگی: { مَو (و لین) + سَمی + با + زار }
 وہ بازار جو مقررہ دن یا تہوار کی رعایت سے لگایا جائے، پینٹھ۔ادائیگی: { مَو (و لین) + سَمی + بُخار }
 کسی موسم کے اثرات کے باعث ہونے والا بخار جو ایک خاص مدت میں اتر جاتا ہو۔ادائیگی: { مَو (و لین) + سَمی + بَے (ی لین) + روز (و مجہول) + می + ٹَر }
 (طبعیات) ہوا کا دباؤ ناپنے کا آلہ۔ادائیگی: { مَو (و لین) + سَمی + بیل (ی مجہول) }
 (نباتیات) وہ بیل جو کسی ایک موسم میں اُگتی اور مرجھا جاتی ہو؛ (مجازاً) عارضی چیز (کنایۃً) بے سہارا اور کمزور چیز۔ادائیگی: { مَو (و لین) + سَمی + تِت + لی }
 تتلیاں یا پرندے جن کی افزائش کسی خاص موسم تک محدود ہو؛ (مجازاً) موسم کے ساتھ آنے جانے والی کوئی چیز، عارضی چیز۔ادائیگی: { مَو (و لین) + سَمی + تَپ }
 موسمی بخار، موسمی اثرات سے چڑھنے والا بخار جو کچھ مدت کے بعد خود بخود اتر جائے۔ادائیگی: { مَو (و لین) + سَمی + تَہ (فتحہ ت مجہول) }
 (طبعیات) کرہ ہوائی کی پست ترین تہ جس میں بادل بنتے ہی اور ہوا کی حرکت سے طوفان آتے ہیں یہ تقریباً سات میل موٹی ہوتی ہے۔ادائیگی: { مَو (و لین) + سَمی + راگ }
 (موسیقی) کسی مخصوص موسم یا رُت سے متعلق یا نسبت رکھنے والا راگ۔ادائیگی: { مَو (و لین) + سَمی + عَوا + مِل }
 (نباتیات) بارش، تپش، روشنی وغیرہ جو پودوں کی نشوونما کے لیے ضروری سمجھے جاتے ہیں۔ادائیگی: { مَو (و لین) + سَمی + کا + یا + پَلَٹ }
 موسمی تبدیلی، موسم بدل جانا، موسمی تغیرات۔ادائیگی: { مَو (و لین) + سَمِیات }
 موسم اور آبو ہوا کا علم (Meterology)۔ادائیگی: { مَو (و لین) + سَمِیات + داں }
 ماہر موسمیات، موسم اور آب و ہوا کی کیفیات جاننے والا۔ادائیگی: { مَو (و لین) + سَمِیا + تی }
 موسمیات سے منسوب یا متعلق، موسمی۔ادائیگی: { مَو (و لین) + سَم + یا + نا }
 ایک آلے سے درونِ حانہ (عموماً کسی عمارت یا موٹرگاڑی وغیرہ میں) ہوا کی کیفیت اور حرارت کو حسب خواہش رکھنا۔ (Air Conditioning)۔ادائیگی: { مُو + سَن }
 چوری، اٹھائی گیری۔ادائیگی: { مُوس + نا }
 چوہے کی طرح چپکے سے چیزوں کا صفایا کر دینا، چھوٹی چھوٹی مقدار میں چوری کرنا، اُچک لینا، مال و اسباب چرا لینا، بٹور لینا۔ادائیگی: { مُوَس + وِس }
 اپنے آپ سے باتیں کرنے والا یا بڑبڑانے والا، بکواسی؛ وسوسے میں ڈالنے والا۔ادائیگی: { مُوَس + وِسَہ }
 وسوسہ ڈالنے والا، وسوسے میں مبتلا کرنے والا؛ (مجازاً) بہکانے والا۔ادائیگی: { مَو (و لین) + سُو + عات }
 دائرۃ المعارف (انسائیکلوپیڈیا) کی طرز پر لکھی گئی تابیں، قاموسی کتب۔ادائیگی: { مَو (و لین) + سُو + عَہ }
 دائرۃ المعارف، انسائیلوپیڈیا۔ادائیگی: { مَو (و لین) + سُو + عَہ + نَوِیس }
 دائرۃ المعارف جیسی کتابیں لکھنے والا شخص، قاموسی کتب کا مرتب۔ادائیگی: { مَو + سُو + عَہ + نِگار }
 دائرۃ المعارف جیسی لکھن والا شخص، قاموسی کتب کا مرتب۔ادائیگی: { مَو (و لین) + سُو + عی }
 انسائیکلو پیڈیائی، دائرہ المعارف (موسُوعہ) سے منسوب یا متعلق، قاموسی۔ادائیگی: { مَو (و لین) + سُوم }
 نشان دیا گیا، جس پر داغ یا نقش دیا گیا ہو، داغ دار، منقوش (ماخوذ: فرہنگ آصفیہ؛ جامع اللغات)۔ادائیگی: { مَو (و لین) + سُوم + بَہ }
 (کسی) سے موسوم، (کسی کے) ساتھ منسوب۔ادائیگی: { مَو (و لین) + سُوم + عَلَیہ (ی لین) }
 (قانون) وہ جسے نامزد یا مقرر کیا گیا ہو (ہنڈی یا بل کی وصولی کے لیے)۔ادائیگی: { مَو (و لین) + سُوم + عَلَی (و لین) + ہِم }
 (قانون) موسوم علیہ جس کی یہ جمع ہے۔ادائیگی: { مو (و لین) + سُوم }
 نام دیا گیا، ملقب، مخاطب؛ مشہور و معروف۔ادائیگی: { مَو (و لین) + سُو + مات }
 وہ چیزیں جس پر ان کے بنانے والے یا مالک کا نام، پتا، نشان یا تصویر وغیرہ کندہ ہوں، نیز حوالے، نام وغیرہ۔ادائیگی: { مَو (و لین) + سُو + مَہ }
 نام دیا ہوا، ملقب، منسوب کیا ہوا۔ادائیگی: { مُو + سَوی }
 حضرت موسٰی سے منسوب، حضرت موسٰی کا؛ امام موسٰی کاظم سے منسوب یا متعلق، امام موسٰی کاظم کی اولاد۔ادائیگی: { مُو + سَوی + شَری + عَت }
 حضرت موسٰی کی لائی ہوئی شریعت، حضرت موسٰی کا مذہب۔ادائیگی: { مُو + سَوی + فَر }
 حضرت موسٰی علیہ السلام کی سی شان و شوکت۔ادائیگی: { مُو + سَویْ + یَت }
 حضرت موسٰی علیہ السلام کی لائی ہوئی شریعت، حضرت موسٰی کا مذہب۔آلۂ مُو تراشی
ایک مشہور پیغمبر بنِ عمران کا نام جن پر کتاب توریت نازل ہوئی
با وصیت
جو وصيت کر گيا ہو
سر مُونڈنے کا آلہ
مرت لیکھک
وصيت کنندہ
وصيت کيا گيا
وصیت کردہ
وصیت کرنے والا
اُسترہ، موصی،ادائیگی: { مُوس + ڈِیَر }
 شمالی امریکہ میں پایا جانے والا بارہ سنگھیا جس کے سینگ نہایت شاخ دار اور وزنی گردن چھوٹی مگر مضبوط اور ٹانگیں لمبی ہوتی ہیں اور کاندھے کی طرف سے گھوڑے سے اونچا ہوتا ہے، بارہ سنگھا۔ادائیگی: { مَو (و لین) + سی }
 ماں کی بہن، خالہ، ماسی۔ادائیگی: { مُو + سِیے + عِم + ران }
 حضرت موسٰی علیہ السلام جو عمران کے بیٹے تھے۔ادائیگی: { مُو + سا (ا بشکل ی) }
 سر مونڈنے کا آلہ، استرہ۔ادائیگی: { مَو (و لین) + سے (ی مجہول) + را }
 خالا زاد بھائی، ماں کی بہن کا بیٹا۔ادائیگی: { مَو (و لین) + سے + ری }
 ماں کی بہن کی بیٹی، موسی (خالہ) کی بیٹی، خالہ زاد بہن۔ادائیگی: { مُو + سِیر + یا }
 وہ بیل جس کی دم کے بال بیچ میں سفید اور سروں پر کالے ہوں۔ادائیگی: { مُو + سی + قا + ای }
 موسیقی کا، موسیقی سے متعلق۔ادائیگی: { مُو + سی + قا + ای + پَے (ی لین) + ما + نَہ }
 (موسیقی) مختلف سُروں کا ایسا سسلہ جن کے درمیان کوئی سادہ لیکن خاص وقفہ موجود ہو اور جو یکے بعد دیگرے بجائے جانے پر ہمارے کانوں کو بھلا معلوم ہو، سپتک (Musical Scale)۔ادائیگی: { مُو + سی + قار }
 ایک روایتی پرند کا نام جس کی چونچ میں بہت سے سوراخ بتائے گئے ہیں اور ان میں سے ہوا کے گزرنے سے طرح طرح کے سر پیدا ہوتے ہیں بوڑھا ہونے پر یہ لکڑیاں جمع کرتا ہے اور اپنے سروں سے ان میں آگ لگا کر جل بھن کر راکھ ہو جاتا ہے یہ بھی کہا جاتا ہے کہ حکمائے علم موسیقی اسکی آوازو سے نکالا ہے، ققنس، دیپک لات؛ (مجازاً)موسیقی کا ماہر، گانے والا، گلوکار، گویا۔ادائیگی: { مُو + سی + قا + را + نَہ }
 موسیقی کی طرح کا نیز موسیقی کا، موسیقیت والا، سوسیقایائی، سریلا۔ادائیگی: { مُو + سی + قا + نَہ }
 موسیقارانہ؛ موسیقیت کا، سُریلا، موسیقی کے سروں کے اصول پر مبنی، موسیقایائی۔ادائیگی: { مُو + سی + قَہ }
 موسیقی سے منسوب، گانے بجانے کا فن یا علم، موسیقی کا نیز موسیقی۔ادائیگی: { مُو + سی + قی }
 گانے بجانے کا فن یا علم، وہ اصول و ضوابط جن میں سروں کی ترکیب اور ان کے اوقات و موسم سے بحث کی جاتی ہے، گاین ودیا، گانا بجانا۔ادائیگی: { مُو + سی + قی + اِم + تِداد }
 (طبیعات) سر یا آواز اور زیرو بم کی شدت جس کا انحصار ان ارتعاشات کی اضافی سرعت پر ہوتا ہے جن سے یہ زیرو بم پیدا ہوتا ہے۔ (Concrete Pitch)۔ادائیگی: { مُو + سی + قی + اَو (و لین) + سَط }
 (طبعیات) دو انتہاؤں کے درمیان قدر کا ہم آہنگ اوسط (Harmonick Mean)۔ادائیگی: { مُو + سی + قی + بُعْد }
 (طبیعات) دوسروں کا درمیانی وقفہ یا فاصلہ جو ارتعاشوں کے تعددّوں کی نسبت سے کم یا زیادہ ہوتا ہے۔ادائیگی: { مُو + سی + قی + دان }
 موسیقی کا علم رکھنے والا، موسیقی جاننے اور سمجھنے والا شخص ماہر موسیقی، موسیقار۔ادائیگی: { مُو + سی + قی + دا + نی }
 موسیقی دان کا کام یا منصب، موسیقی کے بارے میں واقفیت اور مہارت، موسیقی جاننا۔ادائیگی: { مُو + سی + قی + رُمُوز }
 موسیقی کے رموز، موسیقی کے اصول، موسیقیائی باریکیاں۔ادائیگی: { مُو + سی + قی + سَب + تَک }
 (طبیعات) مقررہ وقفے کے بعد اُٹھتے یا گرتے سُروں کا ایک مخصوص درجے دار سلسلہ یا پیمانہ، سرگم (Musical Scale)۔ادائیگی: { مُو + سی + قی + مَح + وِیَنی + اِم + تِحان }
 (نفسیات) وہ امتحان جس میں موسیقی سن کر معمول اپنے ذہن میں عجوبۂ خیالی کو پروان چڑھنے دیتا ہے اور بعد میں اسے اختیار کنندہ کی اطلاع کے لیے بیان کرتا ہے (Musical Reverie Test)۔ادائیگی: { مُو + سی + قی + نِس + بَت }
 (ہندسہ) دو قدروں یا اعداد کے درمیان ہم آہنگ نسبت (Musical Ratio)۔ادائیگی: { مُو + سی + قی + نَوا + زی }
 (موسیقی) موسیقی کی قدر و منزلت کرنا، موسیقی کو فروغ دینا۔ادائیگی: { مُو + سی + قی + نِگار }
 (موسیقی) موسیقی ترتیب دینے والا، موسیقی کے اشارات مرتب کرنے والا، موسیقار۔ادائیگی: { مُو + سی + قی + گَری }
 (موسیقی) دُھن بنانے کا عمل، موسیقی ترتیب دینا، موسیقار کا کام یا منصب۔ادائیگی: { مُو + سی + قی + گھَر }
 (موسیقی) وہ جگہ جہاں گانے بجانے کی محفلیں منعقد ہوتی ہوں یا کوئی گانے والا یا کئی گانے والے یا سازندے وغیرہ اپنے فن کا مظاہرہ کرتے ہوں، سرودخانہ۔ادائیگی: { مُو + سی + قِیا + نا }
 موسیقی میں ڈھالنا، موسیقی کے اصول کے مطابق تریب دینا۔ادائیگی: { مُو + سی + قیْ + یَت }
 ترنم، سریلا پن۔ادائیگی: { مُو + سی + قِیَہ }
 موسیقی سے منسوب، گانے بجانے کا فن یا علم، موسیقی کا۔آلۂ مُوتراشی
ایک مشہور پیغمبر بنِ عمران کا نام جن پر کتاب توریت نازل ہوئی
سر مُونڈنے کا آلہ
اُسترہ، تابوت،ادائیگی: { مُو + سی + چَہ }
 ایک قسم کی چھوٹی سی چڑیا، ایک جنگلی کبوتر؛ فاختہ، قمری؛ ابابیل۔ادائیگی: { مُوش }
 چوہا؛ بانجر (جوار مکئی وغیرہ کے باریک؛ زردانہ)ادائیگی: { مُو + شے + بِیش }
 ایک چوہا جو بیش (ایک زہریلے پودے) میں رہتا ہے اور اسے کھانا جبکہ دوسرے جانور اس پودے کے پھولوں کی بو سے مر جات ہیں۔ادائیگی: { مُو + شے + خار + دار }
 (حیوانیات) ایک چوہا جس کے جسم پر بالوں کی بجائے سیہ کے سے کانٹے ہوتے ہیں۔ادائیگی: { مُو + شے + خان + گی }
 آبادی یا مکانوں میں رہنے والا چوہا، گھریلو چوہا (موشِ دشتی کے مقابل)۔ادائیگی: { مُوش + خا + نَہ }
 چوہوں کا گھر، چوہوں کا بل۔ادائیگی: { مُوش + خار (و معدولہ) }
 سفید سر اور باقی سُرخ گیروا جسم کا چیل سے قدرے چھوٹا اور اس سے مشابہ ایک شکاری صحرائی پرندہ جو عموماً کھیتوں پر چوہے پکڑنے کے لیے منڈلاتا ہے۔ادائیگی: { مُوش + دان }
 چوہے پکڑنے کا پنجرہ نما آلہ، چوہے دان (پلیٹس)۔ادائیگی: { مُو + شے + دَش + تی }
 افریقہ کے صحرا کے خرگوش کی قسم کا ایک جانور، جنگلی چوہا، صحرائی چوہا (Jerboa)۔ادائیگی: { مُو + شے + دَن + دان }
 (خطاطی) حاشیے کی وہ بیل جسکے خطوط کے درمیان فاصلہ ہو، لہریا۔ادائیگی: { مُو + شے + دُو + پا + او (و مجہول) }
 صحرائی چوہے کی ایک قسم جسکی اگلی ٹانگیں بہت چھوٹی اور پچھلی ٹانگیں بہت ہی لمبی ہوتی ہیں جنکی انگلیوں کے نیچے گھنے بالوں کی کنگھی سی ہوتی ہے، رنگ اس کا بھورا خاکی ہوتا ہے گھاس اور جھاڑیاں کھاتا ہے۔ادائیگی: { مُو + شے + صَح (فتحہ ص مجہول) + را + ای }
 مُوشِ دشتی، جنگلی چوہا۔ادائیگی: { مُوش + نَژاد }
 چوہے کی نسل کا؛ (مجازاً) ضرر رساں (بطور دشنام مستعمل)۔ادائیگی: { مُوش + ٹِڈ + ڈی }
 چھچھوندر سے مشابہ ٹڈی کی ایک قسم جو زمین میں بل بنا کر رہتی ہے (Molecricket)۔ادائیگی: { مُوش + کُشی }
 چوہوں کو مارنا (عموماً وبائی امراض سے بچنے کے لیے)، چوہوا مار مہم چلانا۔ادائیگی: { مُو + شے + کور (و مجہول) }
 چھچھوندر۔ادائیگی: { مُو + شے + کو (و مجہول) + ہی }
 پہاڑی چوہا۔ادائیگی: { مُوش + گِیر }
 مُوش خوار۔ادائیگی: { مُو + شا }
 مُوش نیز موشکا، چوہا۔ادائیگی: { مُو + شِت }
 چرایا ہوا، ڈاکے یا دھوکے سے ٹھگا ہوا۔ادائیگی: { مُوَش + شَح }
 آراستہ، مزین، زیور یا نقش و نگار سے سجایا ہوا۔ادائیگی: { مُوَش + شَحات }
 (بلاغت) وہ کلام جس میں صنعت ترشیح برتی جائے۔ادائیگی: { مُو + شَن }
 چوری کرنا؛ ڈاکہ ڈالنا، لوٹنا۔ادائیگی: { مو (و مجہول) + شَن + پِک + چَر }
 متحرک تصویر، فلم جو سینما وغیرہ میں دکھائی جاتی ہے۔ادائیگی: { مو (و مجہول) + شَن }
 جُنبش، حرکت، حرکات اور اشارہ؛ بھاؤ، نرت، انداز؛ رقص (تراکیب میں مستعمل)۔ادائیگی: { مو (و مجہول) + شَن }
 اجابت (انگریزی اردو لغت، مولوی عبدالحق)۔ادائیگی: { مو (و مجہول) + شَن }
 (جلسے وغیرہ میں) تحریک، تجویز، کسی پارلیمانی مجلس کے کسی رکن کی کسی خاص اقدام کے کیے جانے سے متعلق تجویز۔ادائیگی: { مو (و مجہول) + شَن }
 (جلسے وغیرہ میں) تحریک، تجویز، کسی پارلیمانی مجلس کے کسی رکن کی کسی خاص اقدام کے کیے جانے سے متعلق تجویز۔ادائیگی: { مُو + شُو + یَہ }
 بالوں کو دھونا، بالوں کا غسل۔ادائیگی: { مُو + شَک }
 چمگادڑ، گلہری؛ چوہا، چور۔ادائیگی: { مبو + شَک + دَوا + نی }
 (کنایۃً) فتنہ انگیزی جو خلاف توقع ہو، ریشہ دوانی۔ادائیگی: { مَو + شَکے + پَر (ا ل) }
 چمگادڑ، گلہری۔ادائیگی: { مُو + شَکے + چا + لاک }
 کیڑے کھانے والا ایک جانور جو عام چوہے سے مشابہ ہوتا ہے مگر ناک بہت لمبی اور تیز ہوتی ہے۔ادائیگی: { مُو + شَکے + کور (و مجہول) }
 مراد: چھچھوندر۔ادائیگی: { مُو + شِکا }
 چوہیا، چور عورت، کٹھالی۔ادائیگی: { موش (و مجہول) + کا + نِیَہ }
 یہود کا ایک فرقہ۔ادائیگی: { مُو + شِگاف }
 باریک بیں، نکتہ رس، بال کی کھال کھینچنے والا۔ادائیگی: { مُو + شِگا + فا + نَہ }
 باریک بینی کا، نکتہ چینی کا۔ادائیگی: { مُو + شِگا + فی }
 نکتہ چینی، باریک بینی۔تقسیم بالادائیگی: { مُوَش + شَہ }
 رنگین (کپڑا)؛ (مجازاً) کپڑے کے نقش و نگار یا رنگین نقش و نگار والے کپڑے۔موش صحرائی کے رنگ کا گھوڑا جو منحوس مانا گیا ہےپہنچانے والا
پہنچایا ہوا
حاصل کیا ہوا (وَصَّلَ۔ پہنچانا)
حامل (اَوصَلَ ۔ پہنچانا ، وَصَل ۔ ملنا)
لے جانے والا
ملایا ہوا
ربائندہ، رسائندہ، ملاؤ، کنڈکٹر،ادائیگی: { مُوص + لی + جَڑ }
 پورے کا وہ حصہ جو زمین سے اوپر رہے اور اسے جڑ سے ممّیز کرے۔ادائیگی: { مُوص + لِیَت }
 ایصالیت، ناقلیت، حرارت، برق یا آواز کے انتقال یا ترسیل کی طاقت یا صفت؛ ایصال کرنے کی صلاحیت۔(مجازاً) مذکور
تعریف کردہ
تعریف کیا گیا
نام زدہ
وصف کردہ
وصف کیا گیا
وہ جس کی تعریف کی جائے
وہ شخص جس کی تعریف کی گئی ہو
مذبُور، مذکور، مسمَّی، معرف، ممدوح، ممدُوح، موسوم،ادائیگی: { مَو (و لین) + صُو + فُذ (ا، ل غیر ملفوظ) + ذِکْر }
 جس کا اوپر یا پہلے ذکر کیا گیا، متذکرہ۔ادائیگی: { مَو (و لین) + صُو + فُص (ا ل غیر ملفوظ) + صَدْر }
 جس کا ذکر درمیان میں آچکا ہے، مذکورہ الصدر۔ادائیگی: { مَو (و لین) + صُوف + اِلَیہ (ی لین) }
 جسکی طرف اشارہ کیا گیا، جو پہلے مذکور ہوا (فرہنگ آصفیہ) (شخص) جسکی تعریف کی گئی۔ (مہذب اللغات)۔ادائیگی: { مَو (و لین) + صُو + فَہ }
 جسکا ذکر کسی صفت کی بناء پر کیا گیا ہو نیز وصف رکھنے والی: مراد: صاحبہ (نام لیے بغیر)۔ادائیگی: { مَو (و لین) + صُو + فِین }
 وہ اشخاص جن کا ذکر تعریف کے لیے گیا گیا ہو نیز صفات والے (لوگ)۔ادائیگی: { مَو (و لین) + صُول }
 [ قواعد ] وہ اسم ناتمام جو اکیلا کسی جملے میں معنی نہیں دیتا اس کا صلہ اس کے بعد آتا ہے جیسے جو، جس، جن وغیرہ، جملۂ خبریہ کا وہ ٹکڑا جو صلے کے ساتھ مل کر بنتا ہے۔
 وصل کیا گیا، جسے ملایا جائے، ملایا ہوا، جڑا ہوا۔
 وہ حدیث جس کا سلسلہ بیچ سے منقطع نہ ہو۔ادائیگی: { مَو (و لین) + صُول + شُدَہ }
 وصول کیا ہوا، پایا ہوا، حاصل کردہ۔ترکہ پانے والا
موہوب الیہ
وصیت دارادائیگی: { مُو + صی }
 (فقہ) وصیت کرنے والا، مرنے سے پہلے یہ کہنے والا کہ میری وفات کے بعد ایسا کرنا۔وہ شخص جسے کہا ہو کہ میرے مرنے کے بعد یُوں کرناادائیگی: { مُو + صا (ا بشکل ی) + بِہا (کسرہ ب خفیفہ) }
 وہ (اشیا) جن کی بابت وصیت کی جائے؛ ہبہ کی ہوئیں | کئے ہوئے۔ادائیگی: { مُو + صا (ا بشکل ی) + لَہُو }
 جسکے حق میں وصیت کی گئی ہو۔ادائیگی: { مُو + صا (ا بشکل ی) + لَہا }
 وہ عورت جس کے حق میں وصیت کی گئی ہو۔ادائیگی: { مُو + صا (ا بشکل ی) + لَہُم }
 (وہ اشخاص یا لوگ) جن کے حق میں وصیت کی گئی ہو۔ادائیگی: { مُو + صِیَہ }
 (فقہ) وصیت کرنے والی عورت، مرتے وقت یہ کہنے والی عورت کہ میری وفات کے بعد ایسا کیا جائے۔ادائیگی: { مُو + ضِح }
 واضح اور روشن کرنے والا، کسی پیچیدہ بات کی وضاحت کرنے والا، تشریح کرنے والا۔ادائیگی: { مُو + ضِحے + مُد + دَعا }
 مدعا واضح کرنے والا، بات کی وضاحت کرنے والا۔ادائیگی: { مُو + ضِحَہ }
 (جراحت) وہ جراحت یا زخم جس سے جلد پھٹ کر نیچے سے ہڈی دکھائی دیتی ہے۔ادائیگی: { مَو (و لین) + ضَع }
 کسی شے کے رکھنے کی جگہ؛ (مجازاً) مقام، محل، موقع؛ گاؤں، دیہات، ضلع؛ (تجوید) قرات میں الفاظ کی ادائیگی کے مقامات۔ادائیگی: { مَو (و لین) + ضَعے + آ + ہَنی }
 آہنی چٹان، لوہے جیسی سخت زمین، لوہے کا بنا ہوا مقام۔دہ دار
گاؤں گاؤں
گاؤں کی ترتیب سے
نمبردار،ادائیگی: { مَو (و لین) + ضَعے + طَب + عی }
 طبعی مقام، فطری یا خلقی یا قدرتی جگہ۔ادائیگی: { مَو (و لین) + ضَعے + مَخ + صُوص }
 (علم تشریح) جسم کا کوئی خاص حصہ یا خاص عضو۔ادائیگی: { مَو (و لین) + ضَعے (فتحہ ض مجہول) + مَق + طَعَہ }
 (کاشتکاری) مقام قطع اراضی، وہ جگہ جہاں قطعہ اراضی ہو۔ادائیگی: { مَو (و لین) + ضَعے (فتحہ ض مجہول) + مَک + رُوہ }
 (کنایۃً) مکروہ مقام؛ (فقہ) دبر، کونادائیگی: { مَو (و لین) + ضَع (فتحہ ض مجہول) + نِگا + ری }
 کسی جگہ یا خطے کی نقشہ سازی؛ (تشریحات) اعضائے بدن کی نقشہ سازی۔ادائیگی: { مَو (و لین) + ضَع (فتحہ ض مجہول) + وار }
 (کاشتکاری) گاؤں کی ترتیب سے، دیہات کی ترتیب کے موافق، حسبِ شمار، گاؤں گاؤں۔ادائیگی: { مَو (و لین) + ضَعی }
 مقامی؛ وقتی، محض ایک مقام تک محدود۔ادائیگی: { مَو (و لین) + ضُوع }
 وضع کردہ، وضع کیا گیا، مراداً: (کسی امر کے لیے) بنا ہوا، ٹھہرایا ہوا۔
 [ حدیث ] گھڑی ہوئی حدیث، جھوٹی حدیث۔
 جعلی، بناوٹی، گھڑی ہوئی بات، دل سے بنایا ہوا قصہ۔
 اصل مقصود جس سے کسی علم پر بحث کی جائے، وہ شے جس کا ذکر اس علم میں ہو، وہ علم جس میں کسی علم کے عوارض ذاتیہ سے بحث کی جائے، مقصد کلام، مضمون، بحث، مدعا، (ادب) کسی نثر یا نظم میں بحث و بیان کا مرکزی خیال۔
 [ منطق ] وہ مبدا یا خبر جس کے بارے میں اقرار یا انکار کیا گیا ہو، محکوم الیہ۔
 [ اقلیدس ] وہ اصول جو علم ہندسہ میں بالاتفاق مسلم ہیں۔
 [ فلسفہ ] وہ شے جس میں کوئی صورت جوہر یہ حلول کر سکے، ہیولٰی کا ایک نام۔
 [ لسانیات۔ ] اردو کا وہ لفظ جو معنے کے لیے عربی قاعدے سے بنایا گیا ہو، بامعنی لفظ، کسی فقرے میں موجود وہ لفظ یا مجموعہ الفاظ جس کے ذریعے کسی کام کا ہونا یا کرنا پایا جائے۔ادائیگی: { مَو (و لین) + ضُو + عے + اَع + ظَم }
 اہم موضوع، خاص بحث۔ادائیگی: { مَو (و لین) + ضُو + عے + بَحْث (فتحہ خفیفہ ب) }
 بحث و مباحث کا مضمون، بحث کا موضوع، زیر بحث امر۔ادائیگی: { مَو (و لین) + ضُو + عے + سُخَن }
 کسی بات کا موضوع، وہ مسئلہ یا امر یا بیان جس پر بحث مطلوب ہو۔ادائیگی: { مَو (و لین) + ضُوع + لَہُو }
 جسکی بحث اور بیان کے لیے کوئی علم وضع ہوا ہو جو لفظ جس بات کے لیے بنایا گیا ہو جسکا علم کسی موضوع سے ہو جائے مثلاً چاقو موضوع ہے اور دستہ اور پھل موضوع لہُ ہیں۔ادائیگی: { مَو (و لین) + ضُوع + وار }
 بلحاظِ موضوع، مضمون کے اعتبار سے، موضوعاتی طور پر۔ادائیگی: { مَو (و لین) + ضُو + عے + کَلام }
 موضوع بیان۔ادائیگی: { مَو (و لین) + ضُو + عے + گُف + تَگُو }
 گفتگو کا موضوع، بحث کا عنوان، وہ چیز جس پر بحث کی جائے۔ادائیگی: { مَو (و لین) + ضُو + عات }
 موضوع کی جمع، بیانات، عنوانات، جھوٹی روایتیں یا حدیثیں۔ادائیگی: { مَو (و لین) + ضُو + عا + تی }
 کسی موضوع سے متعلق یا منسوب، موضوع کا۔ادائیگی: { مَو (و لین) + ضُو + عا + تی + شا + عِری }
 وہ شاعری جو کسی خاص عنوان یا موضوع کے تحت کی جائے۔ادائیگی: { مَو (و لین) + ضُو + عَہ }
 وضع کیا ہوا، مقرر کیا ہوا، بنایا ہوا۔ادائیگی: { مَو (و لین) + ضُو + عی }
 وہ جس کا تعلق سوچ سے ہو، داخلی، باطنی، روحانی، مصنوعی، فرضی، خیالی؛ موضوع سے منسوب یا متعلق، کسی موضوع یا عنوان کا۔ادائیگی: { مَو (و لین) + ضُو + عی + اِن + دِراج }
 (کتب خانہ) کیٹلاگ یا کتابیات میں اس فن کے تحت اندراج جو اس مندرج تصنیف کے موضوع کو ظاہر کرے۔ادائیگی: { مَو (و لین) + ضُو + عی + حَوا + لَہ }
 (کتب خانہ) ایک لفظ یا زائد الفاظ جو کتاب کے موضوع کو ظاہر کریں اور بطور سرخی جس کے تحت کیٹلاگ یا کتابیات میں ایک ہی موضوع سے متعلق تمام کتابوں کا اندراج کیا جائے۔ادائیگی: { مَو (و لین) + ضُو + عی + کارْڈ }
 (کتب خانہ) کیٹلاگ کا وہ کارڈ جس میں کارڈ کے اوپر عمودی پہلی لکیر میں کتاب کا موضوع درج ہو اور پھر مصنف کارڈ کے اندراجات نقل کر دئیے جائیں۔ادائیگی: { مَو (و لین) + ضُو + عی + کِتا + بِیات }
 (کتب خانہ) کسی موضوع پر شائع شدہ کتابوں کا اشاریہ یا فہرست۔ادائیگی: { مَو (و لین) + ضُو + عیْ + کَے (ی لین) + فی + یَت }
 طے شدہ، وضع کی ہوئی، رکھی ہوئی حالت۔ادائیگی: { مَو (و لین) + ضُو + عی + کَیٹ (ی لین) + لاگ }
 (کتب خانہ) وہ کیٹلاگ یا اشاریہ جو صرف موضوعی اندراجات پر مشتعمل ہو یا جو موضوعات کے حساب سے ترتیب دیا گیا ہو۔ادائیگی: { مَو (و لین) + ضُو + عی + یَت }
 مواد کا محض مصنف کی ذات، جذبات، خیالات اور احساسات اور عقائد و نظریات پر مبنی ہونا (معروضیت کے برعکس)، داخلیت، تاثراتی انداز۔ادائیگی: { مَو (و لین) + ضُو + عی + یَت + پَسَن + دی }
 داخلیت یا تاثراتی انداز کو پسند کرنا۔ادائیگی: { مَو (و لین) + طِن }
 وطن، رہنے کی جگہ، گھر، مکان، جنم بھومی، پیدائش کی جگہ۔ادائیگی: { مَو (و لین) + طُوہ }
 (فقہ) وطی کی ہوئی، جماع کی ہوئی، صحبت کی ہوئی (مورت)۔ادائیگی: { مُوَظ + ظِف }
 وظیفہ پڑھنے یا ادا کرنے والا، زبان سے بجا لانے والا۔ادائیگی: { مُوَظ + ظِفان }
 وظیفہ کرنے والے؛ (مجازاً) حمد و ثنا کرنے والے (پرندے)۔ادائیگی: { مَو (و لین) + عِد }
 وعدے کا وقت، وعدے کی جگہ؛ پیشین گوئی کرنا، آئندہ کے حالات بتانا؛ وعدہ کرنا نیز وعدہ (جامع اللغات)۔ادائیگی: { مَو (و لین) عِدَت }
 عہد و پیمان، اقرار، وعدہ (فیرہنگ آصفیہ ؛ جامع اللغات)ادائیگی: { مُو + عِظا + نَہ }
 پندو نصیحت سے پُر، واعظانہ، جس میں نصیحتیں بیان کی گئی ہوں۔ادائیگی: { مَو (و لین) + عِظَت }
 پند و نصیحت، تلقین؛ (مجازاً) وہ بیان یا تقریر جو مذہبی بحث یا اصلاح وغیرہ پر مبنی ہو، وعظ، اچھی باتوں کی ہدایت۔ادائیگی: { مَو (و لین) + عِظَت + با + زی }
 نصیحت کرنے کی عادت۔ادائیگی: { مَو (و لین) + عِظَتے + حَسَنَہ }
 اعلٰی درجے کے وعظ و نصیحت، اصلاح کی اچھی باتیں (عموماً تبلیغ و دعوت کے لیے مستعمل)۔ادائیگی: { مَو (و لین) + عِظَتی }
 نصیحتی، پندو نصیحت سے متعلق۔ادائیگی: { مَو (و لین) + عِظَہ }
 پندو نصیحت کی باتیں۔ادائیگی: { مَو (و لین) + عِظَہ + اے + حَسَنَہ }
 اعلٰی درجے کے وعظ و نصیحت، اصطلاح کی اچھی باتیں (عموماً تبلیغ و دعوت کے لیے مستعمل)۔ادائیگی: { مَو (و لین) + عِظِین }
 پندونصیحت کرنے والا، اصلاح اور اچھی باتیں پھیلانے والے۔ادائیگی: { مَو (و لین) + عُود }
 وعدہ کیا گیا، جس کا وعدہ ہو، اقرار کردہ۔ادائیگی: { مَو (و لین) + عُو + دَہ }
 طے شدہ، مقرر، جسکا وعدہ کیا جائے۔ادائیگی: { مَو + غَنی }
 ایک آلۂ موسیقی؛ عود کی ایک قسم۔ادا کیا گیا
پورا کرنا
پورا کیا گیا
موفّیٰ کا ایک اردو املا
مکمل کیا گیا
پورا، مکمل، وفا، کامل،ادائیگی: { مُوَف + فِر }
 زیادہ وصول کرنے والا، گراں فروش۔ادائیگی: { مُو + فِشاں }
 بال بکرائے ہوئے، جس کے بال بکھرے ہوئے ہوں، بکھرائے ہوئے۔ادائیگی: { مُوَف + فِق }
 توقیق دیا گیا، نیک کام کرنے کا سامان دیا گیا، مدد دیا گیا، برکت دیا گیا، جسے کے واسطے خدا تعالٰے اچھے کاموں کا سامان مہیا کر دیا ہو۔ادائیگی: { مَو (و لین) + فُور }
 وافر کیا گیا، زیادتی کیا گیا نیز پورا، مکمل (جامع اللغات)؛ بکثرت، باافراط، بہت زیادہ، وافر۔ادائیگی: { مَو (و لین) + فُو + رَہ }
 کثیر، بہت زیادہ، وافر۔ادائیگی: { مُوق }
 آنکھ کا ناک سے متصل گوشہ، آنکھ کا بایاں کویا؛ (طب) آنکھ کا اندرونی کویا، لحاظ کا مقابل (Canthus)۔ادائیگی: { مُوَق + قَت }
 وقت کا حساب یا تعین کرنے والا، قدیم زمائے میں مسجدوں میں قبلے کا رُخ اور نماز کے اوقات کا تعین کرنے والا۔ادائیگی: { مُوَق + قِتے + اَع + لا (الف بشکل ی) }
 نماز کے اوقات مقرر کرنے والا بڑا عہدے دار، معدل۔ادائیگی: { مُوَق + قَتش (ا، ل غیر ملفوظ) + شُیُوع }
 (صحافت) وقتِ مقررہ پر شائع ہونے والا رسالہ یا اخبار وغیرہ، مقررہ وقفے کے بعد شائع ہونے والا (رسالہ یا اخبار وغیرہ)۔ادائیگی: { مُوَق + قَت + اَم + را + ضے + وَبا + ای }
 وہ وَبائی امراض جو خاص وقت اور خاص موسم میں پھوٹ پڑتے ہیں۔باقاعدگی سے شائع
ہفتہ وار
آودک، دوری,میعادی، فصلی، گردشی، مقرری، موسمی، نوبتی،ادائیگی: { مُوَق + قَت + با + زار }
 وقتی یا عارضی طور پر لگائے جانے والے بازار، پینٹھ، بچت بازار، نوبتی بازار۔ادائیگی: { مُوَق + قَت + رِسا + لَہ }
 وقتِ مقررہ پر شائع ہونے والا رسالہ: جیسے ہفتہ وار، پندرہ روزہ، ماہانہ، سہ ماہی وغیرہ، معیادی رسالہ۔ادائیگی: { مُوَق + قَت + قا + بِض }
 (قانون) معیاری یا حین جاتی پٹّہ دار یا لگان دار (اراضی دار)۔ادائیگی: { مُوَق + قَت + لَگان }
 (کاشتکاری) مقررہ لگان، وہ لگان جو طے ہوا ہو۔ادائیگی: { مُوَق + قَتَہ }
 مقررہ وقت کا، نوبتی، عارضی۔ادائیگی: { مُوَق + قَتی }
 وقت کے مطابق، وقتی، معیادی، عارضی (دائمی کے مقابل)۔ادائیگی: { مُوَق + قَتی + جا + اے + داد }
 (قانون) ایسی جائداد جو مستقل اور واپس نہ ہو بلکہ ایک وقتِ معین کے بعد اس کا منتقل ہو جانا لازم ہو (کشاف قانونی اصطلاحات)۔ادائیگی: { مَو (و لین) + قِذ }
 (طب) بدن کے اطراف جیسے ہاتھ، پاؤں، ٹخنا، گھٹنا، کندھا وغیرہ۔ادائیگی: { مُو + قَر }
 لدا ہوا، بوجھ اٹھانے والا؛ حاملہ (عورت)، دبا ہوا؛ (مجازاً) مظلوم؛ غریب کیا گیا؛ مفلس بنایا گیا۔ادائیگی: { مَو (و لین) + قَع }
 مقام، جگہ، محل، (مجازاً) راستہ۔
 (کسی امر کے) واقع ہو جانے کی جگہ، جائے وقوع۔
 [ قواعد ] محل استعمال
 (کسی کام یا چیز کے لیے) مناسب وقت، محل موزوں، خاص وقت، خاص مقام۔
 جائے مخصوصہ، فرج۔ادائیگی: { مَو (و لین) + قَع + بَمَو (و لین) + قَع }
 مختلف موقعوں پر، وقتاً فوقتاً، کبھی کبھی، گاہے گاہے؛ وقفے وقفے سے، موقع محل سے۔ادائیگی: { مَو (و لین) + قَع + بے + مَو (و لین) + قَع }
 خلاف محل، نامناسب وقت پر، ہر وقت جامعے موقع ہو نہ ہو، وقت بے وقت۔ادائیگی: { مَو (و لین) + قَع + دیکھ (ی مجہول) + کَر }
 مناسب وقت پر، موزوں حالات اور وقت پر۔داؤں گھات میں رہنا
وقت دیکھنا
وقت کا منتظر رہناادائیگی: { مَو (و لین) + قَع + سے }
 وقت کے موافق، وقت دیکھ کر، وقت سے، وقت مناسب پر، ڈھنگ کے ساتھ، اتفاقاً، اچانک۔ادائیگی: { مَو (و لین) + قَع + شَناس }
 کسی کام کے لیے موزوں اور مناسب وقت پر فیصلہ کرنے والا۔ادائیگی: { مَو (و لین) + قَع + شَنا + سی }
 یہ پہچاننا اور تاڑ ناکہ کام کے لیے کون سا وقت اور محل موزوں ہے اور کون سا ناموزوں۔ادائیگی: { مَو (و لین) + قَع + مَحَل }
 مناسب وقت اور مناسب جگہ، وقت کی نزاکت۔داؤں پر چڑھنا
گھات پر چڑھنا
مناسب وقت ہاتھ لگنا
مہلت ملنا
مُہلت ملنا
وقت ملناادائیگی: { مَو (و لین) + قَع + مَو (و لین) + قَع + سے }
 وقتاً فوقتاً، مناسب اوقات میں، وقت دیکھ کر۔ادائیگی: { مَو (و لین) + قَع + میں (ی مجہول) }
 موقع پر، وقت پر۔ادائیگی: { مَو (و لین) + قَعے + وار + دات }
 وہ جگہ جہاں کوئی جُرم واقع ہوا ہو، حادثہ ہونے کی جگہ۔ادائیگی: { مَو (و لین) + قَع + پا + کَر }
 موقع دیکھ کر، موقعے سے فائدہ اٹھا کر۔ادائیگی: { مَو (و لین) + قَع + پَر }
 خاص مقام پر، محل وقوع پر؛ مناسب وقت پر خاص وقت پر۔ادائیگی: { مَو (و لین) + قَع + پَرَسْت }
 مناسب وقت دیکھ کر کام کرنے والا، مفاد پرست۔ادائیگی: { مَو (و لین) + قَع + پَرَس + تا + نَہ }
 موقع پرستوں کی طرف، مفاد پرستانہ، خود غرضانہ۔ادائیگی: { مَو (و لین) + قَع + پَرَس + تی }
 موقعے سے فائدہ اٹھانا، مفاد سے مطلب رکھنا۔ادائیگی: { مَو (و لین) + قَع + کا }
 مناسب، حسبِ دلخواہ، جو وقت پر مناسبِ حال ہو، اچھے محل وقُوع کا (مکان)۔ادائیگی: { مَو (و لین) + قَع + کی }
 لائق، مناسب، حسب منشا، ڈھنگ کی۔ادائیگی: { مَو (و لین) + قَعَہ }
 موقع (جو اس کا درست املا ہے)، مقام، جگہ، مَحَل؛ (مجازاً) راستہ۔ادائیگی: { مَو (و لین) + قَعیْ + یَت }
 صورتِ حال نیز کہانی یا ڈرامے کا کوئی موقع یا مقام۔ادائیگی: { مَو (و لین) + قِف }
 کھڑے ہونے کی جگہ، مقام؛ (مجازاً) نقطۂ نظر، زاویۂ نگاہ، انداز فکر؛ (فقہ) وہ مقام جہاں حج کے دنوں میں موقوف کرنا یعنی ٹھہرنا لازمی ہوتا ہے یعنی مزدلفہ اور عرفات؛ وہ مقام جہاں قیامت کے دن لوگوں کوجمع کیا جائے گا۔ادائیگی: { مَو (و لین) + قِفے + فَر + یاد }
 مقام فریاد، فریاد کرنے کی جگہ؛ (کنایۃً) میدان حشر۔ادائیگی: { مَو (و لین) + قِفَین (ی لین) }
 (فقہ) عرفات اور مزدلفہ دو مقام جہاں حج کے دنوں میں قیام لازمی ہوتا ہے؛ مواقف۔ادائیگی: { مُو + قِن }
 یقین کرنے والا (عموماً استدلال کے بعد)۔ادائیگی: { مُو + قِنِین }
 (فقہ) دینی امور پر کامل یقین رکھنے والے۔ادائیگی: { مَو (و لین) + قُوت }
 جس کا وقت مقرر ہو، وقت مقررہ تک ٹھہرایا ہوا۔ادائیگی: { مَو (و لین) + قُوذ }
 ناجائز طریقے سے مارا ہوا، جسے بہت زیادہ ضرب لگائی جائے، سخت چوٹ کھایا ہوا۔ادائیگی: { مَو (و لین) + قُو + ذَہ }
 مُردہ، لکڑی سے مارا ہوا؛ (فقہ) پتھر یا لکڑی سے ہلاک کردہ جانور۔ادائیگی: { مو (و مجہول) + قُوص }
 (لفظاً) ٹوٹا ہوا؛ (عروض) وہ رکن جس کا حرف ثانی متحرک گرا دیا گیا ہو۔ادائیگی: { مَو (و لین) + قُو + عَہ }
 جو کسی جگہ واقع ہو، (کسی شے کی جائے وقوع کے تعارف میں مستعمل)۔ادائیگی: { مَو (و لین) + قُوف }
 ٹھہرایا، کھڑا کیا گیا۔ (جامع اللغات)
 ملتوی کیا گیا، منسوخ کیا گیا، عارضی یا مستقل طور پر ترک یا منسوخ۔
 ملازمت سے برطرف یا برخاست کیا ہوا، معطل کیا ہوا۔
 ملکیت سے خارج کرکے خدا کے نام پر کارخیر کے لیے چھوڑا ہوا (مال یا جائیداد)، وقف کیا گیا۔"
 [ مجازا ] منحصر، مبنی، انحصار کیا گیا۔
 جسکی حد بندی کی گئی ہو، مقرر، معین، محدود۔
 [ حدیث ] وہ حدیث جسکا سلسلہ صحابی تک پہنچے۔
 [ قواعد ] حرف ساکن جسکا ماقبل بھی ساکن ہو؛ جیسے دوست اور گوشت میں |ت|
 [ قالت ] وہ بچہ جسکا سر وقتِ ولادت حرکت کرکے رُک جائے۔ (ماخوذ: مخزن الجواہر)ادائیگی: { مَو (و لین) + قُو + فُل (ا غیر ملفوظ) + آ + خِر }
 (شاعری) حضرت امیر خسرو کی ایجاد کردہ صنعت شاعری جس کا ہر قافیہ دوسرے مصرعے کے آغاز کا محتاج رہتا ہے۔ادائیگی: { مَو (و لین) + قُوف + اِلَیہ (ی لین) }
 جسکے لیے وقف کیا گیا ہو، وقف کی آمدنی کا لینے والا؛ (مجازاً) متولی (فرہنگ آصفیہ)۔ملتوی رکھنا
