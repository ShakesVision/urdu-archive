 مگر کی نسل کا ایک بڑا دریائی جانور، مگرمچھ۔ادائیگی: { نا + کا + بَن + دی }
 ناکا روکنے کا عمل، دروازے یا گزرگاہ سے آمد و رفت کی بندش، آنے جانے کی روک، (مجازاً) پابندی؛ چنگی یا محصول کے واسطے جگہ جگہ چوکی بِٹھانا۔ادائیگی: { نا + کا + دار }
 ناکے دار، وہ (سوئی) جس میں ناکام ہو؛ تعلقہ دار نیز محرر، محصول جو گزرگاہوں پر رہتا ہے۔ادائیگی: { نا + کار + آ + مَد }
 کام میں نہ آنے والا، استعمال نہ ہو سکنے والا، بیکار، ردی۔ادائیگی: { نا + کا + را }
 جو کام نہ کر سکے، نکما، کاہل، سست۔ادائیگی: { نا + کار + گَر }
 جو کارآمد نہ ہو، کام نہ آنے والا، غیر موثر نیز بے کار، بے فائدہ۔ادائیگی: { نا + کار + گی }
 ناکارہ ہونے کی حالت، کاہلی، سستی۔ادائیگی: { نا + کا + رَہ }
 غیر کارآمد، بے کار، خراب۔ادائیگی: { نا + کا + رَہ + پَن }
 بے معرفی، ناکارہ ہونے کی کیفیت یا حالت، بے وقعتی۔ادائیگی: { نا + کا + ری }
 خراب، بیکار، لغو۔ادائیگی: { نا + کاس + تَہ }
 جسے گھٹایا نہ گیا ہو، جو کم نہ ہوا ہو، (مجازاً) جو خرچ نہ ہوا ہو (خزانے کے لیے مستعمل)۔ادائیگی: { نا + کاش + تَہ }
 جو کاشت کے قابل نہ ہو، بنجر، اجاڑ (زمین)، (مجازاً) بانجھ (عورت)۔ادائیگی: { نا + کا + فی }
 جو کافی نہ ہو، جو حسب ضرورت نہ ہو، جو کنایت نہ کرے۔ادائیگی: { نا + کا + فی + یَت }
 ناکافی ہونے کی حالت، کافی نہ ہونے کی کیفیت۔ادائیگی: { نا + کام }
 جس کا مقصد پورا نہ ہوا ہو، محروم، نامراد، ناکامیاب، ناکامران۔ادائیگی: { نا + کام + گار }
 ناکام، نامراد۔ادائیگی: { نا + کا + مِل }
 نامکمل، ادھورا۔ادائیگی: { نا + کا + می }
 محرومی، ناکامیابی، نامرادی۔ادائیگی: { نا + کام + یاب }
 کامیابی سے محروم، ناکام، بے مراد، نا امید، مایوس۔ادائیگی: { نا + کام + یا + بی }
 امتحان میں فیل ہونا جانا، کسی کام کا حسب مراد نہ ہونا، کامیاب نہ ہونا۔ادائیگی: { نا + کَت + خُدا }
 بن بیاہا، کنوارا، کنواری، غیر شادی شدہ، مجرد۔ادائیگی: { نا + کَت + خُدا + ای }
 غیر شادی شدہ ہونے کی حالت، تجرد، کنوارا پن، بن بیاہا ہونے کی حالت۔بن بیاہا
بن بیاہی
جس کی شادی نہ ہوئی ہو
غیر شادی شدہ
غیر متاہل
چھڑا، دوشیزہ، مجرّد، کنوارا، کنواری،ادائیگی: { نا + کِح (کسرہ مجہول) }
 نکاح کرنے والا، وہ جس کا نکاح پڑھا جائے، بیاہ کرنے والا۔ادائیگی: { نا + کَدْ + خُدا }
 ناکتخدا جو زیادہ مستعمل ہے۔غیر شادی شدہ ریاست
کنوار پَن
بکارت، پاکدامني، خالِص، دوشيزگي، کنواريت، کوماری،ادائیگی: { نا + کَر + دَنی }
 نہ کرنے کے لائق (اصطلاحاً) جس کا کرنا اخلاقاً مناسب و موزوں اور قانوناً اور شرعاً جائز اور مباح نہ ہو۔ادائیگی: { نا + کَرْد + کا + ری }
 ناکردہ کاری، ناتجربہ کاری، اناڑی پن، کام سے ناواقفیت۔ادائیگی: { نا + کَرْ + دَہ }
 نہ کیا ہوا، نہ کیا گیا۔ادائیگی: { نا + کَرْ + دَہ + جُرْم }
 جس نے کوئی غلطی نہ کی ہو، بے قصور، بے گناہ، بے خطا نیز جرم جو نہ کیا ہو۔ادائیگی: { نا + کَر + دَہ + خَطا }
 ناکردہ جرم، بے قصور۔ادائیگی: { نا + کَر + دَہ + کار }
 جو آزمودہ کار نہ ہو، ناتجربہ کار، اناڑی، ناپختہ۔ادائیگی: { نا + کَر + دَہ + کا + ری }
 ناکردہ کار ہونے کی حالت : ناتجربہ کاری، اناڑی پن۔ادائیگی: { نا + کَر + دَہ + گُناہ }
 ناکردہ جرم۔ادائیگی: { نا + کَر + دَہ + گُنا + ہی }
 بے گناہی، گناہ نہ کرنے کی حالت۔ادائیگی: { نا + کَس }
 جس میں انسانیت نہ ہو، کمینہ، ذلیل، اوچھا، کم ظرف، غیر مہذبادائیگی: { نا + کَس + بی }
 بغیر سیکھا ہوا، جو سیکھا ہوا نہ ہو، اناڑی۔ادائیگی: { نا + کَسی }
 نالائقی، نا اہلی، ناقابلیت۔ادائیگی: { نا + کِش + تَہ }
 کاشت نہ کیا ہوا، غیر مزارعہ، بنجر، اجاڑ۔ادائیگی: { نا + کُشُو + دَنی }
 جو کھولا نہ جا سکے، جو حل نہ کیا جا سکے۔ادائیگی: { نا + کُشُو + دَہ }
 جو کھولا نہ گیا ہو، جو ظاہر نہ کیا گیا ہو، پوشیدہ، مخفی۔ادائیگی: { نا + کَشی + دَہ }
 جو کھینچا نہ گیا ہو، جو سر نہ ہوا ہو۔سرکنڈوں کی ایک بڑی قسم جس کے ڈنٹھل پتلے ‘ لمبے ‘ مضبوط اور بیچ سے کھوکھلے ہوتے ہیں مونڈھے اور رسّی وغیرہ بنانے میں کام آتے ہیں
بانسری، بھیڑ، سرکنڈا، مرلی،ادائیگی: { نا + کَنْد }
 وہ بچھڑا جس کے ابھی دودھ کے دانت موجود ہوں، (عموماً) دو سال کی عمر تک کا (گھوڑا) وہ جس پر ابھی سواری نہ کی گئی ہو۔ادائیگی: { نا + کنْد + بَچھ + ڑا }
 جو بچھڑا جس کے ابھی دودھ کے دانت موجود ہوں۔ادائیگی: { نا + کَنْد + بَچھ + ڑی }
 ناتجربہ کار، کمسن نیز دوشیزہ۔ادائیگی: { نا + کَنْد + بَچھے + ری }
 ناتجربہ کار، کمسن نیز دوشیزہ۔ادائیگی: { نا + کَن + دَہ }
 ناکندسنسار، گھڑیال، مگرمچھ، نکُوّ، نہنگ،ناک کی جمعمنہا منہ
لبالب، لبریز،بری ناک
بڑی ناک
بینئی کلان وسِطُبر
پکوڑا سی ناک
پکوڑاسی ناک
ناک کا ایک مرض جس میں ناک کے اندر زخم ہوجاتا ہے جس کا اگر بروقت علاج نہ کیا جائے تو مہلک ثابت ہوتا ہے
ناک کی پھنسیماتم پرسی
متوفی کے بال
تعزیت، سانپا،اخیر حد
پولیس اسٹیشن
پولیس چوکی
راستہ کی حد
رستہ کا انت
سُوئی کا چھید
محصول راہداری کا مقام
کانسٹیبل اور چوكیدار وغیرہ كے كھڑے رہنے كی جگہ
انتہا، انجام، پایاں، داخلہ، در، دربند، دروازہ، راستہ، راہ، روزن، سِرا، سرحد، سوزن، گُزرگاہ، گلی، مگرمچھ، مُہرا، ناکُو، نہایت، نہننگ،لوگوں کو کام پر جانے سے روکنا
میخ، کھونٹی، کیل،پورا پن
ناک سے منسوب
وقت مقررہ
ڈورے کی گھنڈی پھنسانے کا بنا ہوا حلقہ
اتمام، افراط، بہتات، بینی، پری، تِکمہ، تکمیل، چھینک، سیری، ناحق،بجائے ناکا حروف مغیرہ سے پہلے
ناکا کی جمعادائیگی: { ناگ }
 سانپ، سرپ، مار۔
 کالا سانپ، مارِ سیاہ، افعی (اسے ہندو مقدس سمجھتے ہیں) (انگریزی:Cobra)، (لاطینی:Olubernage)۔
 [ سالوتری ] وہ دونوں بھونریاں جو گھوڑے کی ایال کی جڑ میں ہوں
 [ معماری ] بنگڑی دار ڈاٹ کی ایک قوس، شروع کی قوس کو جو آنکڑے نما اور سانپ کے پھن سے مشابہ ہوتی ہے ناگ کہتے ہیں۔ (اصلاحاتِ پیشہ وراں، 106:1)
 آدمی کے بدن کی پانچ اہم ہواؤں میں سے ایک جو ڈکار کے وقت منہ سے نکلتی ہے۔ (پلیٹس، جامع اللغات)
 ہندو چوہڑوں کی ایک ذات۔ (جامع اللغات)
 امریکہ کے باشندے جنہیں پاتال لوک کے باشندے کہتے تھے۔ (فرہنگِ آصفیہ)
 کشیب منی کی زوجہ کدرویا سرسا کے بطن سے پیدا ہونے والی مخلوق جس کا چہرہ انسان کا سا ہوتا ہے، دُم سانپ کی سی ہوتی ہے اور جو پاتال میں رہتی ہے۔ (پلیٹس؛ فرہنگِ آصفیہ)
 ایک قوم جو سانپ کو پوجتی ہے۔
- ہاتھی، فیل، پیل، ہستی۔ (پلیٹس، فرہنگِ آصفیہ)
- پارے کے سات عیبوں میں سے ایک کا نام۔
- کسی قسم کی بہترین چیز؛ بادل؛ کئی پودوں کا نام۔ (جامع اللغات، پلیٹس)ادائیگی: { ناگ + با + نی }
 سانپوں کی زبان یا سانپ کے پجاریوں کی زبان، پراکرت کی ایک بولی۔ادائیگی: { ناگ + بَنْد }
 کمر کے گرد لپٹنے کا رسا جو کشکول، کٹھے، سینگ اور قلابے کے ساتھ مرشد اپنے چیلے کو دیتا ہے۔ادائیگی: { ناگ + دَم + نی }
 ایک لکڑی جس کی جڑیں اور حلقے سانپ سے ملتے ہیں، اسے سیاح لوگ پہاڑ سے لائے ہیں اور اکثر ہندو فقیر اپنے پاس رکھتے ہیں، بعض اسے سانپ کے زہر کا تریاق جانتے ہیں، ناگ دونے کا پودا، بانجھ ککوڑا۔ادائیگی: { ناگ + دَون (و لین) }
 ایک پودا جس کے پتوں کا پانی ہر قسم کے زہر کو دفع کرتا ہے، مارچوب، ہلیون۔ادائیگی: { ناگ + دَو (و لین) + نا }
 ایک پودا جس میں ڈالیاں اور ٹہنیاں نہیں ہوتیں، اس کی جڑ کے اوپر سے گوار پھلی کی سی پتیاں چاروں طرف سے نکلتی ہیں نیز اس کے پھول۔ادائیگی: { ناگ + دیوْ (ی مجہول) + تا }
 ناگوں کا بادشاہ یا اوتار۔ادائیگی: { ناگ + را + جَہ }
 بڑا ہاتھی۔ادائیگی: { ناگ + لوک (و مجہول) }
 سانپوں کی دنیا، پاتال، ناگوں کا ملک۔ادائیگی: { ناگ + مَتی }
 کالی تلسی۔ادائیگی: { ناگ + پَن + جَمی }
 ہندوؤں کا ایک تہوار جو ساون سادھی کی پانچویں تاریخ کو منایا جاتا ہے اور جس میں وہ سانپ کو پوجتے اور دودھ پلاتے ہیں۔پھانسی، پھندا،ادائیگی: { ناگ + پھَن }
 ایک قسم کا تھوہر جس کا پتا سانپ کے پھن کی طرح موٹا اور چوڑا ہوتا ہے اور اس پر ببول کے سے لمبے لمبے کانٹے نکلے ہوتے ہیں۔ (لاطینی: Ceetuwrsen dicus)، (انگریزی Opuntia)ادائیگی: { ناگ + پھَنی }
 ناگ پھن، ایک قسم کا پودا۔ادائیگی: { ناگ + چَم + پا }
 بستانی چمپا کی تین قسموں میں سے ایک قسم کا درخت دوسرے دونوں قسم کے درختوں سے بڑا اور موٹا ہوتا ہے، پتے چوڑے اور چھوٹے اور پھول لمبا اور رنگ زرد ہوتا ہے۔ادائیگی: { ناگ + ڈَنْڈ }
 ڈنڈ کی ایک قسم جس میں چارپائی کی رسی میں دونوں پاؤں پھنسا کور جس طرح سانپ لہراتا ہے اسی طرح صرف پنجوں کے بل تمام بدن کو معلق لہرا کر سمیٹ لیتے ہیں اور ہاتھ کا سہارا کسی چیز پر نہیں لیتے۔ادائیگی: { ناگ + کَرَن }
 (نجوم) پورے مہینے کے گیارہ کرنوں میں سے ایک کرن کا نام، اماوس کی تاریخ کے آخری نصف حصے میں دور کرنے والا کرن۔ادائیگی: { ناگ + کَن + یا }
 پاتال میں پسنے والے سانپوں کی نسل سے تعلق رکھنے والی نہایت حسین دوشیزہ۔جان جوکھوں کا کام ہونا
خطرے میں پڑنا
سخت بدمزاج حاکم کی نوکری میں ہونا
مہلک کام ہونا
کوئی نازک یا مشکل کام ہوناادائیگی: { ناگ + کے + سَر }
 اخروٹ کے درخت کے برابر ایک بہت بڑا درخت جس کے پتے ناشپاتی کے پتوں کی طرح چوڑے، پھول سانپ کے سر کی طرح اور زرد و سیاہ اور بہت خوشبودار اور پھل کالی مرچ کے برابر ہوتا ہے، اس کے پھولوں سے عطر بنایا جاتا ہے۔ (لاطینی: Mesua Ferrea)ادائیگی: { نا + گا }
 جنوبی آسام کی پہاڑیوں پر بسنے والا ایک قبیلہ۔ادائیگی: { نا + گاہ }
 یکایک، ایکاایکی، دفعتاً، ایک دم۔ایکا ایکی
بے سان و گمان
اچانک، بغتتًہ، دفعتًہ، ناگہ، یکایک،ادائیگی: { نا + گا + ہاں }
 ناگاہ، اچانک، یکایک، ناگہ۔غیر متوقع
آگہی، اچانک، یکایک،اس قوم کا ایک فرد
شہر کا باشندہ
شہر کا رہنے والا
قصبہ یا شہر کے متعلق
گجراتی برہمنوں کی ایک قوم
چالاک، شہری، ہوشیار،ادائیگی: { نا + گَر + بیل (ی مجہول) }
 ناگ بیل، پان کی نپل۔ادائیگی: { نا + گَر + پان }
 ایک نہایت عمدہ قسم کا پان، ایک خوشبودار پان، ناگرہس کا پتا۔ادائیگی: { نا + گَر + کَشی }
 ہل چلانے کا عمل، ہَل چلانا۔ادائیگی: { نا + گَر }
 (دکن) ہل، قلبہ۔ادائیگی: { نا + گَر }
 گجراتی برہمنوں کی ایک ذات یا شاخ نیز اس شاخ کا ایک فرد۔ادائیگی: { نا + گَر }
 دیوار کی ٹیڑھ جو زمین کی کمی بیشی کے سبب سے ہوتی ہے، جھوت۔
 ناگ سے منسوب۔ادائیگی: { نا + گَر + دان }
 وہ ظرف جس میں خوشبو رکھی جاتی ہے، عطردان۔ادائیگی: { نا + گِرِف + تَہ }
 جو پکڑا نہ گیا ہو؛ جو ہاتھ نہ آیا ہو؛ (مجازاً) جو لیا نہ گیا ہو (قرض وغیرہ)۔ادائیگی: { نا + گَر + مو (و مجہول) + تھا }
 ایک ہندوستانی گھاس جس کی جڑ سیاہ اور خوشبودار اور قد بیر کی گٹھلی کے برابر ہوتا ہے، سعدِہندی، مُسکِ ہندی۔ادائیگی: { نا گ + ری }
 ایک پسی کا نام جس میں آجکل ہندی لکھی جاتی ہے، وہ پسی جو ہندوستان کے ایک قدیم شہر دیونگر سے منسوب ہے، دیوناگری، ہندی کا رسم الخط۔ادائیگی: { ناگ + ری + خَط }
 ہندی رسم الخط۔ادائیگی: { نا + گُزار }
 جس میں کوئی چیز گزر نہ سکے؛ (ریاضی) ٹیڑھا، ناہموار (خط)۔ادائیگی: { نا + گُزِیر }
 جس کے علاوہ چارہ کار نہ ہو، جس کے سوا اور کوئی تدبیر نہ ہو، اٹل ضروری۔ادائیگی: { نا + گُزِیر + اَس + باب }
 اسباب جو لازمی ہو گئے ہوں، جن سے بچنا ناممکن ہو گیا ہو۔ادائیگی: { نا + گُزِیر + حا + لات }
 ایسے حالات جن سے بچنے کا کوئی طریقہ نہ ہو۔ادائیگی: { نا + گُزِیر + طَور (و لین) + پَر }
 چار و ناچار۔ادائیگی: { نا + گُزِیر + عَمَل }
 اٹل عمل۔ادائیگی: { نا + گُزِیر + وُجُوہ }
 ناگزیر اسباب، وجوہ جو لازمی ہو گئی ہوں۔ادائیگی: { نا + گُزی + ری }
 ضروری ہونے کی حالت یا کیفیت، لازمی نیز مجبوری۔ادائیگی: { نا + گُزی + رِیَت }
 بہت ضروری ہونا، لازمی ہونا، ناگزیر ہونے کا نظریہ۔ادائیگی: { نا + گُف + تَنی }
 جو کہنے کے لائق نہ ہو، ناقابل بیان۔ادائیگی: { نا + گُف + تَہ }
 جو کہنے کے لائق نہ ہو، ناقابل بیان۔ادائیگی: { نا + گُف + تَہ + بِہ }
 (وہ بات یا حال) جس کا اعادہ بیان کرنے والے کے لیے بھی تکلیف دہ ہو، ؛مجازاً) بات جو نہایت خراب ہو۔جوے کی رسی (س ۔ لاگل)
قلبہ، ہَل،(تشبیہاً) زلفِ سیاہ
گردن کے بالوں کی بھونری جو منحوس خیال کی جاتی ہے
گردن کے ہالوں کی بھونری
ناگ کی مادہ
سانپن،گدی کے اوپر سر کے بالوں میں ایک بھونری
گھوڑے کی گردن کی بھونری جو منحوس خیال کی جاتی ہے
ناگ قوم کی عورت
ناگ کی مادہ
سانپن، ہتنی،ادائیگی: { نا + گُنا }
 احسان فراموش، گن نہ ماننے والا، ناشکرا؛ بدصفات، بے گن۔ادائیگی: { نا + گُنی }
 ناشکری، احسان فراموش، گن یا احسان نہ ماننے والی۔ادائیگی: { نا + گَوار }
 جو گوارا نہ ہو، (مجازاً) ناخوش گوار، ناپسند، خلاف طبیعت، اس قدر براکہ قابل برداشت نہ ہو۔ادائیگی: { نا + گَوار + تَرِین }
 انتہائی ناگوار، بدترین۔ادائیگی: { نا + گَوا + رے + خا + طِر }
 جو دل کو پسند نہ آئے، جو دل کو برا لگے، خلاف طبع، خلاف مزاج، ناپسند۔خلاف طبع
خلافِ طبع
ناپسند،ادائیگی: { نا + گَوا + ری }
 ناگوار ہونے کی حالت، ناخوشگواری، ناپسندیدگی، نامرغوبیت، نامقبولیت۔ادائیگی: { نا + گَوا + رِیت }
 نامرغوبیت، ناپسندیدگی۔ادائیگی: { نا + گَہ }
 ناگاہ، یکایک؛ خلاف توقع، اتفاقاً۔اتفاقی، اچانک،ادائیگی: { نا + گَہاں }
 غیر متوقع، بے وقت۔
 ناگاہ، خلاف توقع، اچانک، یکایک، دفعتاً۔بے خبری میں
بے موقع
اچانک، بیوقت، دفعةً، یکایک،ایک قسم کا خوشبو دار پھول اور اُس کا پودا جسے ہندو لوگ مُتبرک خیال کرتے ہیںناگیسری کے رنگ کا
زرد،ادائیگی: { ناں }
 نہیں، نہ، نا؛ حرفِ تاکید |نا| کی ایک صورت۔آقا، مالک، ناتھ، ناں، نہ، نہیں،نہار منہ کھانا
نہار مُنہ کھانا
ناشتہ،ادائیگی: { نا + ہَر }
 شیر، باگھ، سنگھ، اسد نیز ببر شیر۔ایک مرض کا نام جس میں آدمی کے بدن پر دانے دانے ہوکر اُن میں سے تاگا سا نکلا کرتا ہے
ایک مرض کا نام جس میں آدمی کے بدن پر دانے ہوکر اُن میں سے تاگا سا نکلا کرتا ہے
بیمارئ رشتہ
لمبا کیڑا جو پیٹ میں پڑجاتا ہے
ناروا، ناہرُو، نہروا،تشنہ لب
پیاسا، سیراب،ادائیگی: { نا + ہَم + وار }
 (راستہ یا میدان وغیرہ) جو ہموار نہ ہو، غیر مسطح، اونچا نیچا، جس میں نشیب و فراز بہت ہو؛ (مجازاً) دشوارگزار۔ادائیگی: { نا + ہَم + وا + ری }
 مسطح یا ہموار نہ ہونا، کسی چیز کا اونچا نیچا ہونا، یکساں نہ ہونا، نشیب و فراز، بے ترتیبی۔نہ، نہیں،ادائیگی: { نا + ہَن + جار }
 بے راہ رو، کج رفتار، گمراہ، کج روش۔ادائیگی: { نا + ہَن + جا + ری }
 ناہنجار ہونے کی حالت، بے راہ روی، کج روی۔ادائیگی: { نا + ہِید }
 ایک ستارے کا نام جو تیسرے آسمان پر چمکتا ہے، زہرہ، وینس (Venus)، (اسے محبت کی دیوی اور مطربۂ فلک کا خطاب دیا گیا ہے) نیز عورتوں کا ایک نام۔ادائیگی: { نا + ہی + دے + آس + مان }
 (مجازاً) چاند (خصوصاً) پورا چاند، چودھویں کا چاند۔ادائیگی: { نا + ہِید + زیب (ی مجہول) }
 (لفظاً) ناہید کو زینت بخشنے والا، (مجازاً) سیارہ زہری سے زیادہ خوبصورت، (کنایتہً) حسین و جمیل۔ادائیگی: { نا + ہی + دے + نَغ + مَہ }
 خوش گُلو، خوش آواز (گانے والی کی صفت میں مستعمل)۔ادائیگی: { نا + ہِید + گُلُو }
 خوش گُلو، خوش آواز (گانے والی کی صفت میں مستعمل)۔کوئی نہیں
نہیں،انکار کرناادائیگی: { نا + یاب }
 جو عام طور سے میسر نہ آئے، ناپید؛ (مراداً) جو بڑی زحمتوں سے دستیاب ہو، جو نہایت کم یاب ہو۔ادائیگی: { نا + یا + بی }
 نایاب ہونا، بہت کم پایا جانا، ناپید ہونے کی حالت، کم یابی۔ادائیگی: { نا + یافْت }
 غیر موصول، غیر حاصل شدہ، نہ پایا ہوا، نہ حاصل کردہ۔ادائیگی: { نا + یاف + تَگی }
 نایافت ہونا، نہ پانا۔آدمی
خاوند
