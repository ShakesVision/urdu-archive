 نقب لگانے والا، مراداً، تہہ میں دوڑنے والا۔ادائیگی: { نَقْب + زَن }
 سیندھ لگانے والا، نقب لگانے والا، چوری کی نیت سے دیوار میں شگاف کرنے والا۔ادائیگی: { نَقْب + زَنی }
 نقب دینا، سیندھ لگانا، سرنگ کھودنا، رات کے وقت کسی کے مکان میں کسی رکاوٹ کو دور کر کے یعنی کھڑکی توڑ کر یا سیندھ لگا کر بدنیتی یا کسی جرم کی نیت سے داخل ہونے کا عمل، چوری، لوٹ مار۔ادائیگی: { نَقْب + چی }
 نقب لگانے والا، نقب زن، نقب افگن۔ادائیگی: { نَقْب + کا + مُنْہ(ن غنہ) }
 سرنگ کا سوراخ۔ادائیگی: { نُقَباء }
 قوم کے بڑے آدمی، قوم کے سردار، محافظ قوم، قوم کے ضامن۔روحانی گروہ کے وہ (تین سو اولیاء) اشخاص جو ستر ابدالوں کے جانشین ہوتے ہیں اور نہایت قابل اشخاص میں سے منتخب ہوکر آتے ہیں،اور لوگوں ادراک باطنِ حال پر مطلع ہونے پر مقرر ہوتے ہیں
صاحب قران
فاطمی دور میں نقیب النقباء(عہدہ) کا بھی پتہ چلتا ہے
قوم کے بڑے آدمی
قوم کے ضامن
محافظِ قوم
سردار،ادائیگی: { نَق + بی }
 نقب سے متعلق یا منسوب، سرنگ کی طرح کی، سرنگ کی طرز کی۔ادائیگی: { نَقْد }
 اچھا، عمدہ، نفیس تر جیسے نقد مال یعنی تر مال، عمدہ مال، کھرا، چوکھا، انوکھا جیسے تم تو بڑے نقد آئے کہ ابھی لے کر جاؤ گے، کیا نقد آئے۔
 [ مجازا ] دل، ذات۔
 پسر، فرزند۔۔
 آمادگی، موجودگی، آمادہ، مستعد، حاضر، دادو دمیش۔
 روپیہ، اشرفی پرکھنا، کھرا کھوٹا دیکھنا۔
 سیم و زر مسکوک، سکہ، روپیہ پیسہ۔
 روکڑ، نقدی، کیش، کھرا روپیہ۔
 ابھی، فی الحال، سردست، فوراً۔
 دامادادائیگی: { نَقْد + آ + وَر + فَصْل }
 ایسی فصل جو نقدی وصول کرنے کے لیے ہو غذا کے لیے نہ ہو۔ادائیگی: { نَق + دے + اَدَب }
 ادبی تنقید، ادب کے محاسن اور مصائب کا اندازہ، ادب و فن پر رائے، ادب کو پرکھنا۔ادائیگی: { نَق + دُش (ا ل غیر ملفوظ) + شَعْر }
 شعر کے فن پر کی جانے والی تنقید، شعر کو پرکھنا۔ادائیگی: { نَق + دے + اِی + مان }
 (کنایتہً) ایمان کی دولت یا پونجی، ایمان۔ادائیگی: { نَقْد + بَہ + نَقْد }
 فوراً کے فوراً، ہاتھ کے ہاتھ، دست بدست۔نفس ناطفہ
آتما، رواں، روح، رُوح،ادائیگی: { نَق + دے + جاں }
 (کنایتہً) جان و دل، روح، عزیز ترین چیز، آتما۔ادائیگی: { نَق + دے + حَدِیث }
 حدیث نبوی صلی اللہ علیہ وآلہ وسلم کی پرکھ، حدیث کی تحقیق کہ کون سی روایت کس حد تک مستند ہے۔ادائیگی: { نَق + دے + حَیات }
 زندگی کی دولت یا نقدی، سرمایہ حیات، مراد، جان، زندگی۔ادائیگی: { نَق + دے + دِل }
 دل کا سرمایہ یا پونجی، (کنایتہً) دل۔ادائیگی: { نَقْد + دم }
 اکیلا، تن تنہا، مجرد، غیر شادی شدہ۔ادائیگی: { نَق + دے + رَواں }
 سکہ رائج، وہ سکہ جو چلتا ہو، کھرا مال (مجازاً)، ساغر، جام شراب۔ادائیگی: { نَقْد + سَو (و لین) + دا }
 ایسا سودا جو فوراً طے ہو جائے۔ادائیگی: { نَق + دے + شِعْر }
 شعر کو پرکھنا، کلام کو جانچنے اور اس کے محاسن وغیرہ طے کرنے کا عمل۔ادائیگی: { نَقْد + ضَما + نَت }
 بطور ضمانت نقد ادا کی گئی رقم۔ادائیگی: { نَقْد + فَصْل }
 وہ فصل جو بیچنے کے لیے ہو غذا کے لیے نہ ہو، نقد آور فصل۔ادائیگی: { نَق + دے + قا + نُو + نی }
 (قانون) قانونی طور پر منظور شدہ سکے یا نوٹ جو ہر قسم کی ادائیگی میں دیے جائیں یا جن کا قبول کرنا قانوناً ضروری ہو، زر قانونی، قانونی سکہ۔ادائیگی: { نَقْد + مال }
 نقد رقم، سرمایہ، عمدہ مال، نفیس چیز، نعمت۔ادائیگی: { نَقْد + نا + را + اِن (کسرہ ا مجہول) }
 (طنزاً یا مزاجاً) زر نقد یا روپیہ پیسہ۔ادائیگی: { نَق + دے + نا + رَوا }
 کھوٹا روپیہ پیسہ، (مجازاً) بدقسمتی۔ادائیگی: { نَقْد + نا + صِرَہ }
 نقد مدد، نذرانہ، مالی معاونت۔ادائیگی: { نَقْد + نا + مَہ }
 نقد ادائیگی کا سرٹیفکیٹ۔ادائیگی: { نَق + دے + نام + یَہ }
 بڑھنے والی پونجی، بڑھنے والی دولت۔ادائیگی: { نَقْد + نَظَر }
 جانچ، پرکھ، کھرا کھوٹا پہچاننا نیز ادبی محاسن کو جانچنا، کسی تحریر کو پرکھنے کا عمل، تنقید و تبصرہ۔ادائیگی: { نَق + دو (و مجہول) + جَرْح }
 (علم حیث) تنقیدوتحقیق، کسی حدیث کی استناد کے لیے کی جانے والی تحقیق اور پرکھ یا بحث۔سردست، فوراً،ادائیگی: { نَق + دے + گِراں }
 مہنگا سودا۔ادائیگی: { نَق + دے + ہوش (ومجہول) }
 ہوش کی دولت، ہوش و حواس کی حالت۔ادائیگی: { نَق + دَین (ی لین) }
 نقد روپے نیز سونا چاندی۔ادائیگی: { نَق + دا + نَقْد }
 ہاتھوں ہاتھ، دست بدست، سردست، ترت، ہاتھ کے ہاتھ، نقد، فوراً ایک ہاتھ لینا دوسرے ہاتھ دینا، اسی وقت ادا کرنا، فوراً قیمت دینا۔ادائیگی: { نَق + دَن }
 نقداً، بالفعل، فوراً، فی الفور، ابھی۔ادائیگی: { نَق + دو (و مجہول) + جِنْس }
 مال اسباب، دھن دولت، روپیہ پیسہ اور غلہ وغیرہ۔ادائیگی: { نَق + دو (و مجہول) + نِس + یَہ }
 نقد و ادھار۔ادائیگی: { نَق + دو (و مجہول) + تَب + صَرَہ }
 کسی کتاب یا تحریر کو پرکھنا اور اس کے متعلق رائے دینا کلام کے عیوب محاسن کو پرکھنا، کسی ادب پارے کے حسن صْبح کو جانچنا۔ادائیگی: { نَق + دو (و مجہول) + وَقْت }
 سردست، ابھی، اسی وقت، فوراً۔ادائیگی: { نَق + دَہ }
 نقد روپیہ پیسہ۔ادائیگی: { نَق + دی }
 نقد روپیہ، زرنقد، دولت، دھن، مال و زر، روپیہ پیسہ، سرمایہ بصورت سکہ، رقم۔ادائیگی: { نَق + دی + فَصْل }
 ایسی فصل جو بیچنے کے لیے ہو غذا کے لیے نہ ہو۔ادائیگی: { نَق + دی + فَیص (ی لین) + لَہ }
 وہ تصفیہ یا فیصلہ جو سردست نقد روپیہ دے کر کیا جائے، نقد کھاتوں کا حساب کتاب۔ادائیگی: { نَق + دی + چِٹھ + ٹھا }
 نقد رقم کا حساب، کھاتہ روکڑ، روکڑبہی۔ادائیگی: { نَق + دی + گُماش + تَہ }
 محکمۂ مالیات کا ماتحت عامل، نقد رقم کا ذمے دار (ملازم)، خزانچی۔ادائیگی: { نَق + دی + نَہ }
 زرنقد، نقد رقم، وہ روپے جو ہاتھ میں ہوں، فوری ادائیگی کے لیے تیار رقم۔ادائیگی: { نَقْر }
 کھودنا، کھدائی، چونچ سے سوراخ کرنا، (اناج وغیرہ میں)۔ادائیگی: { نَقَر + نُول }
 چڑیا کی ایک قسم۔ادائیگی: { نُق + رَئی }
 چاندی کا، چاندی سے بنا ہوا، وہ چیز جو چاندی سے بنی ہو۔ادائیگی: { نُق + رَئی + آ + واز }
 کھنک دار آواز۔ادائیگی: { نُق + رَئی + سِک + کَہ }
 چاندی کا سکہ۔ادائیگی: { نُق + رَئی + قَہ (فتحہ ق مجہول) + قَہَہ }
 کھنکھناتی ہوئی زوردار ہنسی، گونج دار ہنسی، واضح ہونسی۔ادائیگی: { نُق + رَئی + وَرَق }
 نرم چاندی کے ٹکڑے جو مسلسل کوٹنے سے باریک کاغذ نما صورت اختیار کر لیتے ہیں جو ادویات کے علاوہ پان، میٹھے کھانوں یا مٹھائی وغیرہ پر خوبصورتی یا سجاوٹ کے لیے لگاتے ہیں، چاندی کا ورق۔ادائیگی: { نُق + رَئی + کاس + ٹِک }
 چاندی کو صاف کرنے والا تیزاب یا کھار۔ادائیگی: { نُق + رَئی + گو (و مجہول) + لی }
 چاندی کے ورق میں لپٹی ہوئی کوئی دوا۔ادائیگی: { نُق + رَئی + گھو (و مجہول) + ڑی }
 نقرہ کی تانیث، بالکل سفید گھوڑی۔ادائیگی: { نُق + را }
 (عو) چالاک (شخص)، بدذات، کمینہ، پاجی۔ادائیگی: { نَق + رِس }
 (طب) پاہں کے انگوٹھے کے درد کا نام، ایک قسم کے شدید درد کا نام جو پیروں کی انگلیوں اور ٹخنوں میں ہوتا ہے اور ہاتھ یا پاہں میں سوجن بھی ہو جاتی ہے، گٹھیا کا مرض، جوڑوں کا درد۔ادائیگی: { نَق + رِسے + خاص }
 (طب) نقرس کی ایک قسم جس میں دونوں پاہں کے انگوٹھے کے جوڑ سے درد شروع ہوتا ہے۔ادائیگی: { نَق + رِسی }
 نقرس سے متعلق، پاہں کے جوڑوں کے درد سے متعلق۔ادائیگی: { نِقَر + ضا }
 جس پر کوئی قرضہ نہ ہو۔ادائیگی: { نُق + رَوی }
 چاندی کا، نقرئی۔ادائیگی: { نَقَر + پان }
 ربیع کے موسم میں آنے والا مسافر پرند جو چھوٹے تیتر کے برابر ہوتا ہے مگئی اور کردانک کی طرح خوب دوڑتا ہے۔(صفت) سفید
اسپ سفید
انسان کی گردن کا گڑھا
چاندی کا سکہ
چِٹا گھوڑا
سفید رنگ کا گھوڑا
سفید گھوڑا جس کی پلکیں ایال دم وغیرہ بھی سفید ہوں۔ اگر ایال و دم وغیرہ سیاہ ہوں تو اُسے سبزہ کہتے ہیں
گلی ہوئی چاندی
ہر چیز سفید ہو
چاندی، چٹّا، دھولا، رُوپا، روپیہ، سفید، سیم، فضّہ،ادائیگی: { نُق + رَہ + آ + میز (ی مجہول) }
 چاندی ملا ہوا۔ادائیگی: { نُق + رَہ + اَف + شاں }
 روشنی دینے والا، چاندی بکھیرنے والا۔ادائیگی: { نُق + رَہ + باف }
 چاندی سے بنا ہوا، (کنایتہً) انتہائی مفید۔سفید رنگ کا گھوڑاادائیگی: { نُق + رَہ + رَنْگ (ن غنہ) }
 سفید رنگ۔(صفت) سفید
انسان کی گردن کا گڑھا
چٹّا گھوڑا
سفید رنگ کا گھوڑا
گلی ہوئی چاندی
چٹّا، دھولا، رُوپا، سیم، نقد،ادائیگی: { نُق + رَہ + پا + شی }
 چاندنی بکھیرنے کا عمل، چاندنی پھیلانا، چاند کی طرح روشنی بکھیرنا۔ادائیگی: { نُق + رَہ + پان }
 چاندی کے ورق لگے پان۔ادائیگی: { نُق + رَہ + پوش (و مجہول) }
 چاندی چڑھا ہوا۔ادائیگی: { نُق + رَہ + کار }
 روپہلا، کامدار۔ادائیگی: { نُق + رَہ + کو (و مجہول) + ری }
 آنکھ کے پردے سے نظر نہ آنے کی حالت۔ادائیگی: { نُق + رَہ }
 چاندی، سیم، روپا، فضہ۔ادائیگی: { نُق + رَہ }
 (تشریح الاعضا) چھوٹا گڑھا، جوف، قصر، تشبیہ، خصوصاً آنکھ کے پردے (شبکیہ) پر (Forea)۔ادائیگی: { نُق + رَہ + اے + خا + لِص }
 وہ چاندی جس میں کسی اور دھات کی ملاوٹ یا بھرت کاری نہ ہو، نقرہ سیم، خالص چاندی۔ادائیگی: { نُق + رَہ + اے + خام }
 خالص چاندی، مراد، نفاست، نزاکت، خالص ہونے کی حالت۔ادائیگی: { نُق + رَہ + اے + خِنْگ (ن غنہ) }
 گھوڑا جس کا رنگ چاندی جیسی سفیدی لیے ہوئے ہو، بالکل سفید گھوڑا۔ادائیگی: { نُق + رَہ + اے + سِیم }
 وہ چاندی جس میں کسی اور دھات کی ملاوٹ یا بھرت کاری نہ ہو، خالص چاندی۔ادائیگی: { نُق + رَہ + اے + مَج + زُوم }
 ناقص اور کم تر درجے کی چاندی۔ادائیگی: { نُق + رَہ + اے + مَف + لُوج }
 ناقص اور کمتر درجے کی چاندی۔ادائیگی: { نُق + ری }
 نقرہ سے نسبت رکھنے والا، چاندی کی طرح سفید، نقرئی، سفید گھوڑا۔ادائیگی: { نَقْش }
 منقوش، لکھا ہوا، رقم کیا ہوا، مرقوم۔
 کندہ، کھدا ہوا۔
 صورت، نگار، نگاشتہ، شبیہ، مورت، مورتی، تصویر۔
 پھول پتی کا کام، منبت کاری، کھدائی، کندہ کاری، قلم کاری، حکاکی، گل پھول، بیل بوٹے کا کام۔
 چھاپ، مہر، چھاپا، ٹھپا، طبع۔
 نرد کی بازی کا وہ داؤں جو حسب مراد آئے، پوبارہ۔
 ایک قسم کا قمار جو گنجفہ کے پتوں سے کھیلا جاتا ہے۔
 ایک قسم کا راگ جو قوال گایا کرتے ہیں۔
 تعویز، جنتر وہ کاغذ جس میں خانے کھینچ کر ہندسے سے بھرتے ہیں نقشہ جیسے بست در بست کا نقش۔
 کھوج، نشان، پٹیر، پاؤں کا نشان، علامت۔
 تصور، خیال۔
- تاثیر، اثر۔
- جادو، ٹونا، منتر، ٹوٹکا، سحر، افسوں، موٹھ۔
- سکہ، وہ روپیہ پیسہ جس پر بادشاہی علامت ثبت ہو، شاہی اسٹامپ۔ادائیگی: { نَق + شے + آب }
 نقش برآب، مراد، بے ثبات، غیر مستقل، فانی، جلد مٹ جانے والا۔ادائیگی: { نَق + شے + آ + خِر }
 آخری نقش، محفوظ رہ جانے والا نقش۔ادائیگی: { نَقْش + آ + را + ای }
 بیل بوٹے سے سجانا، قلم کاری، خوبصورت تحریر۔ادائیگی: { نَقْش + آف + ری + نی }
 تصویر بنانا، عکس یا شبیہ بنانا، مصوری۔ادائیگی: { نَق + شے + اَب + رو (و مجہول) }
 ابرو کا نقش، ابرو کا انداز۔ادائیگی: { نَق + شے + اِب + ہام }
 انگوٹھے کا نشان جو سیاہی وغیرہ لگا کر ثبت کیا جاتا ہے، انگوٹھے کا نقش۔ادائیگی: { نَق + شے + اِح + ضار }
 ارواح کو حاضر یا موجود کیے جانے کا عمل کا تعویز جو خانے کھینچ کر بناتے ہیں۔ادائیگی: { نَق + شے + اَر + ژَنْگ (ن غنہ) }
 معروف مصور مانی کی تصاویر کا مرقع۔ادائیگی: { نَق + شے + اُم + مِید }
 امید کا نقش، مراد، امید، آرزو۔ادائیگی: { نَق + شے + اَوْ + وَل }
 بہترین نمونہ، بہترین تخلیق۔ادائیگی: { نَق + شے + با + طِل }
 وہ نشان جو غلط ہونے کی وجہ سے مٹا دیا جاتا ہے، تحریر وغیرہ کا وہ نشان جو غلطی سے بن گیا ہو، مراد، فانی۔ادائیگی: { نَق + شے + بُد + دُوح }
 تلوار یا خنجر پر لکھا ہوا وہ نقش جو باری تعالٰی کے صفائی اسم کے طور پر دعاہں اور تعویزوں میں مستعمل ہے۔ادائیگی: { نَقْش + بَدی + وار }
 وہ نشان یا تصویر جو دیوار پر ہو (کنایتہً) چپ چاپ، ساکت، ہکا بکا، گم سم۔ادائیگی: { نَقْش + بَر + دی + وار }
 جو دیوار پر لکھا ہو، دیوار پر بنا نقش یا تحریر وغیرہ، نوشتہ دیوار۔ادائیگی: { نَقْش + بَر + ہَوا }
 (لفظاً) ہوا میں بنا ہوا نشان وغیرہ (کنایتہً) بے ثبات، ناپائیدار نیز جس کا وجود نہ ہو۔ادائیگی: { نَقْش + بَر + آب }
 مراد، جلد مٹ جانے والا، بے ثبات، فانی، ناپائیدار، عارضی۔ادائیگی: { نَق + شے + بِس + تَری }
 بستر کا نقش، وہ سلوٹ جو بستر پر لیٹنے سے پڑ جاتی ہے، (کنایتہً) ساکت، بے حس و حرکت، نہایت ضعیف۔ادائیگی: { نَقْش + بَس + تَہ }
 نقش کیا ہوا، جس پر کچھ نقش یا تحریر ہو۔ادائیگی: { نَقْش + بَنْد }
 نقاش، مصور، رنگ ساز، چترکار، گلکار۔ادائیگی: { نَقْش + بَن + دے + اَزَل }
 ازل کی صورت گری کرنے والا، مراد، اللہ تعالٰی، کائنات کا خالق۔ادائیگی: { نَقْش + بَن + دے + کُن + فَیَکُون }
 جس نے کن کہہ کر کائنات تخلیق کر دی، مراد اللہ تعالٰی۔ادائیگی: { نَقْش + بَن + دی }
 نقاشی، مصوری، رنگ سازی، چترکاری، رنگ آمیزی، گل کاری، چکن دوزی۔ادائیگی: { نَقْش + بَن + دِیَہ }
 تصوف کے سلاسل میں سے ایک سلسلہ جو حضرت خواجہ بہاالدین نقش بندی سے منسوب ہے۔ادائیگی: { نَق + شے + بور (و مجہول) + یا }
 بوریے پر بنا ہوا یا چھپا ہوا نشان، بوریے پر بیٹھنے یا لیٹنے سے جسم پر بن جانے والا نشان، نقش، حصیر۔اثر کرنا
اعتبار بہم پہنچانا
اعتبار حاصل کرنا
بات جمانا
دل میں بیٹھنا
دل میں گھر کرنا
رُعب جمانا
سکّہ بٹھانا
گھر کرنا
مُہر جمانا
بیٹھنا،ادائیگی: { نَقْش + بَہ + دی + وار }
 مراد، حیران، متعجب، حیرت زدہ، ہکا بکا، بے حس و حرکت، خاموش، چپ، نقش بدیوار۔ادائیگی: { نَق + شے + تَس + خِیر }
 محبت کا وہ تعویز جس سے معشوق قابو میں آ جائے، بس میں کر لینے والا جنتر۔ادائیگی: { نَق + شے + ثا + لِث }
 تیسرا نقش جو نقش ثانی سے بھی بہتر خیال کیا جاتا ہے۔ادائیگی: { نَق + شے + ثا + نی }
 کوئی تصویر یا کوئی فنی کاوش جو دوسری بار پیش کی جائے، دوسرا نقش جو پہلے نقش سے بہتر سمجھا جاتا ہے۔ادائیگی: { نَق + شے + جا + وِداں }
 ہمیشہ رہنے والا نقش، دائمی نقش۔ادائیگی: { نَق + شے + جَما + لی }
 تعویز جس کے اثرات موافق اور ٹھنڈے ہوں، جمالی تعویز۔رعب بیٹھانا
سکّہ جمانا
مجازاً: اثر ڈالنا
کسی چیز پر نقش کا بٹھانا
تاثیرڈالنا،رعب بیٹھنا
سکّہ جمنا
مجازاً اثر ہونا
کسی چیز پر نقش کا بیٹھ جانا
تاثیرہونا،ادائیگی: { نَق + شے + حُب }
 محبت کا تعویز، رام کرنے کا نقش، معشوق کو بس میں کرنے کا تعویز۔ادائیگی: { نَق + شے + حَجَر }
 پتھر پر پڑی ہوئی لکیریں، پتھر پر پڑے ہوئے نشان، مراد: دیرپا اثر، دائمی نشان۔ادائیگی: { نَق + شے + حَصِیر }
 بوریے کا نقش، چٹائی کا نقش، وہ نقش جو دیر تک چٹائی یا بوریے وغیرہ پر بیٹھے رہنے سے جسم پر بن جاتا ہے۔ادائیگی: { نَق + شے + حِفا + ظَت }
 حفاظت کا تعویز، بلیات سے محفوظ رہنے کا تعویز۔ادائیگی: { نَق + شے + حَیات }
 زندگی کے نقش، مراد، زندگی۔ادائیگی: { نَقْش + دار }
 وہ جس پر نقش بنے ہوئے ہوں، منقش، نقشی، بیل بوٹے دار، پھول دار۔ادائیگی: { نَق + شے + دِرَم }
 درہم پر نشان یا حروف وغیرہ، مراد، پائیدار نقش نیز زر، دولت۔وہ نشان جو درہم پر ہوتا ہےوہ نشان جو دل پر ہوادائیگی: { نَق + شے + دَوام }
 ہمیشہ قائم رہنے والا نشان۔ادائیگی: { نَق + شے + دی + وار }
 وہ نشان یا تصویر جو دیوار پر ہو (کنایتہً) ساکت، چپ، حیران، متعجب، نقش دیوار۔ادائیگی: { نَقْش + ساز }
 دھات کی پتلی سی تختی جس میں کاٹ کر حروف یا نقش وغیرہ بنا دیے جاتے ہیں اور اس کے ذریعے سے کسی سطح پر نقاشی کی جاتی ہے، نقش ساز تختی۔ادائیگی: { نَق + شے + سَج + دَہ }
 ماتھے کا وہ گٹھا جو سجدہ کرنے سے پڑ جاتا ہے۔ادائیگی: { نَق + شے + سُجُود }
 سجدوں کے نشان، نقش سجدہ۔ادائیگی: { نَق + شے + سُلَے (ی لین) + مان }
 حضرت سلیمان سے منسوب مہر، حضرت سلیمان کی انگوٹھی میں نقش مہر کے عکس کا تعویز جس کے باندھنے سے (روایتاً) نہ جادو اثر کرتا ہے نہ دیو اور پری سے کوئی نقصان پہنچتا ہے۔ادائیگی: { نَق + شے + سُوَے (و لین) + دا }
 کالے نقطے کا نشان جو دل پر ہوتا ہے۔ادائیگی: { نَق + شے + سِیم + یا }
 ایسا خیال یا وہم جو دھوکا ہو، فریب ہو۔ادائیگی: { نَق + شے + شِفا }
 شفایابی کا تعویز۔ادائیگی: { نَق + شے + طَراز }
 نقاش، مصور۔ادائیگی: { نَقْش + طَرا + زی }
 نقاشی، مصوری۔ادائیگی: { نَق + شے + طِلِس + می }
 جادو کا نقش، وہ تعویز جو جادو کے لیے کیا جائے۔ادائیگی: { نَق + شے + فا + نی }
 مٹ جانے والا (نقش) مراد، انسان، دنیا، کائنات وغیرہ۔ادائیگی: { نَقْش + فِل (ا غیر ملفوظ) + حَجَر }
 پتھر کا نقش، پتھر کی لکیر، پتھر پر پڑے نشان کی مانند کا نقش فی الحجر، مراد، بہت گہرا نشان، انمٹ نقش، وہ بات جسے بھلایا نہ جا سکے۔ادائیگی: { نَق + شے + قا + لی }
 ایسا نقش جو قالین پر ہو، (کنایتہً) بے حس و حرکت شے۔ادائیگی: { نَق + شے + قُد + رَت }
 اللہ تعالٰی کا بنایا ہوا نقش، مراد، خدا کی تخلیق، قدرت کی صناعی، اللہ کی خلاقی۔ادائیگی: { نَق + شے + قَدَم }
 پیر کا نشان، پاہں کا نشان، نقش پا، (کنایتہً) رہنما اصول۔ادائیگی: { نَق + شے + ما + ضی }
 گزرے ہوئے زمانے کی یاد، گزرے ہوئے واقعات، پرانی باتیں۔ادائیگی: { نَق + شے + ما + نی }
 مشہور و قدیم مصور مانی کے شاہکار کی طرح کا نقش، مراد بہت خوبصورت بہت حسین۔ادائیگی: { نَقْش + ما + او (و مجہول) + مَن }
 خودپرستی و خودپسندی کی علامت۔ادائیگی: { نَق + شے + مُراد }
 وہ تعویزی نقش جو مراد حاصل کرنے کے لیے کسی عامل نے لکھ دیا ہو، جو مقصود ہو، جس کی تلاش ہو۔ادائیگی: { نَق + شے + مُرَب + بَع }
 چوکور تعویز کا نقش جس کے خانوں میں اسما درج ہوتے ہیں۔ادائیگی: { نَق + شے + مَر + قُوم }
 رقم کیا ہوا نشان، وہ چیز جو لکھ دی گئی ہو۔ادائیگی: { نَق + شے + مَط + لُوب }
 مطلوبہ شے یا فرد کی تصویر، (کنایتہً) محبوب۔ادائیگی: { نَق + شے + مُقَد + دَر }
 وہ چیز جو مقدر میں لکھی جا چکی ہو، قسمت کا لکھا، مقدر کا لکھا۔ادائیگی: { نَق + شے + مَن + زِل }
 منزل کا نشان، سنگ میل۔ادائیگی: { نَق + شے + مَو (و لین) + ہُوم }
 خیالی بات، نیز عارضی یا مٹ جانے والی شے، تصوراتی شے یا نشان۔ادائیگی: { نَقْش + نَوی + سی }
 شجرہ لکھنے کا کام۔ادائیگی: { نَقْش + نِگا + را }
 (چٹائی یا کپڑا وغیرہ) جس پر نقش و نگار بنے ہوں، جس پر آرائشی نشان ہوں، نقشین، منقش، نقش۔ادائیگی: { نَقْش + نِگا + ری }
 نقش و نگار بنانے کا کام، مرصع کرنے کا عمل۔ادائیگی: { نَق + شے + نَگِیں }
 انگوٹھی کے نگینے پر کھدا نقش، مراد، کسی جگہ یا خانے وغیرہ میں جمی ہوئی شے، وہ جو مضبوطی سے لگا ہوا یا بیٹھا ہوا ہو۔ادائیگی: { نَق + شو (و مجہول) + نِگار }
 پھول پتی کا آرائشی کام، بیل بوٹے، خوش نما نقش۔ادائیگی: { نَق + شو (و مجہول) + نِگار + دَیر (ی مجہول) }
 دنیا کا سامان، زیب و زینت، مادی سامان۔بیل بوٹے دار
پھول دار
وہ جس پر نقش بنے ہوئے ہوں
منقش،ادائیگی: { نَق + شے + پا }
 پیروں کے نشان، پاہں کا نشان، نقش قدم، (مجازاً) کھوج، سراغ نیز کسی اہم چیز کی نشان دہی کرنے والا۔ادائیگی: { نَق + شے + پا + ری + نَہ }
 پرانا اور قدیم نقش، محفوظ رہ جانے والا نقش۔ادائیگی: { نَقْش + پَذِیر }
 نقش ہونے کے قابل، نقش ڈالے ہوئے، نقش کیے ہوئے۔ادائیگی: { نَقْش + پَذی + ری }
 نقش ڈالنے کا عمل، نشان ڈالنا۔ادائیگی: { نَقْش + پَر + داز }
 نقش بنانے والا، مصور، نقاش، نقش ابھارنے والا۔ادائیگی: { نَق + شے + پے + شا + نی }
 پیشانی پر پڑنے والی لکیریں، پیشانی کے خط۔ادائیگی: { نَقْش + پَے (ی لین) + ما }
 (مصوری) تصویر یا نقش ناپنے کا آلہ یا میزان، پرکار۔ادائیگی: { نَقْش + کا + ری }
 لکڑی پر پتھر پر کھدائی اور نقاشی، صنعت کاری، چوب تراشی، سنگ تراشی۔ادائیگی: { نَقْش + کا + غَذ }
 وہ باریک کاغذ جس سے باآسانی نقش اتارا جا سکے، عکس یا چربے کا کاغذ جو تارپین کا تیل وغیرہ لگا کر شفاف کر لیا جاتا ہے، ٹریسنگ پیپر۔پتھر کی لکیر
درست محاورہ "کالنقش فی الحجر" ہے۔ (اس نقش کے مانند جو پتھر پر ہو)بیل بوٹا جمانا یا کھودنا
بیل بُوٹا کھودنا
بٹھانا، جمانا، چھاپنا،ادائیگی: { نَقْش + کَشی }
 نقش کھینچنا، دائرے، مربعے، مستطیل کھینچنے کا عمل۔ادائیگی: { نَق + شے + کَفے + پا }
 پاہں کے تلوے کا نشان، نقش قدم، نقش پا۔ادائیگی: { نَق + شے + کُہَن }
 پرانا نقش، مراد، پرانا عقیدہ، پرانی باتیں یا رسوم، پرانا انداز نیز قدیم عمارات وغیرہ۔ادائیگی: { نَق + شے + گَلِیم }
 وہ نقش و نگار جو کپڑے وغیرہ پر بنے ہوتے ہیں، (مجازاً) بے حس و حرکت، چپ، خاموش تماشائی۔ادائیگی: { نَقْش + ہا + اے + قَدَم }
 قدموں کے نشانات۔ادائیگی: { نَق + شے + ہَوا + با + لا + اے + آب }
 وہ بلبلے جو ہوا پانی پر بناتی اور بگاڑتی ہے۔تحریر ہونا
