 لمبا، دراز (مختصرر کی ضد)۔
 [ مجازا ] بلند، عالی، اونچا۔
 [ عروض ] ایک بحر کا نام جس میں چار بار فعولن مفاعلین کی تکرار ہوتی ہے۔ یہ بحر عربی شعر سے مخصوص ہے۔ فارسی اور اردو میں کم یاب ہے لمبی بحر۔ادائیگی: { طَوی + لُذ (ا، ل غیر ملفوظ) + ذَیل (ی لین) }
 جس کا سلسلہ یا متعلقات بہت پھیلے ہوئے ہوں، دراز دامن، طول طویل۔ادائیگی: { طَوی + لُل (ا غیر ملفوظ) + عُمْر }
 زیادہ عمر کا، بڑی عمر کا۔ادائیگی: { طَوی + لُل (اغیر ملفوظ) + قا + مَت }
 قدو قامت میں لمبا، دراز قد، بلند قامت، بہت اونچا (عموماً آدمی یا کوئی چیز)۔ادائیگی: { طَوی + لُل (اغیر ملفوظ) + مُد + دَت }
 لمبے عرصہ کا، انتہائی مدت کا، عرصہ دراز پر محیط، دیر تک رہنے والا۔ادائیگی: { طَوی + لُن (ال غیر ملفوظ) + نَظَر }
 وہ جسے دور کی چیزیں دھندلی دکھائی دیتی ہوں، دراز نظری کا بیمار۔ادائیگی: { طَوِیل + مُخ + تَصَر + اَف + سا + نَہ }
 ناول اور افسانے کے بیچ کی ایک صنف جس میں ناولوں کی پس منظری کیفیتیں اور مختصر افسانے کی وحدت تاثر ایک ساتھ موجود ہوتی ہے اس میں ناول کے پلاٹ کی پیچیدگی اور گہرائی نہیں ہوتی لیکن جو کسی ایک خاص محل فضا اور ذہنی کیفیت کی پیچیدگیوں کی وضاحت کرتا ہے اس میں مناظر زیادہ تفصیلی اور کردار زیادہ واضح ہو کر سامنے آتے ہیں۔ادائیگی: { طَوی + لَہ }
 چوپایوں خصوصاً گھوڑوں کے باندھنے کی جگہ، اصطبل، تھان، گھر۔گھوڑوں کا تھان
گھُڑ سال
اصطبل،پیغمبر صلى الله عليه وسلم
تلفظ طاہا
قرآن شریف کی
قرآن شریف کی سورت نمبر ۲۰تڑپنے والا
تڑپنا، طپیدن،بے چین
بے قرار
بیچین، مضطرب،تیز ہوا کا جھونکا
ف،تواں طاقت، چہ کلمہ نسبت
تمانچہ، تھپڑ،ادائیگی: { طَپاں + چَہ + بَنْد }
 جو طمنچہ لگائے ہوئے ہو، طپنچہ سے مسلح۔ادائیگی: { طَپاں + چَہ }
 طمانچہ، چانٹا، تھپڑ۔ادائیگی: { طَپاں + چَہ }
 طپنچہ، چھوٹی بندوق، پستولادائیگی: { طَپِش }
 تڑپ، اضطراب، بے قراری، بے چینی۔(صحیح معرب طپش ہے کیونکہ باے فارسی عربی میں نہیں آتی یہ لفظ اصل میں تپیدن سے تپش تھا آج کل اس کا املاتائے فوقانی سے ہی جائز ہے اگلے لوگ تائے حطی سے لکھا کرتے تھے)دیکھئے: تپش
تپیدن، تپیدہ،اصل میں تفکچہ یا تفنگو ہے
چھوٹی بندوق
پستول، تمنچہ،ادائیگی: { طَپی + دَن }
 تڑپنا، مظرب ہونا، بے قرار ہونا، گرم ہونا، جوش میں آنا۔ادائیگی: { طَپی + دَہ }
 تڑپتا ہوا، بے قرار، مضطرب۔ادائیگی: { طا + حا (ا بشکل ی) }
 قرآن کی سورۃ کا نام جو اس لفظ سے شروع ہوتی ہے۔
 رسول خدا صلی اللہ علیہ وآلہ وسلم کا خطاب (اللہ تعالٰی کی طرف سے)۔ادائیگی: { طَہا + رَت }
 ظاہری اور باطنی نجاست سے دوری، پاکی، نظافت۔
 [ شرع ] وضو، غسل اور آبدست اور استنجا جس سے نجاست دور ہوتی ہے۔
 صفائی، ستھرائی، پاکیزگی؛ (مجازاً) سلیقہ، تمیز۔
 بزرگی، تقدس؛ حرمت، برگزیدگی۔ادائیگی: { طَہا + رَتے + جِس + می }
 بدن کو پاک صاف رکھنا، بدن اور لباس وغیرہ کی پاکیزگی۔استنجا گاہ
باتھ روم
غسل خانہ
نہانے اور وضو کرنے کی جگہ
وضو خانہ
ٹوائلٹ،ادائیگی: { طَہا + رَتے + شَر + عی }
 شرع کے مطابق پاکیزگی، اسلام کے اصول کے مطابق پاکیزگی۔ادائیگی: { طَہا + رَتے + نَفْس }
 روح کی پاکیزگی، باطن کی صفائی، بزرگی، پاکبازی۔ادائیگی: { طَہا + رَت + پَسَنْد }
 پاکیزگی پسند کرنے والا، پاک و صاف رہنے والا۔ادائیگی: { طَہا + رَتی }
 طاہر، پاکیزہ، پا کباز۔ادائیگی: { طَہا + رَہ }
 بیت الخلا۔تِلّی، تلی،ادائیگی: { طُہْر }
 حیض سے پاکی نیز وہ مدت جس میں حیض نہ ہو، دو حیض کے درمیان کے ایام۔پاک یا صاف ہونا
پاک صاف
ستھرا، طَہَرَ،ادائیگی: { طَہُور }
 وہ چیز (پانی کی طرح) جس سے کوئی پاک یا صاف کرتا ہے، صفائی یا پاکی کا ذریعہ۔
 پاک و صاف، طاہر۔ادائیگی: { طَیّ }
 طے، لپیٹنا، تمام کرنا، کوتاہ کرنا۔ادائیگی: { طَیْ (ی لین) + یُل (ا غیر ملفوظ) + اَرْض }
 اولیاء اللہ کی ایک کرامت جس میں زمین گویا اس درجہ سمٹ جاتی ہے کہ ان کا ایک قدم کئی کئی میل (روایت کے مطابق بارہ کوس) پر پڑتا ہے اور مہینے کی مسافت گھنٹوں اور دنوں میں طے ہو جاتی ہے۔ادائیگی: { طَیْ + یُل (ا غیر ملفوظ) + لِسان }
 اولیاء اللہ کی ایک کرامت جس میں گھوڑے کی رکاب میں پہلا قدم رکھنے کے بعد دوسرے قدم رکھنے کے درمیانی وقفے میں پورا قرآن ختم کر دیتے یعنی گھنٹوں کی تلاوٹ کو منٹوں اور سیکنڈوں میں پورا کرتے ہیں نیز بولنے کی استعداد، گویائی۔ادائیگی: { طَیْ + یار }
 بہت تیز اڑنے یا دوڑنے والا (جانور) نیز پرندہ۔ادائیگی: { طَیْ + یار + دان }
 طیارہ گاہ، ہوائی اڈہ، ہوائی بندر گاہ۔ادائیگی: { طَیْ + یار + چی }
 ہوائی جہاز اڑانے والا، ہوا باز۔ادائیگی: { طَیْ + یا + رَہ }
 اڑنے والا جہاز، ہوائی جہاز، ایروپلین۔
 ایک فرقہ جس کے امام عبداللہ بن معاویہ بن عبداللہ بن جعفر طیار بن ابی طالب تھے۔ (فرقے اور مسالک، 138)ادائیگی: { طَیْ + یا + رَہ + بَر + دار }
 وہ بڑا بحری جنگی جہاز جو طیّاروں کو ساتھ لے کر چلے اور جس میں ان کے اڑنے اور اترنے کے لیے مسطّح جگہ ہو۔ (انگریزی اردو فوجی فرہنگ، 2)ادائیگی: { طَیْ + یا + رَہ + را + نی }
 ہوا بازی، ہوائی جہاز اڑانا۔ادائیگی: { طَیْ + یا + رَہ + شِکَن }
 طیّارہ توڑنے والا، جنگی طیّارے کو گولہ باری کرکے تباہ کرنے والا (عموماً توپ، گن، میزائل وغیرہ)۔ادائیگی: { طَیْ + یا + رَہ + شِکَن + توپ (و مجہول) }
 ایک خاص قسم کی توپ جس سے عموماً پرواز کرتے ہوئے جنگی طیارہ پر گولہ باری کی جاتی ہے۔ادائیگی: { طَیْ + یا + رَہ + مار }
 طیارہ توڑنے والا۔ادائیگی: { طَیْ + یا + رَہ + گاہ }
 ہوائی بندر گاہ، ہوائی اڈہ، ایئرپورٹ۔ادائیگی: { طِیب }
 خوشی، رضا مندی۔ادائیگی: { طیْ + بُن (ا، ل غیر ملفوظ) + نَفْس }
 پاک دل، پاک نفس، صاف باطن۔ادائیگی: { طِیب + بَخْش }
 خوشبو بخشنے والا، خوشبو دینے والا۔ادائیگی: { طی + بے + خا + طِر }
 دل کی خوشی، دلی رغبت۔پاک عورتیں
نیک نام
خوشیاں،ادائیگی: { طی + بَت }
 خوش طبعی، مزاح، مذاق، چہل۔ادائیگی: { طَیْ + یِبَہ }
 مدینہ منورہ کا نام۔پاک لوگ
طیب کی جمع
طاہرین،ادائیگی: { طَیر (ی لین) }
 پرواز، اڑان۔ادائیگی: { طَے (ی لین) + رُل (ا غیر ملفوظ) + بَحْر }
 ایک پرندہ جو دریا میں اڑتا ہے اور گھونسلہ نہیں بناتا بجز اس وقت کے جبکہ اسے انڈے دینے ہوں۔ادائیگی: { طَے (ی لین) + رے + با + راں }
 سنہری پلوور، سنہری رنگ کا ایک پرندہ جس کی ٹانگیں لمبی ہوتی ہیں اور جو جھنڈ میں رہتا ہے۔ادائیگی: { طَے + رے + سا + کِت }
 وہ پرندے جو آواز نہیں نکالتے ان میں لم ڈھینگ، چتوڑا، گدھ وغیرہ شامل ہیں۔ادائیگی: { طَے (ی لین) + ران }
 پروازادائیگی: { طَے (ی لین) + ران + نا + پَذِیر }
 وہ مائع، تیل یا مرکبات وغیرہ جن میں اڑنے یا تبخیر کی صلاحیت نہ ہو۔ادائیگی: { طَے (یائے لین) + ران + پَذِیر }
 [ کیمیا ] بخار بن کر اڑ جانے والا، کوئی باری شے جو جلد اڑ جانے والی ہو جیسے بعض تیل یا دوسرے مرکبات۔ادائیگی: { طَے (یائے لین) + ران + پَذی + ری }
 تیل یا دوسرے مرکبات کا حرارت پا کر اڑ جانا یا بخار بن جانا۔ادائیگی: { طَے (ی لین) + ران + گاہ }
 ہوائی اڈّا۔ادائیگی: { طَے + را + نَہ }
 ایک روئیدگی ہے کھمبی کی طرح لیکن اس سے بڑی رنگ سفید و زرد ہے اور سوکھنے کے بعد سرخ ہو جاتی ہے اکثر بلوط اور زیتون کے درختوں تلے پیدا ہوتی ہے بارش میں کثرت سے اگتی ہے نہایت زہریلی ہوتی ہے۔ادائیگی: { طَے (ی لین) + را + نی }
 پرندے جیسا، پرندے کی طرح اڑنے والا۔بد فال
براشگون،ادائیگی: { طِیَرَہ }
 بدشگون، فال بد۔ادائیگی: { طَیش (ی لین) }
 غضب، غصہ، شدید، جھنجھلاہٹ۔
 (عقل کا) ہلکا پن، سبکی؛ ناسمجھی؛ تیر کا خطا کرنا نشانے سے۔ (پلیٹس؛ سرگزشتِ الفاظ، 101)افروختہ کرنا
بر افروختہ کرنا
غصہ دلانا
بھڑکانا،برداشت کرنا
غم وغصہادائیگی: { طَے (ی لین) + طَوی }
 ٹٹیری، چھوٹے سے بگلے کے برابر ایک پرندہ۔ادائیگی: { طَیف (ی لین) }
 مختلف رنگین دھاریوں کا ایک سلسلہ جو کسی منشور سے سفید روشنی گزرنے سے پیدا ہو، پردے یا دیوار پر مختلف رنگوں کی ترتیب۔ادائیگی: { طَیف (ی لین) + بِین }
 نور کی شعاعوں یا کسی اور روشن قوت کے اجزائے ترکحیبی کے تجزیے یا پیمائش کا آلہ۔ادائیگی: { طَیف (ی لین) + بی + نی }
 نور کی شعاعوں یا کسی اور روشن قوت کے تجزیے یا دیکھنے کا علم یا فن۔ادائیگی: { طَے (ی لین) + فَے + عکْس + پَے (ی لین) + ما }
 نور کی شعاعوں کا عکس اتارنے یا ناپنے کا ایک آلہ۔ادائیگی: { طَے (ی لین) + فے + مَن + شُو + ری }
 سیدھا شیشہ جو روشنی کی شعاعوں کو مختلف رنگوں میں پھیلاتا ہے۔ادائیگی: { طَیف (ی لین) + نُما }
 نور کی شعاعوں یا کسی اور روشن قوت کے اجزائے ترکیبی کے تجزیے یا پیمائش کا آلہ۔ادائیگی: { طَیف (ی لین) + نِگار }
 نور کی شعاعوں کی تصویر پر بنانے کا آلہ۔ادائیگی: { طَیْف (یائے لین) + پَے (یائے لین) + ما }
 نور کی شعاعوں یا کسی اور روشن قوت کے اجزائے ترکیبی کے تجزیے یا پیمائش کا آلہ۔ (Spectra Scope)
 نور کی شعاعوں کی تصویر بنانے کا آلہ۔ادائیگی: { طَیف (ی لین) + پَے (ی لین) + ما + ای }
 نور کی شعاعوں کی تحلیل یا پیمائش کا علم۔اُڑنے والا کیڑا
ایک خاص پرند کا نام
پرند،ادائیگی: { طَے (ی لین) + فُو + ریْ + یَہ }
 صوفیا کے ایک گروہ کا سلسلہ جو حضرت بایزید طیفور بن عیسی بسطامی سے منسوب ہے۔ادائیگی: { طَے (ی لین) + فی }
 طیف سے منسوب، طیف کا، مختلف رنگوں کی ترتیب کا۔ادائیگی: { طَے (ی لین) + فی + تَج + زِیَہ }
 روشنی کے رنگوں کا تجزیہ جو نہ صرف کسی شے کے خفیف سے خفیف شائبہ کا پتہ چلاتا ہے بلکہ نئے عنصر بھی دریافت کرتا ہے مثلاً سیسیم گیلیم وغیرہ دھاتیں اسی طرح دریافت ہوئیں۔ادائیگی: { طَے (ی لین) + فی + خُطُوط }
 نور کی شعاعوں کی رنگین لکیریں جو حرارت کے سبب کسی شے میں پیدا ہوتی ہیں۔پگڑی کا شملہ
چادر جو عرب کندھوں پر ڈالتے ہیںادائیگی: { طَے (ی لین) + لِسان }
 چادر یا رومال جو خصوصاً خطیب عالم اور فقیہہ کاندھے پر ڈالتے ہیں۔ادائیگی: { طَے (ی لین) + لِسا + نی }
 (جامعہ وغیرہ کا) سند یافتہ، گریجویٹ۔ادائیگی: { طَے (ی لین) + لِسا + نِیَت }
 سندیافتگی، گریجویشن، بہت پڑھا لکھا ہونا۔ادائیگی: { طِین }
 مٹی، گل، گارا۔ادائیگی: { طی + نے + لا + ذِب }
 چپکنے والی مٹی، لیسدار مٹی۔ادائیگی: { طِی + نے + لا + زِب }
 چپکنے والی مٹی۔ادائیگی: { طی + نَت }
 خلقت، سرشت، فطرت، جبلت۔ادائیگی: { طی + نَتَن }
 طینت کے مطابق، فطرتاً نیز عادتاً۔ادائیگی: { طی + نی }
 طین سے منسوب، مٹی کا، مٹی کی چیز، کمہاری مٹی۔ادائیگی: { طُیُوب }
 خوشبوئیں۔ادائیگی: { طُیُور }
 پرندے۔چڑیمار،ادائیگی: { طَے (یائے لین) }
 تہہ، لپیٹ۔
 مسافت ختم ہونا، تمام ہونا، راستہ چلنا، گزرنا۔
 لپیٹنا، ختم کرنا، کوتاہ کرنا۔ (فروز اللغات اُردو)
 یمن کے ایک قبیلے کا نام جس کی طرف حاتم طائی منسوب ہے۔
 فیصلہ، بیباقی، چکوتا؛ کوتاہ، مختصر؛ ختم کرنا، پورا کرنا، انجام کو پہونچانا۔ (نوراللغات)
 [ عروض ] گرانا، چوتھے حرف ساکن کا دو سبب خفیف سے کہ یہ بے فاصلہ اول رکن کے آئے ہوں مثلاً مستفعلن کا چوتھا حرف (ف) گرائیں تو مستعلن رہتا ہے۔"فاصلے کا طے کرناادائیگی: { طَے (ی لین) + شُدَہ }
 جس کا فیصلہ ہو چکا ہو، قرار دیا ہوا، متعین، مقرر۔سفر کے مرحلوں پر سے گزر جاناادائیگی: { طَے (ی لین) + کا + رو (و مجہول) + زَہ }
 وہ روزہ جو قبیلہ طے کے لوگ دو روز برابر رکھتے اور تیسرے روز افطار کرتے تھے۔ادائیگی: { طَے (ی لین) + کَر + دَہ }
 طے شدہ، جس کا فیصلہ ہو چکا ہو، قراد دیا ہوا، متعین، مقرر، معین کیا ہوا؛ (مجازاً) بنایا ہوا۔تمام ہونا
