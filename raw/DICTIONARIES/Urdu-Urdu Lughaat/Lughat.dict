وہ لکڑی جس سے لڑکے کھیلتے ہیں ایک لکیر کھینچ دیتے ہیں اور دوسرا شخص چوٹ لگا کر لکیر سے پار کرتا اور جیت لیتا ہے
اجارہ، انعقاد، پٹی، پکڑنا، تجارت، تَسخیر، حصص، ظفر، فتح، لینا، مال، نصرت، کاشت،ادائیگی: { گَیس (ی لین) }
 مادہ جو بھاپ یا بخارات کی شکل میں پایا جاتا ہے اور کئی طرح کا ہوتا ہے۔
 کوئلوں کی کانوں میں پایا جانے والا زود احتراقی ہوا اور گیس کا آمیزہ جو ایندھن کے طور پر اورچولھوں میں عام طور پر استعمال کیا جاتا ہے، قدرتی گیس جو سوئی گیس کے نام سے بھی پاکستان میں جانی جاتی ہے۔
 ایک وضع کی لالٹین جو باریک تاروں کی بیضوی بتی چڑھا کے سپرٹ سے گرم کرنے اور پھر لیمپ کی ٹینکی میں لگے ہوئے پمپ میں ہوا پھرنے سے مٹی کا تیل گیس بننے سے جلتی ہے، گیس کی لالٹین، پیٹرومیکس (گیس کا ہنڈا)۔
 ہائیڈروجن وغیرہ جو غبارے میں بھری جاتی ہے۔
 زہریلی گیس جس سے آنسو بہنے لگتے ہیں اور کچھ دیر کے لیے بصارت زائل ہو جاتی ہے، اشک اور گیس، آنسو گیس نیز وہ گیس جو دشمن کو ہلاک یا بے ہوش کرنے کے لیے استعمال ہوتی ہے۔
 ریاح، ریح نیز ریح کی بیماری۔ادائیگی: { گَیس (ی لین) + رو (و مجہول) + زَن }
 گیس کے اخراج کے سوراخ، ہوادان جو عموماً فولادی بھٹیوں میں ہوتے ہیں۔ادائیگی: { گَیس (ی لین) + ٹِیُوب }
 نلکی جس میں گیس بھری ہو، سائنسی آلات میں مستعمل۔ادائیگی: { گَیس (ی لین) + پَے (ی لین) + ما }
 ایک آلہ جس سے گیس کی مقدار معلوم کی جاتی ہے۔ادائیگی: { گَیس (ی لین) + چَیم (ی لین) + بَر }
 وہ کمرہ جس میں موت کے سزا یافتہ کو زہریلی گیس کے ذریعے ہلاک کیا جاتا ہے۔ادائیگی: { گَیس (ی لین) + کا + ہَن + ڈا }
 ایک وضع کی لالٹین جو مٹی کے تیل سے پیدا ہونے والی گیس سے جلتی ہے، گیس کی لالٹین۔ادائیگی: { گَیس (ی لین) + کَٹَر }
 گیس کے شعلے کے ذریعے لوہا یا فولاد کاٹنے والا آلہ۔ادائیگی: { گے + سُو }
 سر کے لمبے بال (خصوصاً عورتوں کے)۔
 [ تصوف ] طریق طلب جو عالم ہویت میں ہو، جبل المتین۔ (مصباح التعرف)ایک گالی
بیشرم عورت
بے حیا
فاحشہ،ادائیگی: { گے + سُو + تَرا + شی }
 بال کاٹنا، بال کاٹنے کا پیشہ۔ادائیگی: { گے + سُو + دار }
 گیسو والا، (مجازاً) پیرزادہ، سید زادہ۔ادائیگی: { گے + سُو + دا + نی }
 وہ ڈبیا وغیرہ جس میں عورتیں اپنے گرے ہوئے بال احتیاط سے اٹھا کر رکھ دیتی ہیں۔ادائیگی: { گے + سُو + دَراز }
 لمبے لمبے بالوں والا، لٹوریہ، (مجازاً) فقیر، سادھو، بزرگ۔
 سلسلۂ چشتیہ سے تعلق رکھنے والے بزرگ سید محمد بن یوسف (بندہ نواز) کا ایک لقب۔ادائیگی: { گے + سُو + کَمَنْد }
 وہ معشوق جس کے بال دل عاشق کے لیے کمند کا کام کریں۔ادائیگی: { گے + سُو + کی + لَہْر (فتحہ ل مجہول) }
 بالوں کی لٹ، خمدار لٹ۔معشوق،ادائیگی: { گے + سُو + اے + تاب + دار }
 بہت سیاہ اور پرشکن بال، گھنگھریالے بال، خم در خم گیسو۔ادائیگی: { گے + سُو + اے + رَسا }
 لمبے بال، گیسوئے دراز۔ادائیگی: { گے + سُو + اے + سُم + بَل }
 سنبل جیسے خوشبو والے بال۔ادائیگی: { گے + سُو + اے + شَب + گُوں }
 بہت کالے بال، سیاہ زلفیں۔ادائیگی: { گے + سُو + اے + شَمْع }
 موم بتی یا شمع کا دھواں۔ادائیگی: { گے + سُو + اے + عَم + بَر + شَمِیم }
 ایسے گیسو جن سے عنبر کی خوشبو آئے، خوشبودار بال۔ادائیگی: { گے + سُو + اے + عَم + بَر + فِشاں }
 ایسے گیسو جن سے عنبر کی خوشبو آئے، خوشبودار بال۔ادائیگی: { گے + سُو + اے + عَم + بَر + فام }
 عنبر کے رنگ کی زلفیں، بھورے رنگ کے بال۔ادائیگی: { گے + سُو + اے + عَم + بَرِیں }
 خوشبودار زلفیں، مہکتے ہوئے بال۔ادائیگی: { گے + سُو + اے + مُش + کِیں }
 گیسوئے مشکبو، گیسوئے مشک فام۔ادائیگی: { گے + سُو + اے + مُعَم + بَر }
 خوشبودار زلف، عنبریں زلفیں۔ادائیگی: { گَے + سُو + اے + پُر + پیچ (ی مجہول) }
 خم در خم زلفیں، گھونگھریالے بال، باندھے ہوئے بال۔ادائیگی: { گے + سُو + اے + پُر + تا }
 چمکتے ہوئے گیسو نیز خمدار زلفیں، سنوارے ہوئے بال۔ادائیگی: { گے + سُو + اے + پُر + شِکَن }
 پرپیچ زلفیں، خم در خم گیسو، گھنگھریالے بال۔ادائیگی: { گیسْٹ (ی مجہول) }
 مہمان۔ادائیگی: { گیسْٹ (ی مجہول) + رُوم }
 مہمانوں کے ٹھہرانے کا کمرہ۔ادائیگی: { گیسْٹ (ی مجہول) + ہا + اُوس }
 مہمان خانہ۔چلنا
پگ ڈنڈی
جانا کرنا لینا کے ساتھ
راہ باٹ
سیلا پن
گیلا پن
کیلے کی پھلیوں یا کھجوروں کا گچھا
باٹ، بٹیا، پینڈا، تری، راستہ، راہ، رستہ، رطوبت، روش، ساتھ، سنگ، سڑک، سیل، گم، گَیلَ، مارگ، مگ، نمی، ڈگر، ہمراہ،رفیق، ساتھی،ادائیگی: { گی + لا }
 جس میں نمی یا تری ہو، بھیگنے کے بعد جو ابھی خشک نہ ہوا ہو، نم، تر، بھیگا ہوا۔
 (فحش بازاری) وہ (لڑکا) جو جلدی بدفعلی پر راضی ہو جائے، جسے بدفعلی کرانے کا شوق ہو۔ (مہذب اللغات)۔ادائیگی: { گی + لا + رے + شَم }
 مصنوعی ریشم۔ادائیگی: { گی + لا + سی + لا }
 جس میں سیل کی وجہ سے نمی ہو، نم۔ادائیگی: { گی + لا + پَن }
 گیلا ہونے کی حالت، گیلا ہونا، نمی۔تر کرنا
نم کرنا
نمی پہنچانا
بھگونا،تر ہونا
نم ہونا
نمناک ہونا
بھیگنا،ادائیگی: { گی + لا }
 ایک جنگلی بیل (Mimosa Scandeus)ادائیگی: { گَیل (ی لین) + ری }
 مکان یا کمرے وغیرہ کے آگے بنی ہوئی گزرنے یا بیٹھنے کی جگہ، راہداری، برآمدہ غلام گردش۔
 تنگ راستہ یا کمرہ جہاں عموماً تصاویر یا نوادرات کی نمائش یا فروخت ہوتی ہو، تصویر خانہ، نگار خانہ۔ادائیگی: { گے (ی لین) + لَن }
 سیال یا رقیق شے ناپنے کا پیمانہ جو عموماً دو سیر دس چھٹانک یا چار کوارٹ کے مساوی ہوتا ہے، مائعات کا پیمانہ۔جانا
پہلے خاوند کا وہ بچہ جسے عورت اپنے ساتھ دوسرے خاوند کی ہاں لائی ہو
پہلے خاوند کا وہ بچہ جسے عورت اپنے ساتھ دوسرے خاوند کے گھر لائی ہو
ساتھ کا بچہ
ربیب، گم،راہرو، مسافر،ادائیگی: { گی + لی }
 نم، تر، بھیگی ہوئی۔ادائیگی: { گی + لی + لَک + ڑی }
 نم لکڑی جس میں لچک ہوتی ہے، (مجازاً) قابل اصلاحی (بچہ) جس کی عادات پختہ نہ ہوئی ہوں اور اسے حسب منشا راستے پر لگایا جا سکتا ہے۔ادائیگی: { گی + لی + مِٹ + ٹی }
 گندھی ہوئی مٹی، پانی سے گارا کی ہوئی مٹی۔ادائیگی: { گی + لی + گی + لی }
 بھیگی ہوئی، بہت نم، بھیگی بھیگی۔واسوختَہ کی جمع دیکھیے واسوختَہادائیگی: { گیم (ی مجہول) }
 کھیل، بازی۔ادائیگی: { گے (ی لین) + نا }
 چھوٹے قد کا بیل، ٹھنگنا بیل۔ادائیگی: { گَے (ی لین) + نا }
 گہنا، زیور (سامان آرائش خصوصاً عورتوں کا)۔زمین کھودنے کے ایک نوکدار آہنی اوزار کا نام
کدال، کُدال، کسّی،زمین کھودنے کا ایک نوکدار اوزار
کدال، کسی،ایک قسم کا کھانا جو محرم میں پکتا ہے
ملیدا،ایک ہاتھ کے ساتھ سانی
