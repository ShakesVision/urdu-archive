اسپ (اقسام متفرقہ)، آب سیر و آب گرد و آب گردش و آب گردندہ ‏، اسپ تند رو، آہن خاے و آہن رگ‏ (اسپ قوی)، ابرش، ابلق، ارغوں، اسپ، اسپِ تنبل، اسپِ تُند رَو، اسپِ سرخ، اسپِ یدکی، استاغ، اسک، اشکل، اکدش، باد پا و باد تنگ بستہ، بارکی و بارہ ‏(اسپ باری)، بدلجام، بدلگام، بدو بردن، بہاز ‏(اسپ نگرد)، بور، بوز بوزک، بیدخ ‏(تیز رَو)، پالا، پالاد، پالادہ، پالائی، پائدار، پاےدارہ، پولادی خاد و پولاد رگ ‏(اسپ قوی ہیکل)، ترغ ‏(اسپِ کہر)، توسن ‏(اسپِ سرکش)، جردہ ‏(اسپِ اختہ و دو نسلہ)، جمزیور ‏(پچکلیاں)، جمند و جمندہ، جنیبت ‏(اسپِ یدک)، چار کاسہ و چار کامہ ‏(تُندرَو)، چاموش ‏(اسپِ سرکش)، چپار ‏(سیاہ)، چراغ پا و چراغ پایہ ‏(اچھلنے کودنے والا)، چرخ تیز رَو ‏(اسپ تُند رفتار)، چرمہ، چل ‏(آگے کا دایاں اور پیچھے کا بایاں پاؤں سفید ہو)، چمن و چمند و چمندہ ‏(اسپِ کند رفتار)، چموش ‏(سرکش)، چوگانی خنگ ‏(اسپِ سفید)، دندانِ بلند و دیو زاد ‏(قوی ہیکل)، راہ انجام و راہ نورد، راہ وار، راہ وارہ ‏(اسپِ تیز گام) رخ، رخت، رکاب، سَبُک پا، ‏(اسپِ تیز رو)، سَبُک خیز، سَبُک رفتار، سَبُک سنگ ‏(اسپِ تُند رفتار)، سَبُک سار، ستاغ ‏(اسپِ نازایندہ)، سرنگ، سکسک ‏(اسپِ تنبل)، سمند ‏(اسپِ جہندہ) شکل، شکیل، شولک، ‏(اسپِ تُندرَو) صرصر کوہ پیکر، کتل ‏(اسپِ بدک)، کلوس ‏(اسپِ جس کی آنکھیں، چہرہ، دہانہ سفید ہو، جو نحوست میں شمار ہوتا ہے)، کلیج و کلیجہ ‏(اسپِ کج دست و پا)، کہر ‏(سرخ رنگ کا) گامزن، کوتل ‏(اسپ پھرک) کود و کودن ‏(اسپ پالانی)، کودن و کودند، کورنگ ‏(مشہور زرد رنگ کا) کوہ روندہ، گیتی نورد، ماخچی ‏(جس کے ماں باپ ایک نسل سے نہ ہوں یا دونوں عربی نسل سے نہ ہوں)، منہ زور ‏(اسپِ سرکش)، نُقرہ خنگ (سفید)، نوند و نوندہ ‏(تیز رو)، نیلا ‏(رنگ مائل بہ سفیدی)، ہدنج و ہدنگ، ہیدخ و پیکر ‏(اسپ کہر)، یام ‏(اسپ چاپار خانہ) یک ران و یک رکابی
