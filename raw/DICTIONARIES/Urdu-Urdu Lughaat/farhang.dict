نیک۔ مبارک۔ سُبھ۔ طالع کی مناسبت۔ اقبال مندی۔ ستاروں کا اچھا اثر۔اِسم مُؤنّث
تگ و پو۔ دوڑ دھوپ۔ کوشش۔ تُندہی۔ سرگرمی۔ جانفشانی۔ جدوجہد۔ محنت۔ جتن۔ سفارش۔اِسم مُؤنّث
اُردو میں ایک دوسرے کا مترادف خیال کے بولتے ہیں۔ جدوجہد۔ کوششِ بلیغ۔فعل مُتعدّی
زور مارنا۔ کوشش کرنا۔ تگ و پو کرنا۔ سفارش کرنا۔صِفت
نیک ۔ مُبارک۔ بہرہ مند۔ کامیاب۔ نیک بخت۔ بھاگوان۔ خوش نصیب۔اِسم مُؤنّث
ایلچی گری۔ رسالت۔ وکالت۔اِسم مُؤنّث
سپُردگی۔ حوالگی۔ شفاعت۔ مدد۔ سہارا۔ کِسی شخص کو کِسی کے سپرد کرنا۔ ہاتھ میں ہاتھ دینا۔ تقریب ۔ وسیلہ۔اِسمِ مُذکّر
سفارشی خط۔ وہ چٹھی جس میں حامل کی تعریف اور اُس کے واسطے کِسی امر کی سفارش خواہ سعی ہو۔فعل مُتعدّی
شفاعت کرنا۔ وسیلہ کر دینا۔ رسائی کرنا۔ سعی کرنا۔ْاِسمِ مُذکّر
حمایتی گھوڑی۔ نالائق۔ بے ہُنر۔ بے جوہر آدمی۔اِسم مُؤنّث
سفارشی خط۔ وہ چٹھی جس میں حامل کی تعریف اور اُس کے واسطے کِسی امر کی سفارش خواہ سعی ہو۔اِسم مُؤنّث
ٹھیکری۔ اخروٹ۔ بادام۔ پستہ  وغیرہ کا خول۔صِفت
خونریز۔ قاتل۔ بے رحم۔ خونی۔اِسم مُؤنّث
خونریزی۔ بے دردی۔ بے رحمی۔صِفت
گاڑھا۔ دبیز۔ موٹا۔ مضبوط۔ مُحکم۔اِسمِ مُذکّر
مُسافرت۔ جاترا۔ سیاحت۔ روانگی۔ کوچ۔اِسم مُؤنّث
سُرنگ لگانے اور کھودنے کھادنے کا کام کرنے والی پلٹن۔اِسمِ مُذکّر
سیاحت نامہ۔ سفر کی کیفیت۔ روزنامچہ سفر۔صِفت
تجربہ کار۔ گھاٹ گھات کا پانی پیئے ہوئے۔اِسمِ مُذکّر
دستر خوان۔ توشہ دان۔ مقعد۔ گانّڑ۔صِفت
منسوب بہ سفر۔ سفر کی چیز۔ سفر سے متعلق۔ زادراہ۔اِسم مُؤنّث
ساتھ رہنے والی جورو۔ وہ بیوی جسے سفر میں ساتھ رکھیں۔اِسم مُؤنّث
نشیب۔ پستی۔ پھوک۔ فُضلہ۔اِسمِ مُذکّر
ایک تانبے کا اظرف جو امیروں کے دستر خوان پر اس لیے رکھا جاتا ہے کہ کھاتے وقت ہڈیاں یا کِسی چیز کا پھوک اُس میں دالتے جائیں۔ ہڈی دانی۔اِسم مُؤنّث
پاجی پن۔ سفلہ پن۔ کم ظرفی۔ اوچھا پن۔ پست حوصلگی۔ کمینہ پن۔صِفت
رذیل۔ کمینہ۔ پاجی۔ اوچھا۔ خفیف۔ سُبک۔ نالائق۔اِسمِ مُذکّر
کمینگی۔ پاجی پن۔ نالائقی۔ چھچھور پن۔صِفت
دانیٰ۔ علوی کی ضد۔ کم درجہ کا۔ گھٹیل۔اِسمِ مُذکّر
وہ منتر یا جادو جس میں شیطان یا روحانیاتِ ارضی سے استعانت کی جائے۔ کلامِ اِلٓہی یا بحر علوی کے سوا عمل۔ شیطانی عمل۔اِسمِ مُذکّر
بُرادہ۔ چُورن۔ پسی کُٹی دوا۔ پھنکی۔ پوڈر۔صِفت
سیاہ کا نقیض۔ سپید۔ اُجل۔ چٹّا۔ گورا۔ سادہ۔ بِن لکھا۔ خائف۔ خوف زدہ۔ سہمناک۔اِسمِ مُذکّر
منی۔ نطفہ۔اِسمِ مُذکّر
نیکی و بدی۔ بُرائی و بھلائی۔اِسمِ مُذکّر
وہ کبوتر جس کا رنگ سفید ، پوٹا کالا، دُم اور بازو کُچھ کالے اور کُچھ سفید ہوتے ہیں۔صِفت
سفید کپڑے پہننے والا۔ اُجلا رہنے والا۔ بھال مانس۔فِعل لازِم
مُنہ فق ہو جانا۔ چہرے کا رنگ اُڑ جانا۔ خُون خُشک ہو جانا۔ ہولیاں اُڑنے لگنا۔فعل مُتعدّی
اُجلا کرنا۔ دھولا کرنا۔ جوڑا بنانا۔اِسمِ مُذکّر
پُھکے ہوئے جست کا پھول جو اکثر آنکھوں کی دوا پڑتا ہے۔ ایک قسم کا پوڈر جو بارہ سنگے کے سینگ کو پُھونک کر بناتے  اور اُسے چھاچ میں ملا کر عورتیں مُنہ پر ملتی ہیں۔ مگر یہ دستور ایران کا ہے۔اِسم مُؤنّث
مُنہ پر ملنے کا پوڈر۔ قلعی۔ دیواروں پر پھیرنے کا نہایت سفید چونہ۔فِعل لازِم
بال سفید ہونا۔ بڑھاپا آنا۔ بوڑھا ہونا۔فِعل لازِم
مکان پر قلعی ہونا۔ چونہ پھرنا۔ صفائی ہونا۔اِسمِ مُذکّر
کشتی۔ ناؤ۔ جہاز۔ کتاب۔ اشعار۔ بیاض۔ سمن۔ اطلاع نامہ۔ حُکم طلبی۔صِفت
نادان۔ ناسمجھ۔ کم عقل۔ بیوقوف۔اِسم مُؤنّث
دولت چند روزہ۔ تھوڑے دن کی حکومت۔اِسمِ مُذکّر
پانی لانے والا۔ پانی پلانے والا۔ ماشکی۔ مشک اُٹھانے والا۔اِسمِ مُذکّر
دوزخ۔ نرگ۔ جہنم۔چوپایہ کی موت۔ گھوڑے یا گدھے کا مر جانا۔اِسمِ مُذکّر
وہ فرکاری فہرست یا رجسٹر جس میں رسالے کے مرے ہوئے گھوڑے درج ہوں۔اِسم مُؤنّث
مکان کی چھت۔ سائیبان۔ کوٹھا،۔ شامیانہ۔اِسم مُؤنّث
علت۔ بیماری۔ دُکھ۔ عیب۔ نُقص۔ خرابی۔فعل مُتعدّی
عیب نکالنا۔ نُقص نِکالنا۔اِسم مُؤنّث
پانی بھرنے والی عورت۔اِسمِ مُذکّر
ایک گوہ کے مُشابہ جانور کا نام ۔ یا وہ مچھلی جو ریت میں رہتی ہے۔اِسمِ مُذکّر
گر پڑنا۔ خطا کرنا۔صِفت
بیمار۔ علیل۔ مریض۔ روگی۔ عیب دار۔اِسم مُؤنّث
ایک مہلک مرض کا نام جس کے سبب پھیپڑے میں زخم ہو کر آدمی کے مُنہ سے خون آتا اور میں ناتواں ہو کر مر جاتا ہے۔ تپ کُہنہ۔ دِق۔ 

اِسم مُؤنّث
مصالحہ پیسنے کا چوڑا پتھر۔ پتھر کا پتلا اور چوڑا ٹکڑا جو عمارتوں میں لگایا جاتا ہے یا فرش میں بچھایا جاتا ہے۔اِسمِ مُذکّر
سِل لوڑھا پتھر کا چوڑا ٹکڑا اور اُس کے پیسنے کا چھوٹا ٹکڑا۔ سِلوٹ۔فعل مُتعدّی
جان گنوانا۔ خود کُشی کرنا۔ اپنے آپ مرنا۔ ۔ انتطامِ خانہ داری کرنا۔ گھر کا بندوبست کرنا۔فِعل لازِم
سلطنت سے بیٹھنا۔ اطمینان سے بیٹھنا۔ ٹھکانے سے بیٹھ جانا۔اِسمِ مُذکّر
وہ اناج کی بالیں جو از خود گِر پڑتی یا کھیت کٹ جانے کے بعد پڑی رہ جاتی ہیں اُن کے چُننے کا سِلّا کہتے ہیں۔ 

صِفت
دس۔ عشرہ۔ دہ۔ ۱۰۔فعل مُتعدّی
خوشہ چینی کرنا۔ بالین بنینا۔فعل مُتعدّی
بچہ کو بہلا کر سُلا دینا۔ زہر کھلا کر مار دینا۔ مار ڈالنا۔ گھلا گھونٹ دینا۔اِسمِ مُذکّر
سِلّا بنینے والا۔ خوشہ چین۔اِسم مُؤنّث
سِلوانے کی اُجرت۔ ٹانکا۔ ایک کیڑے کا نام جو اکثر ایکھ  مکئی یا جوار کو لگ جاتا ہے ۔ سینا۔ 

اِسم مُؤنّث
سیلِ سُرمہ۔ سُرمہ لگانے کی پتلی اور گول سلاخ۔ ایک جراحی آلہ کا نام جس کے ذریعہ سے پیشاب لاتے یا کسی زخم میں دوا پُہنچاتے ہیں۔ سینک۔ پتلی سلاخ۔ ککڑی کے اندر رکھنے کی پتلی سینک جو اکثر لوہے کی ہوتی ہے۔ موٹا سوٹا۔ ٹاٹ سینے کا سُوا۔فعل مُتعدّی
گرم سلائی کے ذریعے اندھا کرنا۔ تیل کی سلائی سے اندھا کرنا۔ پٹم کرنا۔ آنکھیں  پھوڑنا۔ نورِ بصر کو زائل کرنا۔فِعل لازِم
اندھا یا معدوم البصر کیا جانا۔ آنکھیں پھوڑی جانا۔فعل مُتعدّی
آنکھیں پھوڑنا۔اِسمِ مُذکّر
روحِ حجر۔ پہاڑ کا پسینہ۔ ایک سیاہ رنگ پیشاب کی سی بو والے رقیق مادے کا نام جو پہاڑ میں سے ازخود ٹپکتا اور چوٹ پھیٹ توت باہ و اعصاب میں گرمی بہم پُہنچانے کے کام آتا ہے۔اِسمِ مُذکّر
آلۂ جنگ۔ لڑنے کے ہتھیار۔ راچھ۔ اوزار۔  قانون۔صِفت
ہتھیار بند۔ مُسلح۔ پانچوں ہتھیاروں سے لیس۔اِسمِ مُذکّر
ہتھیار گھر۔ شستر شالا۔ دار السّلاخ۔ وہ مکان جہاں ہتھیار جمع رہیں۔ میگزین۔اِسمِ مُذکّر
ہتھیار بنانے والا۔ زرہ فروش۔اِسم مُؤنّث
سلائی۔ میخ۔ لوہے کی گول چھڑی۔اِسمِ مُذکّر
دیکھو ( سلاجیت)۔ الائچی کا تیل۔اِسم مُؤنّث
سلسلہ کی جمع۔ بیڑیاں ۔ زنجیریں۔ لڑیاں۔اِسمِ مُذکّر
سلطان کی جمع۔ بہت سے بادشاہ۔ قیصر۔ شہزادے۔ پہلے بادشاہوں کی اولاد۔ سُلطانِ وقت کی اولاد سے غیر۔اِسمِ مُذکّر
گردن جُھکانا۔ تسلیم کرنا۔ تحیّت۔ کورنش۔ بندگی۔ پرنام۔ رام رام۔ دعا۔ سلامتی۔ امن۔ معاف رکھئے۔ خاتمۂ نماز کا پہلا خواہ دوسرا سلام۔ رخصت۔ جایئے۔فعل مُتعدّی
رخصت کرنا۔ دور کرنا۔ چھوڑا۔ الگ کرنا۔  خُدا حافظ کہنا۔ زبانی رسید دینا۔اِسمِ مُذکّر
سلام کا خواہاں ۔ سلام کی تمنّا رکھنے والا۔اِسم مُؤنّث
تو سلامت رہے۔ رام رام۔۔ بندگی۔ آداب۔ کورنش۔ صاحب سلامت۔ شناسائی۔ مُلاقات۔نِدا
تُمہارے اُوپر سلامتی ہو۔ تُم جیتے رہو۔ جب کوئی شخص مجلس میں آتا ہے یا رخصت ہوتا ہے تو یہ کلمہ زبان پر لاتا اور اس کے جواب میں دوسرا وعلیکم السلام کہتا ہے۔فِعل لازِم
سلام کا جواب دینا۔ سلام قبول کرنا۔ وعلیکم السلام کہنا۔فِعل لازِم
خاتمۂ نماز پر دائیں اور بائیں جانب باری باری سے مُنہ پھیر کر السلامُ علیکم ورحمتہ اللہ کہنا۔ نماز ختم کرنا۔اِسمِ مُذکّر
نسبت کی بابت ذکر اذکار ۔ منگنی کی چھیڑ چھاڑ۔ بات چیت۔فِعل لازِم
ناراضی کے ساتھ رخصت ہونا۔اِسم مُؤنّث
سلامی۔ وہ نقدی جو دُلہن کی طرف کے رشتہ دار دولہا کو بوقت رخصت دیتے ہیں۔فعل مُتعدّی
سر یا ماتھے یا سینے پر ہاتھ رکھنا۔ بندگی کرنا۔ تسلیم کرنا۔ آداب بجا لانا۔ گُڈ مورننگ کہنا۔ مُجرا کرنا۔ رُخصت ہونا۔ جانا۔ وداع ہونا۔ کِسی کی اُستادی، ہُنر مندی یا چالاکی کو تسلیم کرنا۔ ہار ماننا۔ قبول کر لینا۔ دست بردار ہونا۔ معافی چاہنا۔ چھوڑنا۔ خُدا حافط یا خیر باد کہنا۔فِعل لازِم
مُجرا ہونا۔ درشن ہونا۔ ملاقات ہونا۔ رُوبرو ہونا۔ سامنے ہونا۔مُحاورہ
باز آئے۔ چھوڑا۔ ترک کیا۔ معاف رکھئے۔ بڑے بے ڈھب ہو۔ تم سے تو خُدا بچائے۔اِسم مُؤنّث
روانی۔ ہمواری۔ نرمی۔ ملائمت۔ آسانی۔ سہولت۔ الفاظ کا نہایت سہولت اور آسانی سے اس طرح ادا کرنا کہ جس میں کوئی ثقیل لفظ نہ آئے۔ سادگی۔ فصاحت۔ 

صِفت
محفوظ۔ مامون۔ آفت و صدمات سے بری۔ صحیح۔ تندرست۔ زندہ۔ باحیات۔  پورا۔ کامل۔ ثابت۔ سالم۔ سلامتی۔ اطمینان۔ مبارکباد کی قبولیت۔صِفت
کفایت شعار۔ کم خرچ۔ میانہ رو۔ چلن سے چلنے والا۔ متوسط درجہ پر کار بند ہونے والا۔ مُدبّر۔ منتظم۔اِسم مُؤنّث
کفایت شعاری۔ میانہ روی۔ کم خرچی۔ نیک چلنی۔ طریقۂ خانہ داری۔ بندوبست۔ انتظام۔ انصرام۔ سیدھا راستہ۔فعل مُتعدّی
چلن سے چلنا۔ کفایت شعاری سے بسر کرنا۔ میانہ روی اختیار کرنا۔ بڑھ کر نہ چلنا۔ نیک چلنی اختیار کرنا۔فِعل لازِم
زندہ رہنا۔ جیتے رہنا۔ تندرست رہنا۔ صحیح سالم۔ مامون رہنا۔ امن میں رہنا۔ موجود رہنا۔ آباد رہنا۔ ثابت رہنا۔ جوں کا توں رہنا۔ کامل اور پورا رہنا۔اِسم مُؤنّث
نرم کلامی۔ شیریں گفتاری۔ فصاحت۔اِسم مُؤنّث
بے گزندی۔ حفاظت۔ بچاؤ۔ خیریت۔ عافیت۔ کُسل۔ فضلِ اِلٓہی۔ صحت۔ تندرستی۔ زندگی۔ قیام۔ برقراری۔ ایک قسم کا موٹا کپڑا۔تابع فِعل
خُدا کے فضل سے۔ خُدا کی عنایت سے۔ خیریت سے۔ تندرستی سے۔تابع فِعل
حیات میں۔ زندگی میں۔ نوجودگی میں۔ عہد میں ۔فعل مُتعدّی
