وہ جگہ جہاں منشی ۔ متصدی، حاکم ، عامل بیٹھ کر لشکر کا حساب کتاب اور مقدمات کی تحقیقات کریں۔ دفتر خانہ۔ دیوان۔ حساب گاہ۔ عمل خانہ۔ دربار۔ انصاف گاہ۔ دربار شاہی۔فعل مُتعدّی
دربار بڑھانا۔ اجلاس بند کرنا۔فِعل لازِم
دربار اُٹھنا۔ عدالت بند ہونا۔ دفتر بند ہونا۔ تعطیل ہونا۔فعل مُتعدّی
اجلاس کرنا۔ غل مچانا۔ شور کرنا۔ مجمع کرنا۔فِعل لازِم
عدالت تک جانا۔ عدالت میں جانا۔فعل مُتعدّی
عدالت میں بیٹھ کر مقدمات کا طے کرنا۔ راج دربار لگانا۔ اجلاس کرنا۔اِسمِ مُذکّر
عملۂ عدالت اور وہاں کے چپراسی وغیرہ جو رشوت کے لئے مستغیث کے پیچھے پڑ جاتے اور بغیر لئے کُتّے کی طرح ٹانگ لیتے ہیں۔اِسم مُؤنّث
کچّا کی تانیث۔اِسمِ مُذکّر
غیر مورثی زمیندار۔ چند روزہ زمیندار۔ غیر مورثی جوتا۔ عارضہ جگہ۔ غیر مستقل ملازمت۔اِسم مُؤنّث
وہ اینٹ جسے مزادے میں نہ پکایا ہو۔ دھوپ کی سوکھی اینٹ۔اِسم مُؤنّث
روز نامچہ۔ کھاتہ۔ رف۔ وہ بہی جس میں رقم کے کم و بیش کرنے  اور کسی بات کی غلطی درست کرنے کا اختیار ہے۔ اور بطور مسودہ تیار کی جاتی ہے۔اِسم مُؤنّث
ہری ترکاری۔ سبز ترکاری۔اِسم مُؤنّث
کچّے بٹوں کے موافق وزن۔ کچے وزن کے حساب سے۔اِسم مُؤنّث
وہ رسوئی جسے چوکے سے باہر نہ کھا سکیں۔ بِن گھی کی روٹی۔کہاوت
نادان اور ناتجربہ کار کی صحبت میں بدنامی اور افشائے راز کا اندیشہ ہوتا ہے۔اِسم مُؤنّث
تیپچی۔ لنگر۔فعل مُتعدّی
لنگر ڈالنا۔ کھرا کرنا۔ تگیانا۔اِسم مُؤنّث
ریتے کی سڑک۔ وہ سڑک جس پر کنکر وغیرہ کوٹ کر زمین کو سخت اور پختہ نہ کیا ہو۔اِسم مُؤنّث
بالی عمر۔ زمانہ طفلی۔ناتجربہ کاری اور ناسمجھی کی عمر۔اِسم مُؤنّث
میعادِ باقی۔ ہنوز میعاد کا وقت باقی ہو۔فِعل لازِم
بلوغت سے پیشتر ازالۂ بکر ہونا۔ چھوٹی سی عمر میں سر ڈھکا جانا۔اِسم مُؤنّث
مقدمہ کی اوّل شنوائی جس میں اپیل کی منظوری یا نا منظوری کا حال معلوم ہوتا ہے۔اِسم مُؤنّث
کھری چاندی کا نقیض۔اِسم مُؤنّث
شگوفۂ کام۔ غُمچۂ ناشگفتہ۔ مُنہ بند کلی۔ ( بازاری) دوشیزہ۔ باکرہ۔ کنّیا۔ اچھوتی۔ اَن بندھا موتی۔ چیرہ بند۔ نابالغہ۔فِعل لازِم
عمر طبعی سے پہلے مر جانا۔ چھوٹی عمر میں مر جانا۔فِعل لازِم
مٹی کی بن پکائی گولیوں سے کھیلنا جو جلدی ٹوٹ جاتی ہے۔ نادان ہونا۔ ناتجربہ کار ہونا۔ ناآزمودہ کار ہونا۔اِسمِ مُذکّر
وہ شخص جو ذرا سے خوف کے باعث اپنے ارادے سے باز رہ جائے۔ بودا۔ ڈرپوک۔ کچ دلا۔ کم حوصلہ۔فِعل لازِم
کچّا ہو جانا۔ ہمت ٹوٹ جانا۔ ڈر جانا۔ دل چھوٹ جانا۔ شرما جانا۔ جھیپ جانا۔صِفت
مَیلا کا مترادف۔اِسم مُؤنّث
کُچ کی جمع۔ چھاتیاں ۔ چوچیاں۔ پستان زنان۔اِسمِ مُذکّر
کچّا کی جمع۔اِسمِ مُذکّر
حمل کے چوتھے پانچویں مہینے تک کا زمانہ جس میں بڑی احیتاط لازم ہے۔فعل مُتعدّی
دشوار اور ناممکن کام کرنا۔ سخت مشکل یا تکلیف اُٹھانا۔ سخت مصیبت جھیلنا۔فِعل لازِم
شراب یا تاڑی وغیرہ سے نہایت بدمست ہونا۔ نشہ میں غرقاب ہونا۔ پاگل ہونا۔ دیوانہ ہونا۔ بہکنا۔ سر پھرنا۔صِفت
بے ٹھور۔ بے ڈھب۔ بے موقع۔ بے ربط۔ زبون۔ زشت۔ بد۔ بُری۔صِفت
بے ڈھنگا۔ بد سلیقہ۔ وحشی۔ جانگلو۔ بد اطوار۔ بد اخلاق۔صِفت
اکھڑ۔ بد مزاج۔ بد اطاوار۔ بد چلن۔اِسمِ مُذکّر
سونتیلا بیٹا۔ فرزند زن۔اِسمِ مُذکّر
کسوم کے بیج۔ حب العصفر۔ کاجیرہ۔ 

صِفت
کیڑے کا مخفف۔ کرم۔صِفت
کیڑوں کا کھایا ہؤا۔ بوسیدہ ۔ پُرانا۔ چیچک رو۔ آبلہ رو۔ کوچا کریلا۔اِسمِ مُذکّر
گرانی۔ مہنگا۔ قحط کا زمانہ۔ کال کے دن تنگی کا زمانہ۔فعل مُتعدّی
لداؤ کا مکان بنوانا۔ لداؤ کی چھت ڈالنا۔اِسمِ مُذکّر
سختی۔ کرختگی۔ مضبوطی۔ بہادری۔ شجاعت۔ تیزی۔ تند مزاجی۔فعل مُتعدّی
سخت کرنا۔ اینٹھنا جیسے جسم کڑا کرنا۔ بہاؤ تیز کرنا۔ مضبوط کرنا۔ مستحکم کرنا۔ چُست کرنا۔ کسنا۔ سختی جھیلنا۔ برداشت کرنا۔فِعل لازِم
سخت ہونا۔ کٹھن ، دشوار اور مشکل ہونا۔ گراں ہونا۔ اکرا ہونا۔ مہنگا ہونا۔ بھاؤ تیز ہونا۔ تند مزاج ہونا۔ سنگدل ہونا۔ بے رحم ہونا۔صِفت
نرم کا نقیض۔ سخت۔ کرخت۔ شدید۔ سخت گیر۔ بے رحم۔ کٹھور۔ تیز مزاج۔ مضبوط، کرارا۔ روکھا۔ پُر شہوت۔ برداشت کنندہ۔ سہارنے والا۔ زحمت کش۔ کٹھن۔ دشوار۔ مشکل۔ بہادر۔ سورما۔اِسمِ مُذکّر
دیکھو ( کراڑا)۔اِسمِ مُذکّر
کسی سخت چیز کے ٹوٹنے کی آواز۔ فاقہ۔ بھوکا رہنا۔ سخت۔ شدت کا۔فِعل لازِم
فاقہ ہونا۔ بھکا ہونا۔ نامیسری کے سبب کچھ نہ کھانا۔اِسمِ مُذکّر
کسی سخت چیز کے ٹوٹنے یا بجنے کی متواتر آواز۔اِسمِ مُذکّر
کڑاکا کی جمع۔اِسمِ مُذکّر
سخت جاڑا۔ شدت کا جاڑا۔اِسمِ مُذکّر
سخت فاقہ۔اِسمِ مُذکّر
بڑی کڑاہی۔ کڑھاؤ۔ حلوا پکانے یا کچوریاں وغیرہ تلنے کا بڑا ظرف۔ موہن بھوگ۔ میٹھا۔اِسم مُؤنّث
کڑھائی کی پوجا جو کسی شادی یا تہوار میں اول ہی اول چڑھانے پر کی جاتی ہے۔اِسم مُؤنّث
ایک پھیلے ہوئے آہنی ظرف کا نام  جا میں پکوان وغیرہ تلتے اور دودھ اونٹاتے ہیں۔ تر حلوا۔ میٹھا۔ پکوان یا شرینی کی نیاز۔ پکوان تلی ہوئی چیز۔فعل مُتعدّی
منتر کے زور سے کڑائی کو گرم نہ ہونے دینا۔ جادو سے کڑھائی کے نیچے کی آگ کو بے اثر کر دینا۔فعل مُتعدّی
کڑاہی سرکانا۔فعل مُتعدّی
اپنی صداقت اور بیگناہی کا امتحان دینا۔ جلتے ہوئے تیل میں ہاتھ ڈال کر رکھ دینا کہ ہم سچے ہوں گے تو ہاتھ نہیں جلے گا۔فعل مُتعدّی
کسی چیز کے تلنے یا جوش دینے کے واسطے کڑائی کو چولہے پر رکھنا۔ پکوان کرنا۔ پکوان پکانا۔فِعل لازِم
کڑاہی کا چولہے پر رکھا جانا۔ پکوان کی تیاری ہونا۔ پکوان کا تلا جانا۔ شادی کے خانوں اور ضیافت کا سامان ہونا۔فعل مُتعدّی
پکوان تلنا۔ پوریاں کچوریاں اور گلگلے وغیرہ تلنا۔ کسی دیوی یا دیوتا کی بھنٹ کا حلوا پکانا۔اِسمِ مُذکّر
وہ شخص جس کی داڑھی کڑبڑی ہو۔ ادھیڑ۔ چال۔ موخودا۔اسمِ مُذکّرُ
ابردباد ۔ بونڈبانڈی ۔ بد نظمی ۔ جھگڑا ۔اِسم مُؤنّث
وہ داڑھی جس میں سیاہ اور سفید بال ہوں۔ ریش دو مُو۔اِسم مُؤنّث
دیکھو ( کڑوی)۔اِسمِ مُذکّر
وہ شخص جو سخت گو، سخت کلام اور نہایت توانا اور قوی  ہو۔صِفت
تلخ۔ مُرّ۔ نیم کے مزے کا جیسے میٹھا میٹھا ہپ ہپ کڑوا کڑوا تھو تھو۔  تیز ۔ چرپرا۔ حلق پکڑنے والا۔ ململا۔ نمک کے مزے کا۔ بد مزاج۔ تند مزاج۔ غصیل۔اِسمِ مُذکّر
روغن تلخ۔ ترے یا سرسوں وگیرہ کا تیل۔فعل مُتعدّی
کسالا کرنا۔ سختی جھیلنا۔ دل کو سخت کرنا۔ ناگوار بات یا چیز کی برداشت کرنا۔صِفت
زہر ہلاہل۔ نہایت تلخ۔ نیم سا کڑوا۔ زہر کی مانند کڑوا۔فِعل لازِم
تلخ معلوم ہونا۔ ذائقہ میں بُرا معلوم ہونا۔ ناگوار گزرنا۔ زہر معلوم ہونا۔اِسمِ مُذکّر
دیکھو ( کڑوا زہر)۔ نر نیم جو نہایت کڑوا  اور بڑی عمر کا ہوتا ہے۔اِسمِ مُذکّر
نہایت بد مزاج آدمی۔کہاوت
ایک تو بد مزاج تھا ہی دوسری بات نے اور بھی ترقی دے دی ۔ تلخی میں تلخٰ یا خرابی میں خرابی۔صِفت
تلخ اور ناگوار طبع۔ ناقابل برداشت۔فِعل لازِم
کسی چیز کا تلخ اور بد مزاہ ہونا۔ آزردہ ہونا۔ خافا ہونا۔ ناراض ہونا۔ بگڑنا۔ بد مزاج ہونا۔ بد مزاجی ظاہر کرنا۔ جھلّا ہونا۔ گصیل ہونا۔فِعل لازِم
کڑوا ہونا۔ تلخ ہونا۔ بگڑنا۔ خفا ہونا۔ بد مزاجی برتنا۔ نیند کے باعث آنکھوں میں خارشت سی معلوم ہونا۔اِسمِ مُذکّر
تلخی۔ بد مزاجی۔ تیزی۔ تندی۔اِسمِ مُذکّر
وہ شخص جو عاملوں اور محصلوں پر خیانت کی بگرانی کے واسطے کوئی حاکم مقرر کرے۔ افسروں کا افسر۔ حاکموں کا حاکم۔اِسم مُؤنّث
کڑبی۔ باجری یا مکئی کی چری۔ 

اِسم مُؤنّث
کڑوا کی تانیث۔ تلخ۔ میٹھی کا نقیض۔ تند۔ تیز۔ ناگوار طبع ابات۔اِسم مُؤنّث
ناگوار بات۔ سخنِ تلخ و ناملائم۔اِسم مُؤنّث
مُردے کی حاضری۔ جس روز کوئی مر جائے اس روز کا کھانا۔ مرنے کا کھانا،۔اِسم مُؤنّث
ناگاہِ خشم آلودہ۔ خفگی کی نظر۔صِفت
کڑوا کی جمع۔اِسمِ مُذکّر
بُرے بھلے دن۔ سختی کے دن۔ مصیبت کے دن۔ منحوس دن۔ تنگی کا زمانہ۔ افلاس کے دن۔ بیماری کا موسم۔ ھمل کا آٹھواں مہینہ جو خطرناک ہوتا ہے۔فعل مُتعدّی
مصیبت کا بپتا کے دن بھرنا۔ بدبختی کا زمانہ گزارنا۔اِسمِ مُذکّر
مشکل و ناگوار بات۔ کارِ سخت۔ کٹھن کام۔اِسم مُؤنّث
بجلی کی آواز۔ خروش برق۔ آواز مہیب و سخت۔  کسی سخت چیز کے توٹنے کی آواز۔ گھوڑے کی سرپٹ چال۔ بجلی۔ برق۔ 

اِسم مُؤنّث
وہ مُرغی جو انڈے دینے سے رُک گئی ہو۔ مست مُرغی۔اِسم مُؤنّث
توڑے وار بندوق۔ وہ بندوق جس کی آواز نہایت مہیب ہو۔ کڑاکے کی آواز والی عورت۔ رعب داب کی عورت۔فِعل لازِم
خالی جانا۔ ناغہ ہونا۔فِعل لازِم
سر پٹ جانا۔ پویہ جانا۔ْفِعل لازِم
کڑاکے کی آواز نکالنا۔ مہیب آواز سے بات کرنا۔ سخت آواز سے بولنا۔فِعل لازِم
مُرغی کا انڈے دینے سے باز رہنا۔اِسمِ مُذکّر
کراکا۔ آوازہ۔ وپ آواز جو نقیب لوگ بادشاہ کی سواری کے آگے آگے چلتے یا میادانِ جنگ میں بہادروں کو سناتے ہیں۔صِفت
تڑخ جانے والا۔ شکن پڑ اجانے والا۔ 

فِعل لازِم
تڑخنا۔ تڑکنا۔ چٹکنا۔ موتی گرجنا۔ موتی کا ٹوٹ جانا۔ موتی میں درز پڑ جانا۔ موتی میں بال آ جانا۔ چُرمُر ہونا۔ 

فِعل لازِم
گرجنا۔ بجلی کی آواز نکالنا۔ برق کا خروش اور رعد کا شور کرنا۔ گڑگڑانا۔ کڑاکے کی آواز بولنا۔ چیخ کر بولنا۔ نوبت کا زور کے ساتھ بجنا۔ کافور ہونا۔ روانہ ہونا۔فِعل لازِم
کسی سخت چیز کا چاباتے وقت آواز دینا۔فعل مُتعدّی
کسی چیز کو اس طرح چبانا کہ جس سے ادانتوں کی آواز نکلے۔اِسمِ مُذکّر
سرماے سخت۔ شدت کا جاڑا۔ نہایت زور کی سردی۔فِعل لازِم
انڈے دینے کے دنوں میں مرغی کا بولنا۔  انڈا دیتے وقت بولنا۔ گرہ چیدن۔ بُڑبڑانا۔ کوسنا۔ بددعا دینا۔ ھسد کرنا۔ رشک کھانا۔ بُرا بھلا کہنا۔ 

فِعل لازِم
گھی یا تیل کے بگھارنے کی آواز نکلنا۔ گھی کے داغ ہونے کی آواز نکلنا۔ داغ کرنا۔ بگھارنا۔ خوب پکانا۔فعل مُتعدّی
حقہ کا زور سے دم لگانا۔ کش لاگانا۔ کش کھینچنا۔ حقہ کا دم مارنا۔اِسمِ مُذکّر
کڑکا کہنے والا بھاٹ۔ نقیب۔ چاوش۔ رزمیہ داستانیں گا کر سنانے والا۔ ساکھا گانے والا۔صِفت
کشیدہ۔ کشیدہ کیا ہؤا۔ اُبلا ہؤا دودھ۔ جوش دیا ہؤا۔ مقطر کیا ہو۷ا۔ بھبکے کے وسیلہ سے نکالا ہؤا۔اِسم مُؤنّث
کڑھایا کی تانیث۔فعل مُتعدّی
رنجیدہ کرنا۔ ملول کرنا۔ غمگین کرنا۔ رنج دینا۔ کلپانا۔ رنج اُٹھانا،۔ غم اُٹھانا۔ افسوس دلانا۔ سوچ دینا۔ چیتا پیدا کرنا۔ ناراض کرنا۔ رنج دے کر جلانا۔فِعل لازِم
رنجیدہ ہونا۔ ملول ہونا۔ دل دُکھنا۔ دوسرے کے واسطے اندوہگین ہونا۔ درد آنا۔ رحم آنا۔ سوچ کرنا۔ افسوس کرنا۔ غم کھانا۔ رحم کھانا۔ درد مندی ظاہر کرنا۔ ہمدردی کرنا۔ 

فِعل لازِم
نکلنا۔ باہر آنا۔ کشید ہونا۔ کشیدہ کاری ہونا۔ دودھ جوش ہونا۔ دودھ اُبلنا۔فِعل لازِم
غمگین اور آرزدہ کاطر ہونا۔ جدائی میں رونا۔فعل مُتعدّی
کشیدہ کڑھوانا۔ نکلوانا۔ کچھ چیز رکھ کر قرض لینا۔اِسم مُؤنّث
ایک قسم کے لادن یا نان خورش کا نام جو بیسن کو دہی یا چھاچھ میں لتھ کر پکائی جاتی ہے۔ اور اس میں ہلدی ، مرچیں ، گرم مصالح اور پھلکیاں وغیرہ ڈالتے ہیں۔ اس کا اآبال مشہور ہے کہ ایک دفعہ ہی آتا ہے اور دفعتہً چلا جاتا ہے۔کہاوت
اچھی بات می ں کچھ نقص۔اِسمِ مُذکّر
جدل فرو ہو جانے والا غصہ یا ارادہ۔اِسم مُؤنّث
مُرغ یا مُرغی کے ہنکانے کی آواز۔ پنجاب میں لڑکی کو کہتے ہیں۔ 

صِفت
کڑاکی کی تانیث۔ سخت۔ کرخت۔ درشت۔ مضبوط۔ مستحکم۔ ناملائم ۔ دل کو بُری لگنے والی۔ تُند۔ تیز۔ زحمت کش۔ صعوبت کش۔ کٹھن۔ مشکل۔ بھاری۔ دشوار۔ قہر آلود۔ غضبناک۔ خشمناک۔فِعل لازِم
چشم قہر یا غضب آلود کا پڑنا۔ قہر کی نظر پڑنا۔فعل مُتعدّی
سختی جھیلنا۔ صعوبت کی برداشت کرنا۔ سخت بات سہنا۔ مصیبت جھیلنا۔اِسم مُؤنّث
سخنِ سخت۔ کلامِ زشت۔ ناملائم بات۔اِسم مُؤنّث
زبانِ سخت۔فعل مُتعدّی
دیکھو ( کڑی اُٹھانا)۔اِسم مُؤنّث
سخت زمین۔ وہ سرزمین جہاں کے آدمی مضبوط ہوں۔ بھوت پریت کے رہنے کی زمین۔اِسم مُؤنّث
شدت کی دھوپ پڑنا۔ تیز دھوپ پڑنا۔فعل مُتعدّی
سخت بات کہنا۔ ناملائم بات کہنا۔ ناگوار طبع سخن زبان پر لانا۔فعل مُتعدّی
دیکھو ( کڑی اُٹھانا)۔اِسم مُؤنّث
منزل سخت۔ راہِ دشوار گزار۔اِسم مُؤنّث
ضربِ شدید۔ صدمۂ سخت۔فِعل لازِم
چوب سقف کا چٹخنا یا آواز دینا۔ جو صاحب خانہ کے واسطے منحوس خیال کیا جاتا ہے۔اِسم مُؤنّث
کمانِ سخت جو بہت زور سے کھینچی جاتی اور اس کا تیر نہایت دور اور زور سے اُرا ہؤا جاتا ہے۔صِفت
نہایت تیز رفتار اور زودرد۔اِسم مُؤنّث
مُرغیوں کے ہنکانے کی آواز۔فعل مُتعدّی
سخت بات کہنا۔ کلام سخت و درشت زبان پر لانا۔ ناملائم بات سُنانا۔فعل مُتعدّی
کوئی سخت بات زبان سے نکال دینا۔ دل دُکھانے والی بات کہ دینا۔اِسم مُؤنّث
کری کی جمع۔ چھت کے شہتیر۔ حلقے۔اِسمِ مُذکّر
آگ کا بڑا ٹھیکرا۔ وہ اوپر سے ٹوٹا ہؤا مٹکا جس میں آگ دبا کر رکھتے ہیں۔اِسمِ مُذکّر
قدآور جوان۔ گراں ڈیل یا گبرو جوان۔ پچ ہتّا جوان۔ زور آور آدمی۔ پہلوان آدمی۔اِسمِ مُذکّر
باورچی۔ طباخ۔ کھانا پکانے والا۔اِسمِ مُذکّر
دیکھو ( کُک)۔اِسمِ مُذکّر
سورج۔ برہما۔ وشنو۔ کام۔ خواہش نفسانی۔ اگنی۔ پون۔ موت۔ آتما۔ راجہ۔ بادشاہ۔ مور۔ طاؤس۔ سریر۔ جس، کال۔ دھن۔ دولت۔ شبد۔ آواز۔ ظہور۔ ہوشیار۔ سُکھ۔اِسم مُؤنّث
ایک قسم کا بغلی پھوڑا۔ وہ گِلٹی جو بغل میں ہو جاتی ہے۔ کچھرالی۔ بغلک۔ ککھوالی۔اِسمِ مُذکّر
فعل بد۔ پاپ۔ گناہ۔ حرام۔ چھنالا۔صِفت
بدکار۔ زانی۔ پاپی۔اِسمِ مُذکّر
ایک درخت اور اُس کے پھل کا نام جو مزے میں ترش اور رنگ میں سُرخ ہوتا ہے۔ لوگ اس کا اچار ڈالا کرتے ہیں۔اِسمِ مُذکّر
مرغ۔ مرغا۔ خروس۔ 

اِسمِ مُذکّر
پینے کا بنا ہؤا تمباکو۔ ایک قسم کا پینے کا تمباکو جو گیلے اور سوکھے تمباکو کو ملا کر جلد سلگ جانے کی غرض سے بھربھرا بنایا جاتا ہے۔ مٹی کا بڑا حُقہ۔ دبلا پتلا اور حقیر آدمی۔اِسمِ مُذکّر
بہت حقہ پینے والا۔اِسمِ مُذکّر
وہ جگہ جہاں عال لوگ بیٹھ کر حُقہ پیتے ہیں۔ دائیرہ۔ بھنگیر خانہ۔ بھٹیار خانہ۔ بری جگہ۔ بری سنگت۔اِسمِ مُذکّر
وہ شخص جو بازاروں مجمعوں اور میلوں میں لوگوں کو دام لے کر حقہ پلاتا پھرے۔ بازاری آدی کو حقہ پالانے والا۔ ذلیل و خوار آدمی۔اِسمِ مُذکّر
حُقہ مخصوص کا کش۔ بُرے حقے کا گھونٹ۔اِسم مُؤنّث
مرغ کے بولنے کی آواز۔ مرغ کی آذان۔ بانگِ خروساِسم مُؤنّث
خیار۔ خیارزہ۔ گلوندہ۔ ایک قسم کی ترکاری جسے کھاتے اور پیتے ہیں۔ لمبی اور حلقہ دار ہوتی ہے۔ 

اِسم مُؤنّث
سوت کی بیضووی پیچک۔ کچے سوت کی لچھی جو تکلے کے وسیلہ سے بنائی جاتی ہے۔ انٹی۔ مکئی کا بھٹا۔ مرغی ۔ ماکیاں ۔ آکھ کا ڈوڈا۔اِسمِ مُذکّر
ادنےٰ چور۔ خفیف چوری کرنے والا۔ چھوٹی چیز کا چور۔اِسمِ مُذکّر
بے انصافی اور نا پرساں حالی کے سبب ادنےٰ قصور پر بڑی سزا ملنا۔ اندھیر ہونا۔ اندھیر نگری چوپٹ راج ہونا۔فعل مُتعدّی
نہایت بیدردی اور کثرت سے کوسنا۔ ہر وقت اور ہر گھڑی بیدقدری کے ساتھ کوسنا۔ بات بات پر کوسنا۔اِسمِ مُذکّر
تخم خیارین۔مُحاورہ
ادنےٰ قصور پر بڑی سزا نہیں دیتے۔ چھوٹی سی خطا پر بڑی سزا نہیں چاہئے۔فِعل لازِم
سمٹ کو ذرا سا ہو اجانا۔ امچور ہو جانا۔ اینٹھ جانا۔اِسم مُؤنّث
دیکھو ( ککرالی)فِعل لازِم
بندر کا چلّانا۔ کوکنا،۔ چنگھاڑنا۔ کلکاری مارنا۔اِسم مُؤنّث
کنارہ۔ کور۔ حاشیہ۔ لب۔ حد۔ مکان کی کنگنی۔ دھار۔ باڑھ۔فِعل لازِم
نگل جانا۔ چٹ کر لینا۔ ہڑپ کر لینا۔ چبا ڈالنا۔ غبن کر لینا۔ اُٹھ جانا۔ تباہ کر دینا۔ اُجاڑ دینا۔ ویران کر دینا۔ خاک میں ملا دینا۔فعل مُتعدّی
پرایا مال ہضم کر کے خیر نہ ہونا۔ بالکل ہضم کر جانا۔ پچا لینا۔کہاوت
خندق۔ وہ گڑھا جو قلعہ یا شہر پناہ خواہ باغ کے گردا گرد کھود دیتے ہیں۔ سلامت کوچہ۔اِسم مُؤنّث
وہ میلا ور گھورا وغیرہ جسے گڑھا کھود کر دبا رکھتے اور کچھ عرصہ کے بعد نکال کر کھیتوں میں ڈالتے ہیں جس سے زمین کی طاقت بڑھتی ہے۔اِسمِ مُذکّر
روز نامچہ۔ روز مرہ کے حساب کی کتاب۔ لیکھا۔ لین دین۔فِعل لازِم
حساب کتان یا لین دین شروع ہونا۔صِفت
خوشحال۔ آسودہ حال۔ دال روٹی سے خوش۔فعل مُتعدّی
کسی کے ساتھ حساب کتاب یا لین دین جاری کرنا۔ لیکھا ڈالنا۔فعل مُتعدّی
کھاتے میں چڑھانا۔ روز نامچہ سے کاٹ کر پکّی بہی میں چڑھابا۔اِسمِ مُذکّر
بڑھئی۔ ترکھان۔ لکڑی کا کام بنانے والا۔اِسمِ مُذکّر
کھاتا کی جمع۔اِسمِ مُذکّر
بقایا۔ باقی۔فِعل لازِم
حساب میں درج ہونا۔ روز نامچہ سے پکّی بہی میں چڑھایا جانا۔فعل مُتعدّی
باوجود آسودگی قسمت کا شاکی رہنا۔ ناشکری کرنا۔اِسم مُؤنّث
کُھجلی۔ جھونجھ۔ خواہش مجامعت۔اِسمِ مُذکّر
خوراک۔ غذا۔ ایک قسم کی مٹھائی۔اِسم مُؤنّث
نشیب۔ کچھار۔ ہریانہ۔ ترائی۔اِسمِ مُذکّر
شور۔ کلر۔ شوریت۔ نمک۔ کاٹ کرنے والی چیز۔فِعل لازِم
شور لگنا۔ کلّر لگنا۔اِسمِ مُذکّر
کھاس۔ لادی۔ نمکین۔ نمک۔ پہاڑ۔ نون۔اِسمِ مُذکّر
ایک قسم کا سُرخ موٹا کپڑا جو اکثر پردوں یا مجاموں یا سقوں کی لنگیوں کے کام آتا ہے۔صِفت
نمکین۔ شور دار کس میں کھار پایا جائے۔ تلخ۔ کڑوا۔اِسمِ مُذکّر
ایک قسم کا نمک جو اکثر کھانوں میں دینے اور دوائیوں میں ڈالنے کے کام آتا ہے۔اِسمِ مُذکّر
وہ کنوان جس کا پانی کڑوا یا نمکین ہو۔ بے فیض۔اِسم مُؤنّث
وہ جالی دار گون جس میں اُپلے بھر کر گدھوں پر لادتے ہیں ۔ اُپلوں کی جالی دار بوری۔اِسم مُؤنّث
چمڑا۔ چام۔ چرم۔ انسان یا حیوان کے جسم کا پوست۔ حیوان کا بال دار چمڑا۔ پوشت۔ چھال۔ چھلکا۔فعل مُتعدّی
پوست اُتارنا۔ چمڑی جدا کرنا۔ سزاے تازیانہ دینا۔ دُرّے لگانا۔فعل مُتعدّی
کسی کے جسم سے کھال اُکھاڑنا۔ گوشت سے پوست جدا کرنا۔ چمڑی اُدھیڑ دینا۔ سزا دینا۔ کچھ کر لینا۔فعل مُتعدّی
چمڑی اُدھیڑنا۔ تازیانہ کی سزا دینا۔ بید لگانا۔فِعل لازِم
شامت آنا۔ پٹنے کو جی چاہنا۔فِعل لازِم
اپنے حال میں خوش ہونا۔ اپنی موجودہ حیثیت اور غریبی میں ہی مگن رہنا۔فعل مُتعدّی
چمڑی اُدھڑوانا۔ پوست اُتروانا۔فِعل لازِم
چمڑا اُدھیڑنا۔ پوست اُتارا جانا۔ چمڑی اُترنا۔اِسمِ مُذکّر
وہ نیچی زمین جس میں بہت سے ندی نالے ہوں۔ گڑھا۔ گار۔ ندی۔ آب جو۔اِسم مُؤنّث
کان ۔ معدن۔ جواہرات کے پیدا ہونے کی جگہ۔ وہ گڑھا جس میں سے معدنی اشیا برآمد ہوتی ہوں۔ مخزن۔ خزانہ۔ منبع۔ چشمہ۔ افراط۔ کثرت۔ بہتاب۔اِسمِ مُذکّر
خوراک۔ طعام۔ خورش۔ بھوجن۔ روٹی۔ لشکری۔ ضیافت۔ دعوت۔ 

فعل مُتعدّی
تناول کرنا۔ نوش کرنا۔ بھوجن کرنا۔ چٹ کرنا۔ حلق سے اُتارنا۔ غٹکنا۔ ڈکارنا۔ پھاڑنا۔ برداشت کرنا۔ سہارنا۔ سمانا۔ بھرنا۔ انس نکال لینا۔ ستانا۔ تنگ کرنا۔ اندر لینا۔ ہڑپ کرنا۔ بوسیدہ کرنا۔فعل مُتعدّی
بلّی کی سی عادت رکھنا۔ اپنے محسن کا احسان فراموش کرنا۔ ایک تو کھانا دوسرا دھمکانا۔اِسمِ مُذکّر
وپ طعام اور دولہا کا جوڑا جو دُلہن کے گھر سے آتا ہے۔اِسمِ مُذکّر
شادی کی ضیافت۔ بیاہ کی دعوت جو برادری کے لوگوں کو دی جاتی ہے۔مُحاورہ
جلد آؤ۔ فوراً آؤ۔ آنے میں تامل نہ کرو۔اِسمِ مُذکّر
آب و خورش۔ اکل و مشروب۔ دانہ پانی۔فعل مُتعدّی
رنج یا غصہ دلا کر کھائے پیئے کو خون آلودہ کرنا۔ کھایا پیا خاک مین ملانا۔ رنج دلانا۔فعل مُتعدّی
نوکری چاکری کرنا۔ محنت مزدوری کرنا۔ روزی حاصل کرنا۔فِعل لازِم
کھانا نہ پچنا۔ طعام کا گوارا نہ ہونا۔ بے قراری رہنافعل مُتعدّی
تنال طعام کرنا۔ خاصہ نوش فرمانا۔فِعل لازِم
کھوں کھوں کرنا۔ کھانسی کی آواز نکالنا۔ کھنگارنا۔اِسم مُؤنّث
سرفہ۔ سُعال۔ کھوکھی۔ خارش گلو۔ کُھر کُھر۔فِعل لازِم
مرض سرفہ کا زرو ہونا۔اِسمِ مُذکّر
ٹاپا۔ موغیوں کے بند کرنے کا اونچا ٹوکرا۔ قفس خروس۔ خوانچہ۔ چھابا۔ دیوار کا کج۔ دیوار کا کُب۔ وقفہ۔ دیر۔ فرق۔ تاخیر۔فِعل لازِم
تسلسل میں فرق آنا۔ وقفہ ہونا۔ ناغہ ہونا۔اِسم مُؤنّث
شکر تری۔ بُورا۔ چینی۔ شکر سفید۔اِسمِ مُذکّر
چینی کے بنے ہوئے ہاتھی گھوڑوں وغیرہ کی مورتیں جو دیوالی میں بنا کرتی ہیں۔اِسمِ مُذکّر
ایک قسم کی سیدھی دودر تلوار۔ تیغہ۔ قصائی کا بُغدا۔ مچھلی کا قتلہ۔فِعل لازِم
تلوار چلنا۔ شمشیر زنی ہونا۔ جنگ و جدل ہونا۔صِفت
نہایت سوکھی چیز جیسے پاپڑ پتّا وغیرہ۔ کھائی۔ خندق۔اِسمِ مُذکّر
ہاتھی یا سؤر کا دانت۔اِسمِ مُذکّر
کھانا بمعنی طعام کی جمع۔اِسمِ مُذکّر
روزی کا وسیلہ۔ وہ لڑکی جسے کسب کمانے کی نیّت سے پالا ہو۔کہاوت
کھانے کو موجود کام کو مفقود۔ کام کاج میں سُست کھانے میں چست۔فِعل لازِم
بد مزاجی سے پیش آنا۔ خشونت طبع دکھانا۔ کاٹ کھانے کا ارادہ کرنا۔کہاوت
کھانے میں سب سے زیادہ اور زبردست اور کمانے میں سب سے کم اور پست۔صِفت
بہت کھانے والا ۔ اکال۔ شکم  بندہ۔ رشوت خور۔ گھونس کھاؤ۔ بہت خرچ کرنے والا۔صِفت
فضول خرچ۔ مُصرِف۔ چٹورا۔ تن پرور۔اِسم مُؤنّث
یعنی باوجودیکہ بہیترا کھاتا ہے مگر پھر بھی دُبلا ہؤا جاتا ہے۔اِسم مُؤنّث
چارپائی۔ پلنگ۔ کھٹیا۔ ماچی۔ ماچا۔فِعل لازِم
دیکھو ( گھاٹ چڑنا)فعل مُتعدّی
قریب بمرگ آدمی کو چارپائی سے نیچے ڈال لینا تاکہ وہ مر کر بھوت نہ ہو جائے۔فِعل لازِم
صاحب فراش ہو جانا۔ چارپائی سے پیٹھ لگ جانا۔فِعل لازِم
جنازہ نکلنا۔ تابوت نکلنا۔ ارتھی نکلنا۔فعل مُتعدّی
بیماری میں اُٹھنا۔ بیماری میں صرف ہونا۔ بیماری پر لگنا۔فِعل لازِم
بیمار ہو کر چارپائی پر پڑنا۔ صاحب فراش ہونا۔  ہم دوش بستر ہونا۔فِعل لازِم
صاحب فراش ہونے کے سبب بول و براز کے واسطے نیچے سے چارپایہ کا کاٹ دیا جانا۔ نہایت بیمار پڑ جانا۔ مرنے کے قریب ہو جانا۔اِسمِ مُذکّر
بدھنا بوریا۔ استر بستر۔ اختر بختر۔اِسم مُؤنّث
خلیج۔ پانی کا وہ تنگ قطعہ جو خشکی میں دور تک چلا گیا ہو۔اِسم مُؤنّث
وہ موٹی موٹی سفید لکیریں جو زچہ کی چھاتیوں رانوں اور پیٹ پر جنّے کے بعد کھجا لینے سے پڑ جاتی ہیں۔اِسمِ مُذکّر
گینڈے کا سینگ جو اکثر خنجر پیش قبض سا طور اور چُھرے وغیرہ کے دستون میں لگایا جاتا ہے۔ کرگ۔فِعل لازِم
خوراک کا جزوِ بدن نہ ہونا۔ آب و نان کا خوش نہ آنا۔ جسم کا فربہ و ترو تازہ نہ ہونا۔فِعل لازِم
گُھس جانا۔ بندھ جانا۔ گڑ جانا۔ بیٹھ جانا۔صِفت
سجّا کا نقیض۔ بایاں۔ چپ۔ اُلٹا۔ بائیں ہاتھ سے کام کرنے والا۔فِعل لازِم
چُھبنا۔ گھسنا۔ بیٹھنا۔ گڑنا۔ بسنا۔ سمانا۔ نقش ہونا۔ دل نشین ہونا۔ نظروں کو اچھا لگنا۔اِسم مُؤنّث
کھبّا کی تانیث۔ وہ عورت جسے بائیں ہاتھ سے کام کرنے کی عادت ہو۔اِسمِ مُذکّر
وہ گڑھا جس میں غلّہ بھر کر اوپر سے پاٹ دیتے ہیں۔ تاکہ ایّام قحط میں گراں ہو کر بکے۔اِسم مُؤنّث
کھتری کی تانیث۔ کھتری کی جورو ۔اِسمِ مُذکّر
کھتریوں کی برادری۔اِسمِ مُذکّر
حقارتاً کھتری بچہ۔ کھتری زادہ۔ کھتری والا۔اِسمِ مُذکّر
ہندؤں کے چار برنوں میں سی ایک برن۔ ہندؤں کی ایک قوم کا نام ۔اِسم مُؤنّث
گاؤں کی زمین کا حساب کتاب مع کیفیت تقسیم۔اِسم مُؤنّث
خزانہ۔ دولت۔فعل مُتعدّی
کھاتے میں رقم کو درج کرنا۔ روزنامچہ سے نکال کر کھاتے میں چڑھانا۔اِسمِ مُذکّر
کھتا کی جمع۔صِفت
وہ غلّہ جو کھیتی سے نکلا گیا ہو۔ بُھکراندا۔اِسم مُؤنّث
دال یا چاول وغیرہ کے پکنے کی آواز۔ کسی اناج کے اُبلنے کی آواز۔اِسم مُؤنّث
کُھدنے کا حاصل بالمصدر۔ کُھدوانے کی اجرت۔ کندہ کاری۔اِسمِ مُذکّر
وہ گڑھا جہاں سے برتن یا اینٹیں بنانے کے واسطے چکنی مٹی کھودتے ہیں۔ بجری کی کھان۔فِعل لازِم
کھدبد کھدبد کرنا۔ اآبلنا۔ پکنا۔ جوش ہونا۔صِفت
کُھردرا۔ روڑھا۔ ناہموار۔ نا برابر۔ اونچا نیچا۔ گوشہ۔فِعل لازِم
کندہ ہونا۔ کھودا جانا۔ نقش کیا جانا۔ اُکھڑنا۔ مسمار ہونا۔اِسم مُؤنّث
کُھدائی۔ مال یا دولت کی تلاش کے واسطے زمین کا کھودنا۔فعل مُتعدّی
دولت یا سرقہ کا کھوج لگانے کے واسطے زمین کھودنا۔فِعل لازِم
کُھدائی ہونا۔ کھودا جانا۔اِسم مُؤنّث
کھدوانے کی اجرت۔ کندہ کرائی۔فعل مُتعدّی
کندہ کرانا۔ نقش کرانا۔ جڑ سے نکلوانا۔ یوں تون کرانا۔اِسم مُؤنّث
بھوک۔ اشتہا۔ کھانے کی چاہ۔ خواہش طعام۔ْاِسم مُؤنّث
پیچھا۔ تعاقب۔فعل مُتعدّی
تعاقب کرنا۔ پیچھا کرنا۔ بھگانا۔ باہر کرنا۔ تاڑنا۔ رگیدنا۔اِسمِ مُذکّر
گائے بکری اور ہرن وغیرہ کے ناخن۔ چرے ہوئے سُم۔اِسم مُؤنّث
گھوڑے کی نعلبندی۔اِسمِ مُذکّر
ہندوستان کی ایک خانہ بدوش قوم کا نام جس کا پیشہ یہ ہے کہ وہ بوڑھے بیلوں کو کُھر وغیرہ ست درست کر کے جوان بیلوں کی قیمت میں دھوکا دے کر بیچ جایا کرتی ہے۔ندا
ایک مشہور فقرہ ہے جو عورتیں بچوں کو کھانسی کی تکلیف یا کھانسنے کے وقت رونے سے بہلانے کے واسطے زبان پر لایا کرتی ہیں۔اِسمِ مُذکّر
کھریرا۔ 

صِفت
دیکھو (کُھردرا)اِسمِ مُذکّر
ایک قسم  کا بڑا چھان یا بنایا ہؤا اوزار جس سے کپڑا چُنتے اور اس میں چُنت ڈالتے ہیں۔ کھنگر۔ ایک مصالح کا نام ۔ درشت خو۔ سخت کلام۔ بد مزاج۔ اکھڑ مزاج۔ 

اِسمِ مُذکّر
مسودہ۔ کچّا حساب کتاب۔ کچا کھاتا۔ 

صِفت
خالص۔ بے غش۔ زرناب۔ زر خالص۔ بے ملاؤ۔ کھوٹا کا نقیض۔ زر مصر۔ اچھا۔ چوکھا۔ خوب۔ خاصا۔ صاف۔ سچا۔ بے کپٹ۔ راست باز۔ خوش معاملہ۔اِسمِ مُذکّر
صفائی۔ خوش معاملگی۔ خوبی۔ عُمدگی۔ دیانت داری۔ ایمان اداری۔ سچائی۔ صداقت۔ صاف گوئی۔فعل مُتعدّی
صاف معاملہ ہونے کا دعویٰ کرنا۔ خوش معاملگی کی ڈینگ مارنا۔فعل مُتعدّی
پرکھنا۔ چٹکی لگانا۔صِفت
اچھا بُرا۔ بُارا بھلا۔ ایسا ویسا۔فعل مُتعدّی
بُرے بھلے کی آزمایش کرنا۔ اچھے بُرے کو آزمانا۔فِعل لازِم
نیّت میں فرق آنا۔ نیّت بگڑنا۔ کسی خوبصورت عورت کو دیکھ کر بد نیتی کرنا۔اِسمِ مُذکّر
خوش معاملگی۔ معاملہ کی صفائی۔ (تابع فعل) جلد۔ تُرت۔ پھرت۔ فوراً۔اِسمِ مُذکّر
فرخ آبادی روپیہ کا معاملہ سب سے کھرا ہے کیونکہ وہ کھوٹا نہیں ہوتا۔ خوش معاملگی اچھی ہے۔ فوراً اور جلدی کے ساتھ سے کام کو بجا لانا۔اِسمِ مُذکّر
سو ارب کا یاک کھرب ہوتا ہے۔ دس ہزار کروڑ کی تعداد۔صِفت
کھارا۔ صاف گو۔ بے ریا۔ لگی لپٹی نہ رکھنے والا۔فِعل لازِم
کھرا اور صاف رہنا۔ سب سے الگ اور آزاد رہنا۔فعل مُتعدّی
صاف صاف اور کُھلی کُھلی کہنا۔ لاگ لپٹ نہ رکھنا۔ آزاد بولنا۔اِسمِ مُذکّر
ایک قسم کی گھانس جو بتھوے کے ساگ سے مشابہ ہے۔اِسم مُؤنّث
چونکہ سُر بلندی اور پستی کے اعتبار سے سات درجوں پر منقسم ہوئے پس پہلے سُر کا نام جو سب سے پست اور مخرج اس کا ناف ہے اس نام سے موسوم ہؤا اور اس کی آواز مور کی مانند ہے۔صِفت
ناہموار۔ دانے دار۔ اونچا نیچا۔ اُکھڑا۔ درشت۔ خشن۔اِسمِ مُذکّر
روڑہا پن۔ کھر کھراہٹ۔ ناہمواری۔اِسم مُؤنّث
موسم خشک۔ موسم گرما۔ وہ موسم جس میں گرمی کے باعث گھاس وغیرہ جل جاتی ہے۔ سوکھا۔ خشک سالی۔ قحط۔فِعل لازِم
برسات کا بارش کے بغیر فزرنا۔اِسم مُؤنّث
ایک قسم کی پتھر کی کونڈی یا اوکھلی جو کشتی نما ہوتی اوراور ادویات کے پیسنے حل کرنے کے کام آتی ہے۔ سنگ صلابہ۔ صلابہ سنگین۔فعل مُتعدّی
کسی دوا کو حل کرنا۔ خوب باریک پیسنا۔ سُرمہ بنانا۔اِسمِ مُذکّر
کھڑی اینٹوں کا فرش۔ اینٹوں یا سلوں کا فرش۔اِسمِ مُذکّر
زخم کا انگور بندھنے کے بعد اوپر سے خشک ہو جانا۔ وہ خشکی جو زخم اچھا ہو جانے کے بعد اُس کے اوپر جم جاتی ہے۔اِسم مُؤنّث
ایک درخت اور اس کے پھل کا نام جو نبولی یعنی نیم کے پھل سے مشابہ اور ذائقہ میں شیریں ہوتا ہے۔اِسمِ مُذکّر
گھاس کھودنے کا آلہ۔ رنبہ۔ احمق۔ مودھو۔ کاٹھ کا اُلّو۔فِعل لازِم
گھانس کھودتی اختیار کرنا۔ گھاس کھودنے جانا۔ سائیس کا پیشہ لینا۔اِسم مُؤنّث
چھوٹا کُھرپا۔ کُھرچی۔ انگیا اور پشواز کے مونڈھوں کی تراش۔اِسم مُؤنّث
پکتے میں کوئی طعام یا کوئی اور چیز سۃرخ و بریاں ہو کر ہانڈی کی پیندی میں تھپڑ سا جم جاتا ہے۔ تہ دیگ۔ ہانڈی کی پوچھن۔ بچا کھچا۔ پس ماندہ۔ سب سے اخیر بچہ۔ پیٹ کی پوچھن۔اِسم مُؤنّث
کھرچنی کا آلہ۔ کُھرپی۔ غلط بردار ریزر۔اِسمِ مُذکّر
گوسالہ۔ گوخانہ۔ باڑا۔ وہ مکان جس میں چارپاے بند کئے جاتے ہیں۔فعل مُتعدّی
کُھوں کُھوں کرنا۔ کھانسنا۔اِسمِ مُذکّر
خرگوش۔ سُستا۔ سِہا۔اِسم مُؤنّث
جوتی کے تلے کا وہ حصہ جو ایڑی کے نیچے رہتا ہے۔ جوتی کا وہ حصہ جہاں نعل لگاتے ہیں۔ 

اِسم مُؤنّث
کھرا کی تانیث۔ خالص ۔ بے غش۔ بے میل۔ صاف۔ چوکھی۔ عمدہ۔ صاف گو۔ بے کپٹ۔ 

اِسم مُؤنّث
کھردری چارپائی۔ وہ چارپائی جس پر بچھونا نہ ہو۔فعل مُتعدّی
صاف صاف کہنا۔ لگی لپٹی نہ رکھنا۔فعل مُتعدّی
اطمینان کرنا۔ خوش معاملگی کی تصدیق کرنا۔اِسم مُؤنّث
ایک قسم کی سفید مٹی جسے مکانوں پر پھیرتے ہیں۔ چاک۔ 

اِسم مُؤنّث
بڑے چئیں یا ناریل کے چھلکے یا کاٹ کا بنایا ہؤا کٹوری کی شکل کا آلہ جس سے کپڑا چُنتے ہیں۔مُحاورہ
ناموزوں اور بے میل بات۔اِسمِ مُذکّر
گھوڑے کے بال صاف کرنے اور گرد نکالنے کا آہنی آلہ۔ کھرکھرا۔ کھرہرا۔ فِرجون۔اِسمِ مُذکّر
کھرا کی جمع۔فِعل لازِم
اکل کھرا اور ناملنسار بن جانا۔ بالکل بد اخلاق اور بے مروت بن جانا۔صِفت
نقد۔ چوکھے۔ بغیر دستوری اور بٹّے کے۔فِعل لازِم
نقد کی برابر ہو جانا۔ قائم ہو جانا۔اِسم مُؤنّث
کُھسر پُھسر۔ سرگوشی۔ باہم آہستہ باتیں کرنا۔اِسم مُؤنّث
گھانس کاٹنے کی آواز۔اِسم مُؤنّث
ایک قسم کا غلّہ جس کی دال کھاتے ہیں۔اِسم مُؤنّث
کانا پُھوسی۔ سرگوشی۔ چُپکے چُپکے باتیں کرنا۔اِسم مُؤنّث
پنسا۔ حصہ۔ پنگوئی۔ ایک قسم کی چھوٹی چیچک۔فِعل لازِم
پھسلنا۔ رپٹنا۔ جگہ سے ہٹ جانا۔اِسمِ مُذکّر
کُشتی کے ایک داؤں کا نام جس میں حریف کو آگے گھسیٹ لیتے ہیں۔فعل مُتعدّی
نوچانا۔ بال اُکھاڑنا۔ بال نوچنا۔ اُتارنا۔ کھوسنا۔ اُپاڑنا۔فِعل لازِم
سرک جانا۔ ہٹ جانا۔ چلا جانا۔ ٹہل جانا۔ چُپکے سے نکل جانا۔ آنکھ بچا کے نکل جانا۔ رپٹ جانا۔ پھسل جانا۔فِعل لازِم
ٹل کر چلا جانا۔ چھپ کر چلا جانا۔ چُپکے سے چل دینا۔فعل مُتعدّی
ہٹانا۔ سرکانا۔ پرے کرنا۔ ٹالنا۔ دوسری جگہ بھیج دینا۔ الگ کرنا۔ غائب کر دینا۔ رشوت میں کچھ دینا۔فِعل لازِم
رسکنا۔ ہٹنا۔ ٹلنا۔ پھسلنا۔ اپنی جگہ سےہٹ جانا۔ چلا جانا، سٹک جانا۔ چلتا بنّا۔ چل دینا۔مُحاورہ
جاؤ۔ دفع ہو جاؤ۔ رخصت ہو جاؤ۔ ٹہلو۔صِفت
رُنکھا۔ رونا۔ رودینے والا۔ چڑچڑا۔ شرمندہ۔ خفف۔ خجل۔ حجاب زدہ۔فعل مُتعدّی
چڑانا۔ رُلانا۔ کھجانا۔ شرمندہ کرنا۔فِعل لازِم
رُنکھا ہو  جانا۔ رونے کو تیار ہو جانا۔ رو پڑنا۔ قریب بہ گریہ ہونا۔ شرمندہ ہو جانا۔ نادم ہو جانا۔اِسم مُؤنّث
وہ ہنسی جو حالت شرمندگی یا قہر و غضب میں ہو۔ زہر خند۔فعل مُتعدّی
رفع خجالت یا اخفاے غضب کے واسطے ہنسنے کا سا مُنہ بنانا۔اِسم مُؤنّث
تِل یا سرسوں کا فضلہ۔ تیل نکالی ہوئی سرسوں۔ تِل کا پُھوک۔ 

اِسم مُؤنّث
کھال کا مخفف۔ چمڑا۔ چام ، پوست۔صِفت
کھال اُدھیڑنے والا۔ لینے کے واسطے کھال تک میں سے نکالنے والا۔ وہ قرض خواہ جو ہر طرح سے لے کے پیچھا چھوڑے۔فِعل لازِم
کھولنا۔ اُبلنا۔ جوش آنا۔اِسم مُؤنّث
ہل چل۔ افراتفری۔درہمی۔ برہمی۔ ہنگامہ۔ فتور۔ شور و شغب۔ فتنہ و فساد۔ گھبراہٹ۔ اضطراب۔ بے چینی۔ بے قراری۔فِعل لازِم
ہل چل ہونا۔ افراتفری ہونا۔ غدر مچنا۔ شور و شر ہونا۔ گھبرانا۔ بوگھلاہٹ پڑنا۔ جلدی پڑنا۔فعل مُتعدّی
ہل چل ڈالنا۔ گھبرا دینا۔ شور و شر مچانا۔ ہُلڑ مچانا۔ غدر ڈالنا۔فِعل لازِم
فراغت سے بیٹھنا۔ اچھی طرح آرام سے بیٹھنا۔ چار زانو ہو کر بیٹھنا۔ کُشاددہ ہو کر بیٹھنا۔فِعل لازِم
دیکھو ( کھلنا)

فِعل لازِم
گِرہ یا کسی بندی ہوئی چیز کا وا ہو جانا۔ منکشف ہو جانا۔ وا ہو جانا۔ ظاہر ہو جانا۔ عیان ہو جانا۔ پھٹ جانا۔ شق ہو جانا۔ اُکھڑ جانا۔ ننگا ہو جانا۔ پردہ سرک جانا۔ کُشادہ ہو جانا۔ صاف ہو جانا۔ بے حجاب اور بے تکلف ہو جانا۔ مطلع صاف ہو جانا۔ بادل نہ رہنا۔فِعل لازِم
پردۂ شرم و تکلیف کو درمیان سے اُٹھا لینا۔ بے حجاب اور بے تکلف ہو جانا۔تابع فِعل
خلاصہ ہو کر ۔ پھیل کر۔ چار زانو ہو کر ۔ پھیل کر۔ بافراغت۔ بخوبی۔ حسب دل خواہ۔ دل کھول کر۔فِعل لازِم
دیکھو( کھل بیٹھنا)اِسم مُؤنّث
ٹھٹھے یا قہقہے کی آواز۔ ٹھی ٹھی۔ قاہ قاہ۔فعل مُتعدّی
خوش ہو ہو کر ہنسنا۔ قہقہے مارنا۔فِعل لازِم
ٹھی ٹھی ہنسنا۔ بے تابانہ ہنسنا۔ برابر ہنسے چلے جانا۔فِعل لازِم
بے تاب ہو کر زور سے ہنس  پڑنا۔  خوشی میں آ کر زور زور سے ہنسنا۔ قہقہا مار کر ہنسنا۔فعل مُتعدّی
چوسر یا قمار کی کوڑیوں کو خوب ہلا کر بے لاگ پھینکنا۔فِعل لازِم
ٹھی ٹھی کر کے ہنسنا۔ زور سے آواز کے ساتھ ہنسنا۔ خندہ زنی کرنا۔بہت ہنسنا۔فعل مُتعدّی
زور سے ہنسنا۔ قہقہا مارنا۔ ٹھٹھا مارنا۔ ہی ہی ٹھی ٹھی کرنا۔ نہایت بے تاب ہو کر ہنسنا۔ نہایت ہنسنا۔ 

فِعل لازِم
انتڑیوں کا گڑ گڑ بولنا۔ پیٹ بولنا۔فعل مُتعدّی
آزادانہ کسی فعل کا مرتکب ہونا۔ شرم و حجاب اُٹھا کر کوئی نیا کام کرنا۔ علانیہ کوئی معیوب امر کا کرنا۔ پھول آنا۔ پھول لگنا۔ باغ باغ ہونا۔ نہایت خوش ہونا۔ خندہ ہونا۔ دیوار کا شق ہونا۔ چوندنی کا نور افشاں ہونا۔ روشنی پھیلنا۔ کھل کھل ہونا۔صِفت
بند کا نقیض۔ کُشادہ۔ فراغ، وسیع ۔ چوڑا۔ ننگا۔ بے حجاب۔ صاف۔ بے روک ۔ بلا زحمت۔ بکس سے باہر نکلا ہؤا۔ عام ۔ مشہور۔اِسم مُؤنّث
دیکھو ( کھل بلی)فِعل لازِم
پھولا نہ سمانا۔ باغ باغ ہو جانا۔ شگفتہ ہؤا جانا۔صِفت
صاف صاف ۔ کھرا کھرا۔ دور دور۔ فاصلہ سے۔فِعل لازِم
آزادانہ پھرنا۔ بے روج ٹوک پھرنا۔فِعل لازِم
اچھی طرح سے حیض آنا۔ بخوبی اخراج ہونا۔اِسم مُؤنّث
خوراک۔ خورش۔ کھانا کھلانے کی اجرت۔ خوراک کی قیمت۔ بچوں کو کھلانے والی عورت۔ دایہ۔اِسم مُؤنّث
کھانے پینے کی قیمت۔ قیمت آب خور۔فعل مُتعدّی
تناول طعام کرانا۔ بھوجن کرانا۔ ضیافت کرنا۔ دعوت کرنا۔ بہلانا۔ بچے کا دل خوش کرنا۔ سانپ کو رکھنا۔ سانپ کی محافظت کرنا۔اِسمِ مُذکّر
اوروں کو مال کھلانے والا۔ سخی۔ دریا دل۔صِفت
مردوں کے ساتھ کھیلنے والی۔ فاحشہ۔ فن عیاشی میں ماہر۔ شوخ، چنچل۔ خوش طبع۔ چھنال عورت۔ بدکار عورت۔اِسم مُؤنّث
دیکھو( کھلاڑ)۔اِسمِ مُذکّر
چھنال پن۔ چھنالا۔ اوباشی شوخی۔صِفت
کھیل  جاننے والا۔ کرتب جاننے والا۔ ماہر فن۔ اُستاد۔ جواری۔ قمار باز۔ سانپ پکڑنے والا۔ مداری۔ بھان متی۔اِسم مُؤنّث
اُچھل کود۔ کود پھاند۔ شوخیاں۔فِعل لازِم
گِرہ یا کسی بندھی ہوئی چیز کا وا ہونا۔ عقدہ دار ہونا۔ عقدہ رحل ہونا۔ ظاہر ہونا۔ منکشف ہونا۔ عیاں ہونا۔ بھید کھلنا۔ راز افشاں ہونا۔ پھٹنا۔ شق ہونا۔ دوپارہ ہونا۔ عریاں ہونا۔ صاف ہونا۔ بے تکلف ہونا۔ چورا ہونا۔ فراخ ہونا۔ وسیع ہونا۔  موزوں ہونا۔ ضایع ہونا۔ کھویا جانا۔ لگام نہ رہنا۔ قابو نہ رہنا۔ ناگوار گزرنا۔ رونق پر آنا۔ چمکنا۔صِفت
کھیل کود اور لہو لعاب میں مشغول رہنا۔ کِھلاڑی۔صِفت
کھلاڑن۔ کھیل کود اور لہو لعب میں مشغول رہنے والی۔صِفت
ہر وقت ہنستی رہنے والی۔ ہنسوڑ۔ خوش مزاج۔ خواہ مخواہ ہنستے رہنے والی۔ خوش مسخری۔صِفت
پگلنوں کی طرح ہنسنے والی۔ بے محل و موقع ہنسنے والی۔ ہنسوڑ۔ بیہودہ۔کھولنا کا معتدی المعتدی۔بھنی ہوئی چیز جو مُنہ صاف کرنے کے واسطے کھاتے ہیں۔اِسمِ مُذکّر
وہ کھیلنے کی چیز جس سے بچے کھیلا کرتے ہیں۔ نازک اور دکھاوے کی چیز۔ (بازاری) عضو تناسل۔اِسم مُؤنّث
وہ بڑھیا عورت جس کے جسم پر گوشت کی بجائے کھال ہی کھال رہ گئی ہو۔ پہاڑ۔اِسمِ مُذکّر
کھال کی تصغیر۔ چمڑے کی گون۔اِسم مُؤنّث
کھال کی تصغیر۔ چمڑی۔ پوست حیوانات۔ عضو تناسل کے آگے کا چمڑہ جس کا ختنہ ہوتا ہے۔ گھونگٹ۔کُھلا کی تانیث،

اِسم مُؤنّث
عربی کُسب۔ فارسی کنجا۔

اِسم مُؤنّث
مزاح۔ ہنسی۔ ٹھٹھا۔ ٹھٹولی۔ مذاق۔ چُہل بازی۔فعل مُتعدّی
ہنسی اُڑانا۔ ٹھٹا کرنا۔ احمق بنانا۔ مسخرہ بنانا، رسوا کرنا۔صِفت
مسخرہ ۔ ظریف ۔ چُہل باز۔ ہنسی مذاق کرنے والا۔اِسم مُؤنّث
چھیڑ خانی۔ چھیڑ۔ ہنسی۔ مزاح۔ مذاق۔ چُہل بازی۔فعل مُتعدّی
علانیہ کہنا۔ کُھلم کُھلا کہنا۔ صاف صاف سُنانا۔ سب کے وروبرو کہنا۔ سب کو سُنا کر کہنا۔فعل مُتعدّی
ہنسی میں اُڑانا۔ احمق بنانا۔ پاگل بنانا۔فعل مُتعدّی
ہنسی اور مذاق سے تنگ کرنا۔ مسخرہ بنانا۔فعل مُتعدّی
ہنسی کرنا۔ مذاق کرنا۔ چھیڑ خانی کرنا۔ چُہل کرنا۔صِفت
خفیہ پولیس کا۔ مخبر، جاسوس۔اِسمِ مُذکّر
وہ جگہ جہاں بُھس  میں سے اناج برسا کر ڈھیر لگاتے ہیں۔ وہ اناج کا ڈھیر جو کھیتوں پر صاف کر کے لگایا جاتا ہے۔ کوٹھیار۔ گودام۔ مطلق انبار۔ ڈھیر۔فعل مُتعدّی
توڑ پھوڑ کر ڈھیر کر دینا۔ ستیاناس کر دینا۔ تہ و بالا کردینا۔فِعل لازِم
لاشوں اور کُشتوں کا ڈھیر ہو جانا۔ مقتولوں کا انبار لگ جانا۔کُھلا کی جمع۔تابع فِعل
سرِ بازار۔ بے خوف و خطر۔ کھلم کھلا۔ علانیہ۔تابع فِعل
بال کھلے ہوئے۔ ننگے سر۔ بے تکلف۔ بے دھڑک۔تابع فِعل
بے تکلف، آزادانہ۔ کُھلّم کُھلا۔ علانیہ۔تابع فِعل
بے دھڑک۔ بلا خوف و خطر۔ نڈر ہو کر۔ بے اندیشہ۔ بے روک ٹوک۔تابع فِعل
دیکھو (کھلے بند)تابع فِعل
علانیہ۔ آزادانہ۔ بے دھڑک۔ ڈنکے کی چوٹ۔فعل مُتعدّی
کھری کھری اور صاف صاف کہنا۔ لگی لپٹی نہ رکھنا۔ ڈنکے کی چوٹ کہنا۔ نڈر اور بے خوف ہو کر کہنا۔اِسمِ مُذکّر
تھم۔ ستون ۔ رکن۔ لاٹھ۔ منارہ۔اِسم مُؤنّث
ڈولی کے لچکنے یا رتھ کے چلنے کی آواز۔اِسم مُؤنّث
ایک راگنی کا نام جو کانھڑا راگنی اور راگنیوں کا رنگ مِلا کر بنائی جاتی ہے۔اِسمِ مُذکّر
