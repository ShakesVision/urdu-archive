احمد بِن محمّد بِن حنبل کا نام جو بطریق عرب اپنے دادا کی طرف منسوب ہیں۔ یہ اہلِ سُنّت و جماعت کے نزدیک چَوتھے درجہ کے فقِیہ و مجتہد مانے جاتے ہیں۔ ان کے مُقلد مُلک شام یعنی غرب میں بُہت ہیں۔ آپ  ۱۶۴ھ؁ میں پیدا ہوئے اور ۲۴۱ھ؁ میں وفات پائی۔۔اِسمِ مُذکّر
نُعمان آپ کا اِسمِ مُبارک  ابو حنِیفہ کُنیّت اور امامِ اعظم لقب ہے۔ اہلِ سُنّت و جماعت آپ کو سب سے اوّل درجے کا فقِیہ ، مُجتہد اور مُحقّق شریعت مانتے ہیں ۔ ۸۰ھ؁ میں پیدا ہوئے اور ۱۵۰ھ؁ میں انتقال فرمایا۔ آپ کے پیرو تمام ممالک اور خاصکر ہِنّدوستان میں سب سے زیادہ ہیں۔۔اِسمِ مُذکّر
وہ احاطہ یا مکان جہاں اہلِ تشیع تعزیہ رکھتے اور امام حُسینؓ کی مجلس عزا منقعد کرتے ہیں۔ مجازاً خانقاہ۔ مجلس خانہ۔اِسمِ مُذکّر
یہ نام امام فخرالدّین محمّد بن حسین الرازی ساکن رے کا مُخفف ہے۔ آپ نے روزِ علم اور قُوّت دماغی سے امام العلماء کا لقب پایا۔ اکابر عہد میں بُہت عزّت پائی۔ محمّد خوارزم شاہ کے بیٹے کے اُستاد بنے۔ ۔ نسب کا سلسلہ حضرت ابو بکر صدّیق رضی اللہ عنہ  تک پُہنچتا ہے۔ آپ کے زمانہ مین اسماعیلیہ فرقہ کا زور اور حکومت تھی۔ مگر اس پر بھی آپ بے دھڑک اس فرقہ پر لعن طعن کیا کرتے تھے۔ ۔ تفسیر کبیر جو ایک مقبولِ عام تفسیر ہے آپ ہی کی عقلِ خُداداد جوہر کا نتِیجہ ہے۔۔ آپ غزہ شوال روزِ جمعہ ۵۴۴ھ؁ میں پیدا ہو کر ۶۰۶ھ؁ میں راہیٔ مُلکِ بقا ہوئے۔ اور بقول بعض ۶۰۸ھ؁ میں رحلت فرمائی۔اِسمِ مُذکّر
اصل نام محمّد بِن ادرِیس، کُنیّت امو عبدُاللہ اور ناصرالحدیث لقب ہے۔ شافعی اپنے جداعلےٰ شافع بن سائِب کی نسبت سے مشہور ہوئے۔ آپ دوسرے درجے کے فقِیہ و مُجتہد ہیں۔ آپ ۱۵۰ھ؁ میں پیدا ہوئے اور ۲۰۴ھ؁ میں رحلت فرمائی۔اِسمِ مُذکّر
یہ حضرت سیّدنا علی رضا بن موسیٰ الکاظم علیہ السلام کا جو آٹھویں امام ہیں کا عرف ہے۔ اسی وجہ سے آپ کو امام ثامن بھی کہتے ہیں۔ آپ ۱۴۸ھ؁ میں مدینہ منورہ پیدا ہوئے۔ آپ کی کُنیّت ابوالحسن ہے اور القاب  رضا، صابر، زکّی و ولی ہے۔ آپ ۵۵ برس زنّدہ رہے اور آخر صفر ۲۰۳ھ؁ میں وفات پائی۔۔اِسمِ مُذکّر
حضرت علی رضا بن موسیٰ الکاظم ؑ کی نیاز کے نام کا روپیہ جو سفر کرنے والے کے بازو پر اُس کے عزیزو اقارب باندھ دیتے ہیں اور وہ منزلِ مقصود پر پُہنچ کر کِسی سیّد کو لِلّٰہ دیدیا جاتا ہے۔اِسمِ مُذکّر
یہ نام ابُو حامد محمّد بِن محمّد کا ہے۔ جو بمقام غزّالہ میں واقع طوس مُلک خراساں میں ۱۰۳۸ء؁ بمطابق ۴۲۴ھ؁ میں پیدا ہوئے۔ اور ۱۱۲۶ء؁ موافق ۵۲۰ھ؁ میں انتقال فرمایا۔ اس حساب سے ۹۶ برس عُمر پائی۔ آپ بُہت برے فقِیہ ، عالم، فاضل ، حکیم، مُحقق اور مُصنّف یگانہ ہوئے ہیں۔۔ بڑے بڑے حکماء  امام صاحب کی ذکاوت و ذہانت کا لوہا مانتے ہیں۔ آپ نے بُہت سے فرقوں میں رہ کر اُن کی سیر دیکھی اور ہر ایک موقع پر تصنیف فرمائی۔جس کا اظہار ایک رسالہ میں خُود فرمایا۔ مگر جب سے فرقہ صوفیہ میں قدم رکھا تزکیہ و تصفیہ باطن میں یدِ طُولیٰ حاصل کیا اور بُہت سی مُفید تصنیفات فرمائیں۔ مثلاً احیاءالعلوم۔ جواہرالقرآن۔ تفسیر یاقوت التاویل چالیس جِلد۔ مشکوٰۃ الانوار۔ کیمیاے سعادت وغیرہ ۔ جن کے پڑھنے سے نُورِ ایمان اور عرفان حاصل ہوتا ہے۔اِسمِ مُذکّر
تیسرے درجے کے فقِیہ و مجتہد ہیں۔ بقولِ بعض ۹۵ھ؁ میں پیدا ہوئے اور ۱۷۹ھ؁ میں وفات پائی۔اِسمِ مُذکّر
امام کا پَیرو فرقہ۔ اہلِ تشیع۔ شِیعہ۔اِسمِ مُؤنّث
حِفاظت۔ سرن۔ پناہ۔ بچاؤ۔ آسایش۔ آرام۔ تسکین۔۔فِعل لازِم
سمانا۔ آجانا۔ اٹ جانا۔ بھر جانا۔اِسمِ مُؤنّث
ضد خیانت۔ ودِیعت۔ دھروڑ۔ کِسی کی رکھوائی ہوئی چیز۔ ڈپوزٹ۔ سپُرد کی ہوئی چیز۔ جُوں کی تُوں۔اِسمِ مُذکّر
ایک قِسم کا کھانے کا تمباکو۔اِسمِ مُذکّر
امِین۔ مُعتمد۔ خیانت نہ کرنے والا۔ دِہدار۔اِسمِ مُؤنّث
بخلافِ اجارہ۔ بے ٹھیکے کا کام۔ وہ کام جو اپنے طور پر بنوایا جائے۔ وہ سرکاری کام جس کا ٹھیکہ نہ دیا جائے۔اِسمِ مُؤنّث
والدہ۔ مامتا۔ مادر۔ عوررتوں کا تکیہ کلام بھی ہے جو خطاب کرتے وقت مخاطب سے کہتی ہیں ۔ جیسے امّاں اپنوں کا عیب بھی ہُنر ہو جاتا ہے۔ ۔۔ اے میاں کا مُخفف ہے۔اِسمِ مُذکّر
لُغوی معنی چادر۔ اصطلاحی  آسمان۔ اکاس۔ بادل۔ راجا کی پوشاک۔اِسمِ مُؤنّث
کیری۔ کچّا آم۔اِسمِ مُؤنّث
وہ گروہ جو کِسی پیغمبر کا پَیرو ہو۔ جماعت۔ فرقہ۔اِسمِ مُذکّر
جانچ۔ پڑتال۔ آزمائش۔اِسمِ مُذکّر
پُری۔ بد ہضمی۔ اجیرن۔اِسمِ مُذکّر
تمیز۔ فرق۔ شناخت۔ پہچان۔ شعور۔ گِیان۔ ترجیح۔ تفوق۔اِسمِ مُؤنّث
مدد۔ مُعاونت۔ اعانت۔ کمک۔اِسمِ مُذکّر
حُکم ۔ اگّیا۔ اِرشاد۔ اِجازت۔ فِعل کام۔ ماجرا۔ مطلب۔ معاملہ۔ کاروبار۔ وِدھ۔ کِریا۔ وہ افعال جنمیں کِسی کام کے کرنے کی تاکِید پائی جائے۔۔

صِفت
اَن مِٹ۔ لازوال۔ ابناشی۔اِسمِ مُؤنّث
دیکھو( اکاس بیل)۔اِسمِ مُذکّر
عالمِ بقا۔ دیوتاؤں کے رہنے کا مقام۔ بہشت۔ فِردوس۔فِعل لازِم
غَیر فانی۔ ہمیشہ زِنّدہ رہنا۔ اَبدُالآباد رہنا۔اِسمِ مُذکّر
حاکم۔ رئیس۔ دَولتمند۔ رُکنِ سلطنت۔ عمائِد۔اِسمِ مُذکّر
مرض کی جمع۔ بیماریاں۔ دُکھ۔اِسمِ مُذکّر
آبِ حیات۔ تِریاق۔ مُقابل۔ زہر۔۔ شہد۔ مِیٹھا پانی۔ شربت۔ راجہ لوگون کے پینے کا پانی۔اِسمِ مُذکّر
آم کا پکایا ہؤا رس۔ اماوٹ۔۔اِسمِ مُذکّر
ایک پھل نام جسے سفری بھی کہتے ہیں۔آموں کے درختوں کا جُھنڈ۔ آم کے درخت۔ آم کا باغ۔اِسمِ مُؤنّث
نِہایت گرمی۔ حبس۔ اِحتِباس۔ گھمس۔ گُھٹاؤ۔ وہ گرمی جو زمین کے بُخارات کے باعث بھادوں کے مہینے میں ہوتی ہے۔اِسمِ مُذکّر
پر سال کے خِلاف۔ اِس برس۔ اب کے سال۔ اب کے برس۔۔اِسمِ مُذکّر
رُکاؤ۔ رُکاوٹ۔ کشش جیسے اِمساک بارش۔بُخل۔ کنجوس۔ خُشک سالی۔ قحط ۔ کال۔اِسمِ مُذکّر
شراب کے علاوہ ہر قِسم کا نشہ۔؎اِسمِ مُذکّر
ایک قِسم کا تُرش پھل جس کا اکثر چُورن بناتے ہیں۔فِعل مُتعدّی
نشہ پانی کرنا۔ نشہ پِینا۔ بھنّگ پِینا۔اِسمِ مُذکّر
لُغوی معنی یاد سے کُچھ لِکھنا۔ اصطلاحی رسمِ خط کے موافق۔ صِحت سے لِکھنا۔ یا بتائی ہوئی عِبارت کو درُست لِکھنا۔اِسمِ مُؤنّث
ملکِیّت۔ جائداد۔ مال و اسباب۔اِسمِ مُذکّر
ایک درخت اور اُس کے پھل کا نام ہے جس کا گودا مُسہل میں دست لانے کے واسطے دیا جاتا ہے۔ مغزِ خلُوس۔ مِزاجاً معتدل الحرارت ہے۔فِعل لازِم
کُند ہونا۔ تُرش ہونا۔ جیسے دانت امل گئے۔ پیٹ کے پٹھوں کا کھینچنا۔ تشنّج اعصاب ہونا۔؎اِسمِ مُؤنّث
ایک خاص قِسم کی چوڑی سِیون جو اِملی کی پتّی کے برابر چکلی ہوتی ہے۔ نشہ لانے والی پتّی  جیسے بھنّگ۔اِسمِ مُؤنّث
ایک قِسم کا تُرش پھل اور اُس کا درخت ہے۔اِسمِ مُذکّر
بچاؤ۔ حفاظت۔ پناہ۔ آرام۔ اِطمینان۔ دلجمعی۔اِسمِ مُذکّر
حِفاظت۔ پناہ۔ چَین۔ حِفظ و امان۔اِسمِ مُذکّر
زلزلہ۔ بھونّچال۔فِعل لازِم
اُبلنا۔ اُبھرنا۔ بھر آنا۔ جوش مارنا۔ پُھوٹ بہنا۔گِھر آنا۔ اِحاطہ کرنا۔ ہجون کرنا۔ جمع ہونا۔ ازدحام کرنا۔ چڑھنا۔ طغیانی پر آنا۔اِسمِ مُؤنّث
ولولہ ۔ جوش۔ لہر۔ جوانی کی ترنگ۔ جوش و خروش۔ دلی شوق۔اِسمِ مُذکّر
امر کی جمع۔ بُہت سے کام۔صِفت
وہ چیز جو نہ مِٹے۔ غیر فانی۔ لازوال۔ مُستحکم۔ پتّھر کی لکیر۔ اٹل۔اِسمِ مُذکّر
آم کا چُورا۔ کھٹائی۔ آم کی سوکھی پھانّگیں۔ سُوکھا سہما۔ لاغر۔ دُبلا۔ چُر مُر۔ کمان کی شکل۔ بُوڑھا۔ کھٹا۔ تُرش۔اِسمِ مُذکّر
یہ وہ۔ اَیرا غیرہ۔ حقارت سے فلاں کی جگہ بولتی ہے۔ ۔ ناچیز۔ نکمّی شے۔ بیقدر آدمی۔ علاوہ۔اِسمِ مُذکّر
دیکھو ( امک ڈھمک)۔اِسمِ مُذکّر
قُدرت دینا۔ مُمکن۔ مقدور۔ بس۔ قابو۔ طاقت۔ مجال۔ عارضی وجود۔ بخلافِ وجُود۔صِفت
لُغوی معنی ماں کے پیٹ سے نِسبت رکھنے والا یعنی جو حالت جنم سے پہلے تھی اُسی حالت میں رہنے والا۔ اصطلاحاً ناخوانّدہ۔ نادان۔ ان پڑھ۔اِسمِ مُؤنّث
آس بھروسا۔ آرزو۔ خواہش۔۔۔ حمل۔ پیٹ سے۔فِعل لازِم
پیٹ سے ہونا۔ حاملہ ہونا۔اِسمِ مُذکّر
مُتوقع۔ آرزُو منّد۔ مُلتجی۔ بھروسا دیا گیا۔ آئندہ کی اُمید پر کام کرنے والا۔اِسمِ مُذکّر
امر کرنے والا۔ حُکم دینے والا۔ سردار۔ بڑا آدمی۔ ذی رُتبہ۔ دولتمند۔ مال دار۔ فیّاض۔ سخی۔سردار کا بچّہ۔ رئیس زادہ۔ خاندانی۔اِسمِ مُذکّر
میر بحر۔  بحری فوج کا افسر۔دولتمندی۔ سرداری۔ استغنا۔اِسمِ مُذکّر
دیکھو (امانت دار)۔فِعل مُتعدّی
اَینٹھنا۔ مروڑنا۔ بل دینا۔اِسمِ اشارۂ بعید
اُس کی جمع۔ وُہ۔ خاونّد۔ پتی۔ پُرش۔تعظیماً واحد کے لیے بھی آتا ہے۔۔

اِسمِ اشارۂ قریب
اس کی جمع۔ تعظیماً واحد کے لیے بھی آتا ہے۔

اِسمِ مُذکّر
دانہ ۔ اناج۔ غلّہ۔ گہیوں۔ چنا۔ غذا۔ آذُوقہ۔ آدھار۔

حرفِ نافیہ
نہیں۔ جِن۔ بے۔ مت۔ بِن۔ نہ۔ جیسے اَن پڑھ۔

صِفت
دُوسرا۔ غَیر۔ اجنبی۔ پردیسی۔اِسمِ مُؤنّث
ناموافقت۔ بِگاڑ۔ ناسازگاری۔ مُخالفت۔ نااِتّفاقی۔ دُشمنی۔ عداوت۔ لڑائی۔اِسمِ مُذکّر
دانہ پانی۔ کھانا پینا۔اِسمِ مُذکّر
رازِق۔ رِزق دینے والا۔ پالنے والا۔ مالک۔ سردار۔ آقا۔ سرکار۔تابع فِعل 
آجکل۔ فی زمانہ۔ فی الحال۔صِفت
بِن دیکھا۔ نادیدہ۔ غائب۔ مخفی۔صِفت
نافہم۔ نادان۔ بچّہ۔ بیوقوف۔ بھولا بھالا۔اِسمِ مُؤنّث
وہ بے میل اور بے جوڑ عبارت یا نظم کے ٹکڑے جو ظریف لوگوں نے ہنسانے کے واسطے گھڑ رکھے ہیں۔صِفت
بے بہا۔ بیش قیمت۔ نِہایت عُمدہ۔صِفت
نامُنصف۔ بے اِنصاف۔ نِیاؤ نہ کرنے والا۔ بے درد۔ کڑ بے رحم۔ ظالم۔ بدکار۔ بے اِیمان۔ نِہایت خراب۔ دُرجن۔اِسمِ مُذکّر
ان جل۔ کھانا۔ پینا۔ کھانہ دانہ۔ دانہ پانی۔صِفت
ناخوانّدہ۔ لُر۔ اُمّی۔اِسمِ مُذکّر
اَن ادھاری۔ مُراداً انسان آدمی۔صِفت
شُمارے سے باہر۔ شُمار ناکردہ۔ آٹھواں۔اِسمِ مُذکّر
آٹھواں برس۔اِسمِ مُذکّر
آٹھ مہینے کا حمل۔صِفت
بِن گھڑا۔ بیڈول۔ ناموزوں۔ ناشائستہ۔ آدمیّت سے خارج۔ بونّگا۔ بے سلیقہ۔ جاہل۔ اناڑی۔ ناتجربہ کار۔ اٹکل پچُو۔اِسمِ مُؤنّث
بے تُکی۔ بےڈھنگی۔ بے میل اور اُول جلُول بات۔اِسمِ مُؤنّث
مُفلسی۔ تنگدستی۔ اِفلاس۔ فلاکت۔اِسمِ مُؤنّث
ناشُدنی۔ وہ بات جس کا سان گمان بھی نہ ہو۔ اِتّفاقی بات۔ ناگہانی بات۔ مُحال۔ مُشکل۔ نامُمکن۔ خلافِ قیاس۔صِفت
غَیر شخص۔ اجنبی۔ ناواقف۔اِسمِ مُؤنّث
دایہ۔ دُودھ پلانے والی عورت۔ دھاے۔اِسمِ مُذکّر
غلّہ ۔ دانہ۔ خوراکِ اِنسان۔صِفت
اُس زمانہ سے جس کی یاد نہیں۔ قدیم۔ پُرانی۔اِسمِ مُذکّر
ایک قِسم کا میوہ ہے جسے ہِنّدی میں ڈاڑم کہتے ہیں۔ اور ایک قِسم کی آتشبازی بھی ہوتی ہے۔اِسمِ مُذکّر
ایک قِسم کا چورن جو انار کے دانے ڈال کر بنایا ھاتا ہے۔ ۔۔ رُخساروں کی سُرخی کو بھی اس سے تشبیہ دیتے ہیں۔صِفت
سُرخ آنکھ کا کبوتر جسے پورب میں انارا کہتے ہیں۔ منسوب بہ انار۔ جیسے اناری سموسہ یا گونجھا۔ جو ایک قِسم کا پکوان ہے۔اِسمِ مُؤنّث
مَیں پن۔ ممتا۔ خودی۔ ہماہمی۔ اپنے تئیں کُچھ سمجھنا۔ اپنی ہستی کا دم بھرنا۔صِفت
بے انّدازہ۔ بے معنی۔ بیہودہ۔ اُوٹ پٹانگ۔ بد تمیزی۔ بے تامُل۔ بے سوچے۔صِفت
ناواقف۔ نوآموز۔ مُورکھ۔ نادان۔ بیوقوف۔ انجان۔ ناتجربہ کار۔ خام۔ کچّا۔ ادُھورا۔ بے سلیقہ۔ بے ہُنر۔اِسمِ مُذکّر
