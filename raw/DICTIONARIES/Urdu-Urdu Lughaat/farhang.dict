وہ آتشدان جس میں سُنار ؤگ رکھتے ہیں اور چاندی ، سونا تپاتے ہیں۔اِسمِ مُؤنّث
وہ برتن جس میں جاڑون کے دنوں میں آگ رکھ کر تپاتے ہیں ۔ آتشدان۔ مجمر۔اِسمِ مُذکّر
ڈھا دینا۔ ڈَھے جانا۔ پائمالی۔ مسماری۔ بربادی۔اِشارۂ بعید
اُن کو ۔ اُن کے تئیں۔ 

اِشارۂ قریب
اِن کو۔ اِن کے تئیں۔اِسمِ مُؤنّث
برچھی یا تِیر وغیرہ کی نوک۔ بھال۔ سِناں۔جوتی کی نوک۔اِسمِ مُؤنّث
شرارت۔ بُرائی۔ بدی۔ بے اِنصافی۔ ظُلم۔ بِدعت۔ غُل ۔ شور۔اِسمِ مُذکّر
اُنس رکھنے والا۔ مُحَب۔ ساتھی۔ غمخوار۔ غمگُسار۔

صِفت
ایک کم بیس۔ دس اور نو۔ ایک دہائی اور نو اکائی۔ ایک درجہ کم۔ ایک درجہ کا فرق۔صِفت
ادنےٰ فرق۔فِعل لازِم
حادثہ پیش آنا۔ اَیسی وَیسی ہونا۔اِسمِ مُذکّر
سادہ پن۔ سادگی۔ بھولا پن۔ بانک پن۔ ناتجربہ کاری۔ ناآزمودہ کاری۔صِفت
لُغوی معنی نہیں ایک۔ اصطلاحاً چند۔ کئی۔ مُختلف۔ قسم قسم کا۔ ۔ بیشمار۔ بُہت۔حرفِ نِدا
ارے۔ ابے۔ اپنے سے چھوٹے اور کم رُتبہ شخص کی نسبت اس طرح خطاب کرتے ہیں۔اِسمِ مُذکّر
پہلے دن۔ شُروع۔ اِبتدا۔ آغاز۔ شُروعات۔صِفت
ابتداے عُمر۔ بچپن۔ چھوٹی عُمر۔ لڑکپن۔ کم سنی۔ صِغر سنی۔اِسمِ مُؤنّث
شُہرت۔ افواہ۔ جھوٹی خبر۔ آمد آمد۔ بے سرو پا بات۔فِعل لازِم
جھوٹی خبر پھیلنا۔ چرچا ہونا۔صِفت
کمینہ۔ ہر قسم کے آدمیوں میں بیٹھنے والا۔  لُچّا۔ بد معاش۔ بد وضع۔ بد چلن۔ عیاش۔ آوارہ۔ بیباک۔ زنا کار۔ تماشبِین۔اِسمِ مُؤنّث
بدچلنی۔ عیاشی۔ زناکاری۔اِسمِ مُذکّر
بِن بیاہا۔ کنّوارا۔ وہ مرد جو بیاہ ہونے سے پہلے مر جائے۔ بیوقوف۔ احمق۔ نامُراد۔ بے اولاد۔

اِسمِ مُؤنّث
کسر کے خلاف۔ فائدہ۔ بچت۔ جِیت۔ کِفایت۔ توقیر۔ اِفاقہ۔ اُمیدِ صحت۔اِسمِ مُؤنّث
وہ عورت جو کنّواری یا بے اولاد رہے۔اِسمِ مُذکّر
نزول۔ دیوتا۔ معصوم صفت۔ نیک۔ مقدس۔ اُستاد۔ مُرشد۔اِسمِ مُذکّر
بُلندی۔ اُونچائی۔ چوٹی۔ بڑائی۔ عظمت۔ بہبودی۔ ترجیح۔ فوق۔اِسمِ مُؤنّث
خُوش حالی۔ فراغ دلی۔ بلند اقبال۔صِفت
ویران، غیر آباد۔ تباہ۔ خراب۔اِسمِ مُذکّر
چوپایوں کا معدہ۔ پیٹ۔ شِکم۔اِسمِ مُذکّر
لُغوی معنی مُعلّم۔ نجومی۔ جادوگر۔۔ ساحر۔ سیانا۔ بھوپا۔اِسمِ مُؤنّث
دیکھو( اُوٹ)۔فِعل مُتعدّی
ایک برتن سے دوسرے برتن میں ڈالنا۔فِعل مُتعدّی
پھیری پر پھیری لگانا۔ دھکا دینا۔ ضرب لگانا۔ صدمہ دینا۔اِسمِ مُؤنّث
جانوروں کا مِعدہ۔اِسمِ مُذکّر
ایک جنگلی جانور کا نام ہے جو پانی کے کِنارہ پر رہتا ہے اور مچھلیوں عغیرہ کا شکار کرتا ہے۔ اُس کی شکل بِلّی سے مِلتی ہے۔اِسمِ مُؤنّث
وہ جھگڑا جو کبھی فصیل نہ ہو۔صِفت
ایک سیاہ مائل بہ سُرخی۔ کبُود۔اِسمِ مُؤنّث
مُصیبت۔ تکلیف۔ دُکھ۔ آفت۔اِسمِ مُذکّر
شوروشر۔ ہنگامہ۔ غُلغُلہ۔ فساد۔ جھگڑا۔ دنگا، دُھوم۔فِعل مُتعدّی
ہنگامہ و فساد برپا کرنا۔ جھگڑا اُٹھانا۔ نہایت غُل و شور کرنا۔اِسمِ مُؤنّث
جھگڑالو۔ فسادی۔ شریر۔اِسمِ مُذکّر
کرشن جی کے ایک نہایت گہرے اور سچے بھگتی کا نام جن کا ذِکر کرشن جی جی لیلاؤں اور بھجنوں میں آتا ہے۔اِسمِ مُؤنّث
کِنارہ۔ چھور۔ شُروع۔ اِبتدا۔ آغاز۔ جانب۔ سِمت۔ حمایت۔ جانب داری۔ پاسداری۔ فریق۔ تھوک۔ حد ۔ اِنتہا۔ تھاہ۔ 

حرفِ عطف
دِیگر۔ پھر۔ اِس کر بعد۔ دُوسرا۔ مُختلف۔ صرف۔ فقط۔ وگرنہ۔ زیادہ۔ نیا۔ جدید۔ بلکہ۔ غیر۔ الفتہ۔ خِلاف۔ برعکس۔مُحاورہ
ابھی ٹھہرو۔ یہ تازہ بات ہوئی۔فِعل لازِم
حمایت لینا۔ پاسداری کرنا۔ انجام کو پُہنچنا۔ حد تک پُہنچا دینا۔اِسمِ مُذکّر
اِبتدا و اِنتہا۔ آغاز و انجام۔ کِنارہ حد۔اِسمِ مُؤنّث
کتابِ حُکمنا مجات۔ وہ کتاب کس مین حُکم لِکھے جاتے ہیں۔نِدا
کیا کہنا۔ کیا خُوب۔ یُونہی چاہیے۔ ٹھیک ۔ بیشک۔ فی الحقیقت۔تابع فِعل 
تازہ۔ انوکھا۔ عجیب،۔ خِلافِ واقع۔ برعکس۔اِسمِ مُذکّر
پنّا۔ پرت۔ برگ۔اِسمِ مُذکّر
ایک قِسم کی سیون کا نام۔اِسمِ مُذکّر
ایک سوداوی مادہ کا پھوڑا ہے جو اکثر کئی برس تک رہتا ہے۔۔۔ ایک کپڑے کا نام ہے۔مشرقی۔ پُوربی۔تابع فِعل 
آس پاس ۔ اِرد گِرد۔ اِدھر اُدھر۔اِسمِ مُذکّر
آلات۔ راچھ۔ ہتیار۔۔۔ عضوِ تناسل۔اِسمِ مُؤنّث
شبنم۔ (پنجابی) تریل۔فِعل لازِم
بے رونقی چھنا۔ مدّھم ہونا۔ اُداسی برسنا۔فِعل لازِم
پژمُردہ ہونا۔ کمّلانا۔ بیرونق ہونا۔ ٹھندا ہونا۔ بُجھنا۔ ٹھڑنا۔ جوش فرو ہونا۔۔۔ شرمِندہ ہونا۔ لجانا۔ قیمت میں کم ہونا،۔ گراں نہ ہونا۔ رونق پر ہونا۔ شاداب ہونا۔ ۔ اُداسی برسنا۔اِسمِ مُذکّر
ہوش و حواس۔ دِھیان۔ جُرأت۔ ہمت۔فِعل لازِم
ہوس و حواس بجا نہ رہنا۔ عقل کا چکرا جانا۔ گھبرا جانا۔ سٹپٹانا۔اِسمِ مُؤنّث
حواس باختہ۔ بد حواس۔ مُضطرب۔ بے قرار۔فِعل لازِم
ہوش میں آنا،۔ ہوش و حواس درُست ہونا۔ قابو میں آنا۔اِسمِ مُذکّر
وقت۔ کال۔ موقع۔ سما۔ رُت۔ موسم۔ 

اِسمِ مُؤنّث
شور یا کلّر زمین۔ 

اِسمِ مُؤنّث
کلور وہ جوان گائے جو بِیائی نہ ہو۔اِسمِ مُذکّر
باری، دائیں ۔ نوبت۔ دور۔ دُودھ دہنے کا وقت۔ کھیتوں سے ترکاری توڑنے کا وار۔صِفت
بیچ کا ۔ درمیانیْ مُعتدل۔ مَیانہ۔ ایورج۔ یکساں پڑت۔ برابر کی بانٹ۔اِسمِ مُذکّر
تعریفیں۔ خُوبیاں۔ ہُنر۔ جوہر۔ کمال۔ لیاقت۔ خواص۔ عادت۔ گُن۔ اثر۔ طنزاً۔ عیب، ۔ حالات۔ کیفیت۔ اخلاق۔اِسمِ مُذکّر
محکمہ۔ کچہری۔ دفتر۔اِسمِ مُذکّر
کال۔ سما۔ ویلا۔ حالت۔ حقیقت۔ حیثیت۔ گُزارے کی صورت۔ اِنضباط۔اِسمِ مُؤنّث
گُزران۔ گُزر اوقات۔ گُزارہ۔ رفع ضرورت۔اِسمِ مُذکّر
ایک قسم کی ترکاری ہے جو زمین میں پیدا ہوتی ہے جسے زمیں قند کہتے ہیں۔

اِسمِ مُؤنّث
عوض۔ بدلا۔ معاوضہ۔ یرغمال۔ ضمانت۔ آڑ۔ طُفیل۔ وسیلہ۔

صِفت
مُقدّم۔ پہلا۔ آد۔ اِبتدا۔ شُروع۔ سب سے عُمدہ۔ بہتر۔ چوٹی کا۔ افضل۔ آغاز۔ عُنوان۔صِفت
بے معنی۔ بیہودہ۔ لاطائل۔ بیوقوف۔ احمق۔ بَونّگا۔ اندیش۔ انگھڑ۔ بے سلیقہ۔ پُھوڑ۔تابع فِعل 
روزِ پیدائش سے۔ آد سے۔اِسمِ مُذکّر
لغو و بیہودہ۔ مُغلّظات۔ گالی۔ دُشنام۔فِعل مُتعدّی
دفن کرنا۔ قبر میں رکھنا۔ دفنانا۔ گاڑنا۔ داغ دینا۔ جلانا۔ پھونکنا۔ بہانا۔ دریا بُرد کرنا۔ ندی کِنارہ لے جانا۔ دخمہ میں رکھنا۔فِعل مُتعدّی
اپنے بیٹے یا رشتہ دار کو بطور ضمانت سپُرد کرنا۔ ضمانت میں دینا۔اِسمِ مُذکّر
پردہ۔ راز۔ بھید۔

اِسمِ مُذکّر
ژالہ۔ تگرگ۔ پتّھر۔ بجری۔ قند۔ مِصری یا کھانڈ کے لڈو۔ نہایت سرد۔ یخ۔ برف۔ ٹھنڈا۔ سفید۔ برّاق۔اِسمِ مُؤنّث
بال بچے۔ بیٹا بیٹی۔ آل و عیال لڑکے بالے۔ نسل۔ سَنتان۔اِسمِ مُؤنّث
کھپریل۔ یا چھپر کے پانی کا راستہ جس سے بارش کا پانی زمین پر گِرتا ہے۔اِسمِ مُذکّر
لُغوی معنی پوست کشِیدہ خواہ اِنسان کا ہو خواہ حیوان کا مگر گرم پانی سے جُدا کیا ہؤا۔ اصطلاحاً وہ قیمہ جو انتڑیوں میں بھر کر پکاتے ہیں۔فِعل مُتعدّی
قِیمہ قِیمہ کرنا۔ ٹُکڑے ٹُکڑے کرنا۔صِفت
اُوپری۔ نیا۔ انوکھا۔ غیر مُتعاد۔صِفت
اُوپری اُوپری۔ نیا نیا۔ اُکھڑا اُکھڑا۔صِفت
صاحبِ عزم۔ بڑے اِرادے کا شخص۔ عالی ہمت۔ عالی حوصلہ۔ ثابت قدم۔ مُستقل مزاج۔ صابر۔ مُتحمل۔اِسمِ مُذکّر
جمع ولی۔ لُغوی معنی صاحب۔ خُداوند۔ مالک۔ رفیق۔ دوست۔ اصطلاحاً  اہل اللہ۔ مُصاحبِ پیغمبر۔ مہاتما۔ مہا پُرکھ۔ بندگانِ دین۔ مُقربِ بارگاہِ اِلٓہی۔ عارف بِاللہ۔ خُدا شناس۔اِسمِ مُذکّر
وہ لوگ جنہیں قرب رُوحانی حاصل ہے۔ عارفانِ اِلٓہی۔ تزکیۂ نفس و حضور قلب سے کام لینے والے۔ اہل اللہ۔اِسمِ مُذکّر
صاحبانِ حکُومت۔ رئیس۔ امیر۔ وزیر۔ سردار۔ اولی الامر۔ ارکانِ دولت و سلطنت۔اِسمِ مُذکّر
وہ ولی اللہ جو ہِند میں نہایت مشہور و معروف اور زبان زد خاص و عام ہیں۔ جن میں  سالار مسعُود غازیؒ ، شیخ علی محمد مخدُوم عرف داتا گنج بخش غزنوی لاہوری ، میراں سید حسین خنگ سوار ، شیخ نورالدین ملک یار، شیخ نجِیب الدین متوکّل ، حضرت قطب الاقطاب خواجہ قطب الدین بختیار کاکیؒ ، شاہ تُرکمان۔ شیخ بہاؤ الدین زکریا ، سُلطان غازی ، شیخ فرید الدین گنج بخش ، حضرت مخدوم شیخ علاؤ الّدین علی احمد صابر، قاضی حمید الّدین ناگوری ، ابابکر طوسی حیدری ، شیخ شرف الّدین بو علی قلندر ، حضرت شیخ نظام الّدین اولیاء ، شیخ عبد الواحد نصیر الّدین محمود چراغ دہلی، سید محمود بحار، شاہ بدیع الّدین مدار، خواجہ احمد مجدّد الف ثانیؒ ، خواجہ باقی بِاللہ ، شاہ عبد الحق محدّث دہلوی، شیخ بایزید اللہ ہو ، نظام الّدین اورنگ آبادی۔۔فِعل لازِم
ژالہ باری ہونا۔ صدمہ پُہنچنا۔صِفت
اوّل تر۔ بہتر۔ بھلا۔ عُمدہ۔ اعلےٰ۔ نہایت مُناسب۔اِسمِ مُؤنّث
پشم۔ بھیڑ اور پہاڑی بکریوں وغیرہ کے بال۔صِفت
مُنقلب، نِگُوں۔ اُلٹا۔ سر کے بل۔ پٹ۔ چت کے خلاف۔ ٹہڑھا۔ اُلٹی سمجھ کا۔ بیوقوف۔ کوڑھ مغز۔فِعل لازِم
نشہ میں لوٹ جانا۔ بیہوش و بیخبر ہو جانا۔ اُلٹ جانا۔فِعل مُتعدّی
اُلٹنا۔ برتن میں سے پانی گِرانا۔ لُنڈھانا۔ لُڑھانا۔اِسمِ مُؤنّث
بیوقوف۔ کُوڑھ مغز۔ بد قسمت۔ بد نصیبفِعل لازِم
نہایت نادان اور ناسمجھ ہونا۔دُعاے بد
سر کے بل گِرے اور اُوپر سے شیطان کی مار پڑے۔فِعل لازِم
مُنہ کے بل گِرنا۔ اُلٹا گِرنا۔ آگے کو گِرنا۔ زک اُٹھانا۔ ذلیل ہونا۔ مات کھانا۔ پچھڑنا۔پونّڈ کا بارھواں حصہ۔ سوا دو تولہ۔اِسمِ مُذکّر
ایک دراز گردن اور لمبی ٹانگوں کا چوپایہ جسے فارسی میں شُتر عربی میں جمل و اِبل کہتے ہیں۔ طویل القامت۔ دراز قد۔ بڑے قد کا۔ بے وقوف۔اِسمِ مُذکّر
ایک قسم کا خاردار گھاس جسے اُونٹ بُہت کھاتے ہیں۔فِعل مُتعدّی
جوش دینا۔ جوش کھانا۔ غُصہ میں جلنا۔فِعل ل؎
کھولنا۔ جوش کھانا۔ غُصہ میں جلنا۔اِسمِ مُؤنّث
مادۂ شُتر۔ سانڈنی، ناقہ۔ جمل۔اِسمِ مُؤنّث
نشیب و فراز۔ نیک و بد۔ بُرائی بھلائی۔ نفع و نقصان۔ اُتار چڑھاؤ۔صِفت
بلند۔ بالا۔ اُوپر۔ قد آور۔ دراز قد۔ بڑا ۔ امیر۔ عالی۔ رُتبہ۔ خاندانی۔ کوتاہ۔ تنگ۔فِعل لازِم
